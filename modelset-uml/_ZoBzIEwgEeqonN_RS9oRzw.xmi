  <uml:Model xmi:id="_TRDeEJUeEeqqGZh46IEtXQ" name="online-shopping-cart">
    <xmi:Extension extender="http://www.eclipse.org/emf/2002/Ecore">
      <eAnnotations xmi:id="_TRDeEZUeEeqqGZh46IEtXQ" source="genmymodel">

        <eAnnotations xmi:id="_d23BhZfDEeqEM7mFKilpXw" source="genmymodel">
          <details xmi:id="_d23BhpfDEeqEM7mFKilpXw" key="uuid" value="_oozEAF2mEDCmZJZW1tvwBA"/>

<xmi:XMI xmi:version="2.1" xmlns:xmi="http://schema.omg.org/spec/XMI/2.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:uml="http://www.eclipse.org/uml2/5.0.0/UML">
  <uml:Model xmi:id="_okZ5AJT0EeqqGZh46IEtXQ" name="hospitalmanagementsystem" visibility="private">
    <xmi:Extension extender="http://www.eclipse.org/emf/2002/Ecore">
      <eAnnotations xmi:id="_okZ5AZT0EeqqGZh46IEtXQ" source="genmymodel">
        <details xmi:id="_okZ5ApT0EeqqGZh46IEtXQ" key="uuid" value="3f8bc2fa-a377-457a-917e-b05426d0cbd8"/>
        <details xmi:id="_okZ5A5T0EeqqGZh46IEtXQ" key="gmm-documentation" value="&lt;p&gt;This a UML model for the Hospital Management System. This a a first version which has to be improved. Butthe main entites are given.&lt;/p&gt;&#xA;&#xA;&lt;p&gt;The hospital has several departments like Cardiology, Orthopedics, Pediatrics &amp;nbsp;etc. department.&amp;nbsp;&lt;/p&gt;&#xA;&#xA;&lt;p&gt;At reception the patient details are entered and the fees are also taken and the patient is tracked on the basis of his Id. &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/p&gt;&#xA;&#xA;&lt;p&gt;A patient can visit the doctors either directly selecting a doctor or by getting admitted to the hospital and then a doctor visits the patients.&lt;/p&gt;&#xA;"/>
      </eAnnotations>
    </xmi:Extension>

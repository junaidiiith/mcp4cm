<xmi:XMI xmi:version="2.1" xmlns:xmi="http://schema.omg.org/spec/XMI/2.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:uml="http://www.eclipse.org/uml2/5.0.0/UML">
  <uml:Model xmi:id="_29NXcJN8EeqqGZh46IEtXQ" name="hospitalmanagementsystem" visibility="private">
    <xmi:Extension extender="http://www.eclipse.org/emf/2002/Ecore">
      <eAnnotations xmi:id="_29NXcZN8EeqqGZh46IEtXQ" source="genmymodel">
        <details xmi:id="_29NXcpN8EeqqGZh46IEtXQ" key="uuid" value="97a10b0d-a472-4f10-8308-1169350bd9b3"/>
        <details xmi:id="_29NXc5N8EeqqGZh46IEtXQ" key="gmm-documentation" value="&lt;div&gt;This a UML model for the Hospital Management System. This a a first version which has to be improved. Butthe main entites are given.&lt;/div&gt;&lt;div&gt;The hospital has several departments like Cardiology, Orthopedics, Pediatrics &amp;nbsp;etc. department.&amp;nbsp;&lt;/div&gt;&lt;div&gt;At reception the patient details are entered and the fees are also taken and the patient is tracked on the basis of his Id. &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/div&gt;&lt;div&gt;A patient can visit the doctors either directly selecting a doctor or by getting admitted to the hospital and then a doctor visits the patients.&lt;/div&gt;"/>
      </eAnnotations>
    </xmi:Extension>

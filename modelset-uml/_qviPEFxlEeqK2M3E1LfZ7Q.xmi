    <packagedElement xsi:type="uml:Association" xmi:id="_702Ox5fFEeqEM7mFKilpXw" name="Sage 100_Kunden  haben individuelle Preise" memberEnd="_702Oy5fFEeqEM7mFKilpXw _702O1JfFEeqEM7mFKilpXw" navigableOwnedEnd="_702Oy5fFEeqEM7mFKilpXw _702O1JfFEeqEM7mFKilpXw">
      <xmi:Extension extender="http://www.eclipse.org/emf/2002/Ecore">
        <eAnnotations xmi:id="_702OyJfFEeqEM7mFKilpXw" source="genmymodel">
          <details xmi:id="_702OyZfFEeqEM7mFKilpXw" key="uuid" value="_VCkAlT96EDiGhqlwM4OUbQ"/>
          <details xmi:id="_702OypfFEeqEM7mFKilpXw" key="gmm-documentation" value="&lt;p&gt;Jeder Kunde hat eigene Preise. Es gibt f&amp;uuml;r jedes Nicht-Modul einen Listenpreis. Alle Module haben einen kundenspezifischen Preis. Dieser Preis wird je nach Kunde und Bestellverhalten vergeben.&amp;nbsp;&lt;strong&gt;Frage: gibt es einen Listenpreis f&amp;uuml;r Module?&lt;/strong&gt;&lt;/p&gt;&#xA;&#xA;&lt;p&gt;Bei den Nicht-Modulen bekommt der Kunde einen individuellen Rabatt. Der Preis errechnet sich aus dem Rabatt vom Listenpreis.&lt;/p&gt;&#xA;"/>
        </eAnnotations>
      </xmi:Extension>

        </eAnnotations>
      </xmi:Extension>
    </ownedComment>
    <ownedComment xmi:id="_x2xoPpRLEeqqGZh46IEtXQ" body="13. Registrar asistencia al festejo&#xA;Registrar la cantidad de niños que asistieron al festejo, calculando el monto extra en caso de haber superado la cantidad fijada">

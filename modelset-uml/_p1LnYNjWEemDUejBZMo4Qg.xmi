    </ownedComment>
    <ownedComment xmi:id="_x2xoGpRLEeqqGZh46IEtXQ" body="2. Registrar Niño&#xA;Registrar los datos personales del niño al que se le quiere realizar el festejo,">
      <xmi:Extension extender="http://www.eclipse.org/emf/2002/Ecore">

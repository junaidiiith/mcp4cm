      </xmi:Extension>
    </ownedComment>
    <ownedComment xmi:id="_x2xoO5RLEeqqGZh46IEtXQ" body="14. Generar ordenes de trabajo&#xA;Generar un listado de insumos, juegos y accesorios que la coordinadora se encargara de separar para horas mas tarde realizar el festejo">
      <xmi:Extension extender="http://www.eclipse.org/emf/2002/Ecore">

    <ownedComment xmi:id="_x2xoJpRLEeqqGZh46IEtXQ" body="4. Registrar baja festejo&#xA;Registrar la cancelacion del festejo por desicion del cliente, y que deacuerdo a la fecha que lo solicite se le reintegrara un porcentaje de la seña que entrego">
      <xmi:Extension extender="http://www.eclipse.org/emf/2002/Ecore">
        <eAnnotations xmi:id="_x2xoJ5RLEeqqGZh46IEtXQ" source="genmymodel">

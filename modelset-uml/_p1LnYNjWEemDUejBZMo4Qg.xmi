      </xmi:Extension>
    </ownedComment>
    <ownedComment xmi:id="_x2xoLJRLEeqqGZh46IEtXQ" body="5. Consultar Reservas Pendientes&#xA;Consultar el registro de reservas mostrando aquellas que no estan confirmadas (pendientes de pago)">
      <xmi:Extension extender="http://www.eclipse.org/emf/2002/Ecore">
        <eAnnotations xmi:id="_x2xoLZRLEeqqGZh46IEtXQ" source="genmymodel">

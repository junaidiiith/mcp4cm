      </xmi:Extension>
    </ownedComment>
    <ownedComment xmi:id="_x2xoKZRLEeqqGZh46IEtXQ" body="6. Generar Contrato de Fiesta&#xA;Registrar la confirmacion de la reserva, previamente habiendo validado que el cliente haya pagado la seña del festejo">
      <xmi:Extension extender="http://www.eclipse.org/emf/2002/Ecore">
        <eAnnotations xmi:id="_x2xoKpRLEeqqGZh46IEtXQ" source="genmymodel">

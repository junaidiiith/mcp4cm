      </xmi:Extension>
    </ownedComment>
    <ownedComment xmi:id="_x2xoL5RLEeqqGZh46IEtXQ" body="7. Registrar aunlacion de reserva&#xA;Registrar como aunladas aquellas reservas que estan pendientes (falta pago de seña) y que se les vencio el plazo de reserva (aplica en caso de reservas telefonicas)">
      <xmi:Extension extender="http://www.eclipse.org/emf/2002/Ecore">
        <eAnnotations xmi:id="_x2xoMJRLEeqqGZh46IEtXQ" source="genmymodel">

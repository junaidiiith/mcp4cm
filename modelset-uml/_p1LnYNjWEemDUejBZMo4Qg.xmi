    <ownedComment xmi:id="_x2xoIJRLEeqqGZh46IEtXQ" body="3. Registrar Modificacion del Cliente&#xA;Registrar la modificacion de los datos de contacto o direccion del responsable del niño">
      <xmi:Extension extender="http://www.eclipse.org/emf/2002/Ecore">

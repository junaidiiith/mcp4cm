        </eAnnotations>
      </xmi:Extension>
    </ownedComment>
    <ownedComment xmi:id="_x2xoNZRLEeqqGZh46IEtXQ" body="11. Generar listado de fiestas&#xA;Listar del registro de fiestas aquellas que tienen fecha de realizacion el dia siguiente.">
      <xmi:Extension extender="http://www.eclipse.org/emf/2002/Ecore">
        <eAnnotations xmi:id="_x2xoNpRLEeqqGZh46IEtXQ" source="genmymodel">

        </eAnnotations>
      </xmi:Extension>
    </ownedComment>
    <ownedComment xmi:id="_x2xoMpRLEeqqGZh46IEtXQ" body="8. Registrar reserva de fiesta&#xA;Registrar la solicitud del cliente de la realizacion de un festejo, indicando las caracteristicas del mismo ">
      <xmi:Extension extender="http://www.eclipse.org/emf/2002/Ecore">
        <eAnnotations xmi:id="_x2xoM5RLEeqqGZh46IEtXQ" source="genmymodel">

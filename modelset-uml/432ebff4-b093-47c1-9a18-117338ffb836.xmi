  <uml:Model xmi:id="_UdTtcJoOEeqEM7mFKilpXw" name="com.genmymodel.shoppingcart">
    <xmi:Extension extender="http://www.eclipse.org/emf/2002/Ecore">
      <eAnnotations xmi:id="_UdTtcZoOEeqEM7mFKilpXw" source="genmymodel">
        <details xmi:id="_UdTtcpoOEeqEM7mFKilpXw" key="uuid" value="432ebff4-b093-47c1-9a18-117338ffb836"/>
        <details xmi:id="_UdTtc5oOEeqEM7mFKilpXw" key="gmm-documentation" value="&lt;span style=&quot;font-size: 14.44444465637207px; line-height: 20px;&quot;&gt;Online customer can browse or search items, view specific item, add it to shopping cart, view and update shopping cart, checkout. User can view shopping cart at any time.&lt;/span&gt;"/>
      </eAnnotations>
    </xmi:Extension>
    <ownedComment xmi:id="_UdTtdJoOEeqEM7mFKilpXw" body="This class diagram represents the entities and relations of an online shopping cart system. It's one of the possible designs for such a system.  Fork it to generate Java, SQL and more to get a usable implementation.  See also the activity diagram available in the tree structure.">

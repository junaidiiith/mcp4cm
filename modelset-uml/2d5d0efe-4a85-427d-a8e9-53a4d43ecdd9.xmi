            <details xmi:id="_GLC335N2EeqqGZh46IEtXQ" key="gmm-documentation" value="&lt;p&gt;Employees will have one UI available.&amp;nbsp;&lt;/p&gt;&#xA;&#xA;&lt;p&gt;&lt;br /&gt;&#xA;Employees will be assigned a Username and Password. The password must be changed upon their 1st login.&amp;nbsp;&lt;/p&gt;&#xA;&#xA;&lt;p&gt;Employees can utilize the Log In / Out features for both the start and end of shift as well as lunch breaks.&lt;/p&gt;&#xA;&#xA;&lt;p&gt;Employees can leave a message for Admin but not laterally.&lt;/p&gt;&#xA;"/>
          </eAnnotations>
        </xmi:Extension>
        <lowerValue xsi:type="uml:LiteralInteger" xmi:id="_GLC34JN2EeqqGZh46IEtXQ"/>
        <upperValue xsi:type="uml:LiteralUnlimitedNatural" xmi:id="_GLC34ZN2EeqqGZh46IEtXQ" value="1"/>
      </ownedEnd>

<xmi:XMI xmi:version="2.1" xmlns:xmi="http://schema.omg.org/spec/XMI/2.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:uml="http://www.eclipse.org/uml2/5.0.0/UML">
  <uml:Model xmi:id="_dwgMYJUGEeqqGZh46IEtXQ" name="OnlineShoppingSystem">
    <xmi:Extension extender="http://www.eclipse.org/emf/2002/Ecore">
      <eAnnotations xmi:id="_dwgMYZUGEeqqGZh46IEtXQ" source="genmymodel">
        <details xmi:id="_dwgMYpUGEeqqGZh46IEtXQ" key="uuid" value="b1d7c539-fc4f-48e8-a0de-f8a61575260e"/>
        <details xmi:id="_dwgMY5UGEeqqGZh46IEtXQ" key="gmm-documentation" value=""/>
      </eAnnotations>
    </xmi:Extension>
    <ownedComment xmi:id="_dwgMZJUGEeqqGZh46IEtXQ" body="&lt;b&gt;This class diagrams shows the domain model of an Online Shopping System&lt;/b&gt;. It has specific choices matching my specifications: the web visitor is not distinguished from the Customer (only 1 entity), IDs are represented, items and products are two separated entities. This UML-compliant diagram tends to be an overview of the wide range of designs you could make for the shopping system. &lt;b&gt;Take a further look at the code generated from it &lt;/b&gt;(you can generate Java from GenMyModel), it should help to bootstrap your system or to understand the technical/code impacts of the relations and attributes.">
      <xmi:Extension extender="http://www.eclipse.org/emf/2002/Ecore">
        <eAnnotations xmi:id="_dwgMZZUGEeqqGZh46IEtXQ" source="genmymodel">
          <details xmi:id="_dwgMZpUGEeqqGZh46IEtXQ" key="uuid" value="_Z6EuEF5cEDCXM77MyYasLQ"/>
        </eAnnotations>
      </xmi:Extension>
    </ownedComment>
    <ownedComment xmi:id="_dwgMZ5UGEeqqGZh46IEtXQ" body="&lt;br/&gt;&#xA;A typical use is following: on the Shopping Cart Page, the Customer modifies the quantity of an Item in the Shopping Cart and then the system stores the new quantity, and then computes and displays the new cost (total price) for that item.&#xA;&#xA;&#xA;">
      <xmi:Extension extender="http://www.eclipse.org/emf/2002/Ecore">
        <eAnnotations xmi:id="_dwgMaJUGEeqqGZh46IEtXQ" source="genmymodel">
          <details xmi:id="_dwgMaZUGEeqqGZh46IEtXQ" key="uuid" value="_-TxOgF5dEDCXM77MyYasLQ"/>
        </eAnnotations>
      </xmi:Extension>
    </ownedComment>
    <ownedComment xmi:id="_dwgMapUGEeqqGZh46IEtXQ" body="&lt;br/&gt;&#xA;Notice that domain classes like Catalog, Page..are not given here. It's up to the architect who should answer the question: are they part of the core system ?">
      <xmi:Extension extender="http://www.eclipse.org/emf/2002/Ecore">
        <eAnnotations xmi:id="_dwgMa5UGEeqqGZh46IEtXQ" source="genmymodel">
          <details xmi:id="_dwgMbJUGEeqqGZh46IEtXQ" key="uuid" value="_Xq7EAF5eEDCXM77MyYasLQ"/>
        </eAnnotations>
      </xmi:Extension>
    </ownedComment>

    <packagedElement xsi:type="uml:UseCase" xmi:id="_SYpERJXHEeqqGZh46IEtXQ" name="Make Booking">
      <xmi:Extension extender="http://www.eclipse.org/emf/2002/Ecore">
        <eAnnotations xmi:id="_SYpERZXHEeqqGZh46IEtXQ" source="genmymodel">
          <details xmi:id="_SYpERpXHEeqqGZh46IEtXQ" key="uuid" value="_iJKv0WN6EDadV45R_-upHg"/>
          <details xmi:id="_SYpER5XHEeqqGZh46IEtXQ" key="gmm-documentation" value="&lt;p&gt;A room in a hotel is booked by a guest.&lt;/p&gt;&#xA;&#xA;&lt;ol&gt;&#xA;&#9;&lt;li&gt;Guest or Receptionist starts the booking process.&lt;/li&gt;&#xA;&#9;&lt;li&gt;The user selects the hotel, dates of the booking and room types required.&lt;/li&gt;&#xA;&#9;&lt;li&gt;The system shows availability for the dates and room type(s) along with the price.&#xA;&#9;&lt;ol&gt;&#xA;&#9;&#9;&lt;li&gt;&lt;em&gt;No availability in this hotel&lt;/em&gt;: The system suggests other hotels in the same business with availability.&lt;/li&gt;&#xA;&#9;&#9;&lt;li&gt;&lt;em&gt;No availability in any hotel&lt;/em&gt;: The system informs the user and terminates the use case.&lt;/li&gt;&#xA;&#9;&lt;/ol&gt;&#xA;&#9;&lt;/li&gt;&#xA;&#9;&lt;li&gt;The user accepts the booking, assuming the price and availability&amp;nbsp;is acceptable.&#xA;&#9;&lt;ol&gt;&#xA;&#9;&#9;&lt;li&gt;&lt;em&gt;Guest doesn&amp;#39;t like price or what is being offered&lt;/em&gt;: Use case terminates.&lt;/li&gt;&#xA;&#9;&lt;/ol&gt;&#xA;&#9;&lt;/li&gt;&#xA;&#9;&lt;li&gt;The system requests the relevant number of guest name and addresses.&lt;/li&gt;&#xA;&#9;&lt;li&gt;The user completes the booking by entering&amp;nbsp;the name and address information of all the guests.&#xA;&#9;&lt;ol&gt;&#xA;&#9;&#9;&lt;li&gt;&lt;em&gt;Guest is&amp;nbsp;already known to the business&lt;/em&gt;: Continue to next step.&lt;/li&gt;&#xA;&#9;&lt;/ol&gt;&#xA;&#9;&lt;/li&gt;&#xA;&#9;&lt;li&gt;The system creates the booking and gives it a booking number.&lt;/li&gt;&#xA;&#9;&lt;li&gt;The system allocates the rooms as booked.&lt;/li&gt;&#xA;&#9;&lt;li&gt;The user is given the booking number for reference.&lt;/li&gt;&#xA;&lt;/ol&gt;&#xA;&#xA;&lt;p&gt;&amp;nbsp;&lt;/p&gt;&#xA;"/>
        </eAnnotations>
      </xmi:Extension>
    </packagedElement>
    <packagedElement xsi:type="uml:UseCase" xmi:id="_SYpESJXHEeqqGZh46IEtXQ" name="Cancel Booking">
      <xmi:Extension extender="http://www.eclipse.org/emf/2002/Ecore">
        <eAnnotations xmi:id="_SYpESZXHEeqqGZh46IEtXQ" source="genmymodel">
          <details xmi:id="_SYpESpXHEeqqGZh46IEtXQ" key="uuid" value="_i3MTcWN6EDadV45R_-upHg"/>
          <details xmi:id="_SYpES5XHEeqqGZh46IEtXQ" key="gmm-documentation" value="&lt;p&gt;A booking is cancelled.&lt;/p&gt;&#xA;&#xA;&lt;ol&gt;&#xA;&#9;&lt;li&gt;A Guest or Receptionist requests to cancel a booking.&lt;/li&gt;&#xA;&#9;&lt;li&gt;The user enters the booking reference number or the dates and guest name to find the booking.&lt;/li&gt;&#xA;&#9;&lt;li&gt;The system retrieves the booking.&lt;/li&gt;&#xA;&#9;&lt;li&gt;The user confirms they want to cancel the booking.&lt;/li&gt;&#xA;&#9;&lt;li&gt;The system cancels the booking by de-allocating the rooms.&lt;/li&gt;&#xA;&#9;&lt;li&gt;The booking is cancelled and the user is informed.&lt;/li&gt;&#xA;&lt;/ol&gt;&#xA;"/>
        </eAnnotations>
      </xmi:Extension>
    </packagedElement>

    <packagedElement xsi:type="uml:UseCase" xmi:id="_SYpEoJXHEeqqGZh46IEtXQ" name="Guest Check-in">
      <xmi:Extension extender="http://www.eclipse.org/emf/2002/Ecore">
        <eAnnotations xmi:id="_SYpEoZXHEeqqGZh46IEtXQ" source="genmymodel">
          <details xmi:id="_SYpEopXHEeqqGZh46IEtXQ" key="uuid" value="_nN6cEWN6EDadV45R_-upHg"/>
          <details xmi:id="_SYpEo5XHEeqqGZh46IEtXQ" key="gmm-documentation" value="&lt;p&gt;A guest arrives at the hotel at the specific time in a booking.&lt;/p&gt;&#xA;&#xA;&lt;ol&gt;&#xA;&#9;&lt;li&gt;The guest provides to the Receptionist a booking reference number of their name.&lt;/li&gt;&#xA;&#9;&lt;li&gt;The Receptionist enter the details to find the booking.&lt;/li&gt;&#xA;&#9;&lt;li&gt;The system retrieves the booking.&lt;/li&gt;&#xA;&#9;&lt;li&gt;The user confirms the check-in with the Guest to make sure the room types and duration are correct.&#xA;&#9;&lt;ol&gt;&#xA;&#9;&#9;&lt;li&gt;&lt;em&gt;Booking details incorrect&lt;/em&gt;: The Receptionist would have to potentially cancel and re-book depending on the problem.&lt;/li&gt;&#xA;&#9;&lt;/ol&gt;&#xA;&#9;&lt;/li&gt;&#xA;&#9;&lt;li&gt;The system records the fact the Guest(s) have checked-in.&lt;/li&gt;&#xA;&#9;&lt;li&gt;The Receptionist gives the room keys (or other relevant material) to the guest.&lt;/li&gt;&#xA;&lt;/ol&gt;&#xA;"/>
        </eAnnotations>
      </xmi:Extension>
    </packagedElement>
    <packagedElement xsi:type="uml:UseCase" xmi:id="_SYpEpJXHEeqqGZh46IEtXQ" name="Guest Check-out">
      <xmi:Extension extender="http://www.eclipse.org/emf/2002/Ecore">
        <eAnnotations xmi:id="_SYpEpZXHEeqqGZh46IEtXQ" source="genmymodel">
          <details xmi:id="_SYpEppXHEeqqGZh46IEtXQ" key="uuid" value="_n8D7gWN6EDadV45R_-upHg"/>
          <details xmi:id="_SYpEp5XHEeqqGZh46IEtXQ" key="gmm-documentation" value="&lt;p&gt;A guest is ready to leave the hotel and checks-out.&lt;/p&gt;&#xA;&#xA;&lt;ol&gt;&#xA;&#9;&lt;li&gt;The guest request to check-out.&lt;/li&gt;&#xA;&#9;&lt;li&gt;The Receptionist enters the room name(/number).&lt;/li&gt;&#xA;&#9;&lt;li&gt;The system retrieves the details.&lt;/li&gt;&#xA;&#9;&lt;li&gt;The Receptionist deals with any billing issues -- outside the scope of the system at this point.&lt;/li&gt;&#xA;&#9;&lt;li&gt;The guest pays the bill -- again outside the scope.&lt;/li&gt;&#xA;&#9;&lt;li&gt;The user confirms the check-out.&lt;/li&gt;&#xA;&#9;&lt;li&gt;The system records the check-out against the Room(s) and the Booking.&lt;/li&gt;&#xA;&lt;/ol&gt;&#xA;"/>
        </eAnnotations>
      </xmi:Extension>
    </packagedElement>

    <xmi:Extension extender="http://www.eclipse.org/emf/2002/Ecore">
      <eAnnotations xmi:id="_FHXRgZk6EeqEM7mFKilpXw" source="genmymodel">
        <details xmi:id="_FHXRgpk6EeqEM7mFKilpXw" key="uuid" value="57458e56-ae69-4893-ad21-3420b34f6e12"/>
        <details xmi:id="_FHXRg5k6EeqEM7mFKilpXw" key="gmm-documentation" value="&lt;span style=&quot;font-size: 14.44444465637207px; line-height: 20px;&quot;&gt;Online customer can browse or search items, view specific item, add it to shopping cart, view and update shopping cart, checkout. User can view shopping cart at any time.&lt;/span&gt;"/>
      </eAnnotations>
    </xmi:Extension>
    <ownedComment xmi:id="_FHXRhJk6EeqEM7mFKilpXw" body="This class diagram represents the entities and relations of an online shopping cart system. It's one of the possible designs for such a system.  Fork it to generate Java, SQL and more to get a usable implementation.  See also the activity diagram available in the tree structure.">

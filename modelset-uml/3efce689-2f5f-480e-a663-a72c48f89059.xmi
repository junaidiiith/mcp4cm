      <eAnnotations xmi:id="_vRuqMZf1EeqEM7mFKilpXw" source="genmymodel">
        <details xmi:id="_vRuqMpf1EeqEM7mFKilpXw" key="uuid" value="3efce689-2f5f-480e-a663-a72c48f89059"/>
        <details xmi:id="_vRuqM5f1EeqEM7mFKilpXw" key="gmm-documentation" value="&lt;span style=&quot;font-size: 14.44444465637207px; line-height: 20px;&quot;&gt;Online customer can browse or search items, view specific item, add it to shopping cart, view and update shopping cart, checkout. User can view shopping cart at any time.&lt;/span&gt;"/>
      </eAnnotations>
    </xmi:Extension>
    <ownedComment xmi:id="_vRuqNJf1EeqEM7mFKilpXw" body="This class diagram represents the entities and relations of an online shopping cart system. It's one of the possible designs for such a system.  Fork it to generate Java, SQL and more to get a usable implementation.  See also the activity diagram available in the tree structure.">

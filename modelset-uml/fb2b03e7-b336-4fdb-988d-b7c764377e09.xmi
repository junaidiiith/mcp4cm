  <uml:Model xmi:id="_0yRCcJRDEeqqGZh46IEtXQ" name="hospitalmanagementsystem" visibility="private">
    <xmi:Extension extender="http://www.eclipse.org/emf/2002/Ecore">
      <eAnnotations xmi:id="_0yRCcZRDEeqqGZh46IEtXQ" source="genmymodel">
        <details xmi:id="_0yRCcpRDEeqqGZh46IEtXQ" key="uuid" value="fb2b03e7-b336-4fdb-988d-b7c764377e09"/>
        <details xmi:id="_0yRCc5RDEeqqGZh46IEtXQ" key="gmm-documentation" value="&lt;div&gt;This a UML model for the Hospital Management System. This a a first version which has to be improved. Butthe main entites are given.&lt;/div&gt;&lt;div&gt;The hospital has several departments like Cardiology, Orthopedics, Pediatrics &amp;nbsp;etc. department.&amp;nbsp;&lt;/div&gt;&lt;div&gt;At reception the patient details are entered and the fees are also taken and the patient is tracked on the basis of his Id. &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/div&gt;&lt;div&gt;A patient can visit the doctors either directly selecting a doctor or by getting admitted to the hospital and then a doctor visits the patients.&lt;/div&gt;"/>
      </eAnnotations>
    </xmi:Extension>

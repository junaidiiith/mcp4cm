  <uml:Model xmi:id="_uM7hgJXVEeqqGZh46IEtXQ" name="online-shopping-cart">
    <xmi:Extension extender="http://www.eclipse.org/emf/2002/Ecore">
      <eAnnotations xmi:id="_uM7hgZXVEeqqGZh46IEtXQ" source="genmymodel">
        <details xmi:id="_uM7hgpXVEeqqGZh46IEtXQ" key="uuid" value="_rBu44H7AEeqjCeBtMxTJVQ"/>
        <details xmi:id="_uM7hg5XVEeqqGZh46IEtXQ" key="gmm-documentation" value="&lt;p&gt;Online customer can browse or search items, view specific item, add it to shopping cart, view and update shopping cart, checkout. User can view shopping cart at any time.&lt;/p&gt;&#xA;"/>
      </eAnnotations>
    </xmi:Extension>
    <ownedComment xmi:id="_uM7hhJXVEeqqGZh46IEtXQ" body="This class diagram represents the entities and relations of an online shopping cart system. It's one of the possible designs for such a system.  Fork it to generate Java, SQL and more to get a usable implementation.  See also the activity diagram available in the tree structure.">
      <xmi:Extension extender="http://www.eclipse.org/emf/2002/Ecore">
        <eAnnotations xmi:id="_uM7hhZXVEeqqGZh46IEtXQ" source="genmymodel">
          <details xmi:id="_uM7hhpXVEeqqGZh46IEtXQ" key="uuid" value="_oozEAF2mEDCmZJZW1tvwBA"/>
        </eAnnotations>

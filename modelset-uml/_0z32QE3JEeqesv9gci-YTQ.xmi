        <eAnnotations xmi:id="_eiYqxZfDEeqEM7mFKilpXw" source="genmymodel">
          <details xmi:id="_eiYqxpfDEeqEM7mFKilpXw" key="uuid" value="_oozEAF2mEDCmZJZW1tvwBA"/>

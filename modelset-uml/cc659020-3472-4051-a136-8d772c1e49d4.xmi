        <eAnnotations xmi:id="_8BBuhZfNEeqEM7mFKilpXw" source="genmymodel">
          <details xmi:id="_8BBuhpfNEeqEM7mFKilpXw" key="uuid" value="_oozEAF2mEDCmZJZW1tvwBA"/>

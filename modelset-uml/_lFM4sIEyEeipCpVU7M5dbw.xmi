    <packagedElement xsi:type="uml:UseCase" xmi:id="_zgE9_JUZEeqqGZh46IEtXQ" name="Guest Check-in">
      <xmi:Extension extender="http://www.eclipse.org/emf/2002/Ecore">
        <eAnnotations xmi:id="_zgE9_ZUZEeqqGZh46IEtXQ" source="genmymodel">
          <details xmi:id="_zgE9_pUZEeqqGZh46IEtXQ" key="uuid" value="_nN6cEWN6EDadV45R_-upHg"/>
          <details xmi:id="_zgE9_5UZEeqqGZh46IEtXQ" key="gmm-documentation" value="&lt;p&gt;A guest arrives at the hotel at the specific time in a booking.&lt;/p&gt;&#xA;&#xA;&lt;ol&gt;&#xA;&#9;&lt;li&gt;The guest provides the Receptionist with a booking reference number or their name.&lt;/li&gt;&#xA;&#9;&lt;li&gt;The Receptionist enters/searches the details to find the booking.&lt;/li&gt;&#xA;&#9;&lt;li&gt;The system retrieves the booking.&lt;/li&gt;&#xA;&#9;&lt;li&gt;The user confirms the check-in with the Guest to make sure the room types and duration are correct.&#xA;&#9;&lt;ol&gt;&#xA;&#9;&#9;&lt;li&gt;&lt;em&gt;Booking details incorrect&lt;/em&gt;: The Receptionist would have to potentially cancel and re-book depending on the problem.&lt;/li&gt;&#xA;&#9;&lt;/ol&gt;&#xA;&#9;&lt;/li&gt;&#xA;&#9;&lt;li&gt;The system records the date/time the Guest(s) checked-in to the relevant room and changes the Booking to &amp;#39;ARRIVED&amp;#39;.&lt;/li&gt;&#xA;&#9;&lt;li&gt;The Receptionist gives the room keys (or other relevant material) to the guest.&lt;/li&gt;&#xA;&lt;/ol&gt;&#xA;"/>
        </eAnnotations>
      </xmi:Extension>
    </packagedElement>
    <packagedElement xsi:type="uml:UseCase" xmi:id="_zgE-AJUZEeqqGZh46IEtXQ" name="Guest Check-out">
      <xmi:Extension extender="http://www.eclipse.org/emf/2002/Ecore">
        <eAnnotations xmi:id="_zgE-AZUZEeqqGZh46IEtXQ" source="genmymodel">
          <details xmi:id="_zgE-ApUZEeqqGZh46IEtXQ" key="uuid" value="_n8D7gWN6EDadV45R_-upHg"/>
          <details xmi:id="_zgFjoJUZEeqqGZh46IEtXQ" key="gmm-documentation" value="&lt;p&gt;A guest is ready to leave the hotel and checks-out.&lt;/p&gt;&#xA;&#xA;&lt;ol&gt;&#xA;&#9;&lt;li&gt;The guest request to check-out.&lt;/li&gt;&#xA;&#9;&lt;li&gt;The Receptionist enters/searches the room name(/number).&lt;/li&gt;&#xA;&#9;&lt;li&gt;The system retrieves the details.&lt;/li&gt;&#xA;&#9;&lt;li&gt;The Receptionist deals with any billing issues -- outside the scope of the system.&lt;/li&gt;&#xA;&#9;&lt;li&gt;The guest pays the bill -- again outside the scope.&lt;/li&gt;&#xA;&#9;&lt;li&gt;The user confirms the check-out.&lt;/li&gt;&#xA;&#9;&lt;li&gt;The system records the check-out date/time against the&amp;nbsp;the Booking and changes the status to &amp;#39;DEPARTED&amp;#39;.&lt;/li&gt;&#xA;&lt;/ol&gt;&#xA;"/>
        </eAnnotations>
      </xmi:Extension>
    </packagedElement>

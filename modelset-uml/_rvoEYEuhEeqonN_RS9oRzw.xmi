  <uml:Model xmi:id="_multUJQ4EeqqGZh46IEtXQ" name="online-shopping-cart">
    <xmi:Extension extender="http://www.eclipse.org/emf/2002/Ecore">
      <eAnnotations xmi:id="_multUZQ4EeqqGZh46IEtXQ" source="genmymodel">

  <uml:Model xmi:id="_P36P0JVREeqqGZh46IEtXQ" name="hospitalmanagementsystem" visibility="private">
    <xmi:Extension extender="http://www.eclipse.org/emf/2002/Ecore">
      <eAnnotations xmi:id="_P36P0ZVREeqqGZh46IEtXQ" source="genmymodel">
        <details xmi:id="_P36P0pVREeqqGZh46IEtXQ" key="uuid" value="690b2710-9302-4d68-9046-8878e496c0d9"/>
        <details xmi:id="_P36P05VREeqqGZh46IEtXQ" key="gmm-documentation" value="&lt;div&gt;This a UML model for the Hospital Management System. This a a first version which has to be improved. Butthe main entites are given.&lt;/div&gt;&lt;div&gt;The hospital has several departments like Cardiology, Orthopedics, Pediatrics &amp;nbsp;etc. department.&amp;nbsp;&lt;/div&gt;&lt;div&gt;At reception the patient details are entered and the fees are also taken and the patient is tracked on the basis of his Id. &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/div&gt;&lt;div&gt;A patient can visit the doctors either directly selecting a doctor or by getting admitted to the hospital and then a doctor visits the patients.&lt;/div&gt;"/>
      </eAnnotations>
    </xmi:Extension>

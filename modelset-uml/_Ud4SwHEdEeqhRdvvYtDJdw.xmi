  <uml:Model xmi:id="_gG3hAJfeEeqEM7mFKilpXw" name="online-shopping-cart">
    <xmi:Extension extender="http://www.eclipse.org/emf/2002/Ecore">
      <eAnnotations xmi:id="_gG3hAZfeEeqEM7mFKilpXw" source="genmymodel">
        <details xmi:id="_gG3hApfeEeqEM7mFKilpXw" key="uuid" value="_Ud4SwHEdEeqhRdvvYtDJdw"/>
        <details xmi:id="_gG3hA5feEeqEM7mFKilpXw" key="gmm-documentation" value="&lt;span style=&quot;font-size: 14.44444465637207px; line-height: 20px;&quot;&gt;Online customer can browse or search items, view specific item, add it to shopping cart, view and update shopping cart, checkout. User can view shopping cart at any time.&lt;/span&gt;"/>
      </eAnnotations>
    </xmi:Extension>
    <ownedComment xmi:id="_gG3hBJfeEeqEM7mFKilpXw" body="This class diagram represents the entities and relations of an online shopping cart system. It's one of the possible designs for such a system.  Fork it to generate Java, SQL and more to get a usable implementation.  See also the activity diagram available in the tree structure.">
      <xmi:Extension extender="http://www.eclipse.org/emf/2002/Ecore">
        <eAnnotations xmi:id="_gG3hBZfeEeqEM7mFKilpXw" source="genmymodel">
          <details xmi:id="_gG3hBpfeEeqEM7mFKilpXw" key="uuid" value="_oozEAF2mEDCmZJZW1tvwBA"/>
        </eAnnotations>
      </xmi:Extension>

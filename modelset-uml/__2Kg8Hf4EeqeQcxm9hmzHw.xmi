        <eAnnotations xmi:id="_LXN5lZfHEeqEM7mFKilpXw" source="genmymodel">
          <details xmi:id="_LXN5lpfHEeqEM7mFKilpXw" key="uuid" value="_oozEAF2mEDCmZJZW1tvwBA"/>

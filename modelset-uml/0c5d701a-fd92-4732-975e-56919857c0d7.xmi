      <ownedComment xmi:id="_ZKFJWZVdEeqqGZh46IEtXQ" annotatedElement="_ZKFJzpVdEeqqGZh46IEtXQ" body="Here we suppose that the URL ${brandSlug}/${eventSlug}/parties/${ambassadorPseudo}/invitations/${partyAccessToken} is valid and that the party access token is valid.">
        <xmi:Extension extender="http://www.eclipse.org/emf/2002/Ecore">
          <eAnnotations xmi:id="_ZKFJWpVdEeqqGZh46IEtXQ" source="genmymodel">
            <details xmi:id="_ZKFJW5VdEeqqGZh46IEtXQ" key="uuid" value="_zYAdwNfIEDOzXexiwbv19Q"/>
          </eAnnotations>
        </xmi:Extension>
      </ownedComment>
      <ownedComment xmi:id="_ZKFJXJVdEeqqGZh46IEtXQ" body="The activation URL is built depending on where the subscription has been done (on the Web App, the Website or the Mobile App).&#xA;&#xA;The activation URL is built with a &quot;redirect_url&quot; parameter which allows a redirection to the party invitation page (the user is automatically connected)">
        <xmi:Extension extender="http://www.eclipse.org/emf/2002/Ecore">

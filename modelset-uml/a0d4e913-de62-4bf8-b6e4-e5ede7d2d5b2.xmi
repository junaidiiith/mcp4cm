<xmi:XMI xmi:version="2.1" xmlns:xmi="http://schema.omg.org/spec/XMI/2.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:uml="http://www.eclipse.org/uml2/5.0.0/UML">
  <uml:Model xmi:id="_pLKoAJQ5EeqqGZh46IEtXQ" name="OnlineShoppingSystem">
    <xmi:Extension extender="http://www.eclipse.org/emf/2002/Ecore">
      <eAnnotations xmi:id="_pLKoAZQ5EeqqGZh46IEtXQ" source="genmymodel">
        <details xmi:id="_pLKoApQ5EeqqGZh46IEtXQ" key="uuid" value="a0d4e913-de62-4bf8-b6e4-e5ede7d2d5b2"/>
        <details xmi:id="_pLKoA5Q5EeqqGZh46IEtXQ" key="gmm-documentation" value=""/>
      </eAnnotations>
    </xmi:Extension>
    <ownedComment xmi:id="_pLKoBJQ5EeqqGZh46IEtXQ" body="&lt;b&gt;This class diagrams shows the domain model of an Online Shopping System&lt;/b&gt;. It has specific choices matching my specifications: the web visitor is not distinguished from the Customer (only 1 entity), IDs are represented, items and products are two separated entities. This UML-compliant diagram tends to be an overview of the wide range of designs you could make for the shopping system. &lt;b&gt;Take a further look at the code generated from it &lt;/b&gt;(you can generate Java from GenMyModel), it should help to bootstrap your system or to understand the technical/code impacts of the relations and attributes.">
      <xmi:Extension extender="http://www.eclipse.org/emf/2002/Ecore">
        <eAnnotations xmi:id="_pLKoBZQ5EeqqGZh46IEtXQ" source="genmymodel">
          <details xmi:id="_pLKoBpQ5EeqqGZh46IEtXQ" key="uuid" value="_Z6EuEF5cEDCXM77MyYasLQ"/>
        </eAnnotations>
      </xmi:Extension>
    </ownedComment>
    <ownedComment xmi:id="_pLKoB5Q5EeqqGZh46IEtXQ" body="&lt;br/&gt;&#xA;A typical use is following: on the Shopping Cart Page, the Customer modifies the quantity of an Item in the Shopping Cart and then the system stores the new quantity, and then computes and displays the new cost (total price) for that item.&#xA;&#xA;&#xA;">
      <xmi:Extension extender="http://www.eclipse.org/emf/2002/Ecore">
        <eAnnotations xmi:id="_pLKoCJQ5EeqqGZh46IEtXQ" source="genmymodel">
          <details xmi:id="_pLKoCZQ5EeqqGZh46IEtXQ" key="uuid" value="_-TxOgF5dEDCXM77MyYasLQ"/>
        </eAnnotations>
      </xmi:Extension>
    </ownedComment>
    <ownedComment xmi:id="_pLKoCpQ5EeqqGZh46IEtXQ" body="&lt;br/&gt;&#xA;Notice that domain classes like Catalog, Page..are not given here. It's up to the architect who should answer the question: are they part of the core system ?">
      <xmi:Extension extender="http://www.eclipse.org/emf/2002/Ecore">
        <eAnnotations xmi:id="_pLKoC5Q5EeqqGZh46IEtXQ" source="genmymodel">
          <details xmi:id="_pLKoDJQ5EeqqGZh46IEtXQ" key="uuid" value="_Xq7EAF5eEDCXM77MyYasLQ"/>
        </eAnnotations>
      </xmi:Extension>
    </ownedComment>

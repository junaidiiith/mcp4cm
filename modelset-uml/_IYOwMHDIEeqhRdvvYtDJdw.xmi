  <uml:Model xmi:id="_mCIzUJfjEeqEM7mFKilpXw" name="online-shopping-cart">
    <xmi:Extension extender="http://www.eclipse.org/emf/2002/Ecore">
      <eAnnotations xmi:id="_mCIzUZfjEeqEM7mFKilpXw" source="genmymodel">

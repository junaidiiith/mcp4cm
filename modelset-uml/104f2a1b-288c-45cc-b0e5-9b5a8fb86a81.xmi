        <eAnnotations xmi:id="_G5OpupW2EeqqGZh46IEtXQ" source="genmymodel">
          <details xmi:id="_G5Opu5W2EeqqGZh46IEtXQ" key="uuid" value="_haX3wLj_EDGCyZp7pud_eA"/>
          <details xmi:id="_G5OpvJW2EeqqGZh46IEtXQ" key="gmm-documentation" value="&lt;p&gt;var typJ = (760 / 65535),&lt;br /&gt;&#xA;&amp;nbsp; &amp;nbsp; typK = (1370 / 65535);&lt;/p&gt;&#xA;&#xA;&lt;p&gt;function out_round(value, exp) {&lt;br /&gt;&#xA;&amp;nbsp; &amp;nbsp; if (typeof exp === &amp;#39;undefined&amp;#39; || +exp === 0)&lt;br /&gt;&#xA;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; return Math.round(value);&lt;/p&gt;&#xA;&#xA;&lt;p&gt;&amp;nbsp; &amp;nbsp; value = +value;&lt;br /&gt;&#xA;&amp;nbsp; &amp;nbsp; exp = +exp;&lt;/p&gt;&#xA;&#xA;&lt;p&gt;&amp;nbsp; &amp;nbsp; if (isNaN(value) || !(typeof exp === &amp;#39;number&amp;#39; &amp;amp;&amp;amp; exp % 1 === 0))&lt;br /&gt;&#xA;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; return NaN;&lt;/p&gt;&#xA;&#xA;&lt;p&gt;&amp;nbsp; &amp;nbsp; // Shift&lt;br /&gt;&#xA;&amp;nbsp; &amp;nbsp; value = value.toString().split(&amp;#39;e&amp;#39;);&lt;br /&gt;&#xA;&amp;nbsp; &amp;nbsp; value = Math.round(+(value[0] + &amp;#39;e&amp;#39; + (value[1] ? (+value[1] + exp) : exp)));&lt;/p&gt;&#xA;&#xA;&lt;p&gt;&amp;nbsp; &amp;nbsp; // Shift back&lt;br /&gt;&#xA;&amp;nbsp; &amp;nbsp; value = value.toString().split(&amp;#39;e&amp;#39;);&lt;br /&gt;&#xA;&amp;nbsp; &amp;nbsp; return +(value[0] + &amp;#39;e&amp;#39; + (value[1] ? (+value[1] - exp) : -exp));&lt;br /&gt;&#xA;}&lt;/p&gt;&#xA;&#xA;&lt;p&gt;exports.GetAdam = function (data, type, round) {&lt;br /&gt;&#xA;&amp;nbsp; &amp;nbsp; var retData = [];&lt;br /&gt;&#xA;&amp;nbsp; &amp;nbsp; if (data.length &amp;gt; 0) {&lt;br /&gt;&#xA;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; for (var x = 0; x &amp;lt; data.length; x++) {&lt;br /&gt;&#xA;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; switch (type) {&lt;br /&gt;&#xA;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; case &amp;quot;J&amp;quot;:&lt;br /&gt;&#xA;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; retData[x] = ( data[x] == -1 ) ? -1 : out_round(data[x] * typJ, round);&lt;br /&gt;&#xA;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; break;&lt;br /&gt;&#xA;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; case &amp;quot;K&amp;quot;:&lt;br /&gt;&#xA;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; retData[x] = ( data[x] == -1 ) ? -1 : out_round(data[x] * typK, round);&lt;br /&gt;&#xA;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; break;&lt;br /&gt;&#xA;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; default :&lt;br /&gt;&#xA;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; retData[x] = 0;&lt;br /&gt;&#xA;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; }&lt;br /&gt;&#xA;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; }&lt;br /&gt;&#xA;&amp;nbsp; &amp;nbsp; }&lt;br /&gt;&#xA;&amp;nbsp; &amp;nbsp; return retData;&lt;br /&gt;&#xA;};&lt;/p&gt;&#xA;"/>
        </eAnnotations>
      </xmi:Extension>

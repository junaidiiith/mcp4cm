<xmi:XMI xmi:version="2.1" xmlns:xmi="http://schema.omg.org/spec/XMI/2.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:uml="http://www.eclipse.org/uml2/5.0.0/UML">
  <uml:Model xmi:id="_7b3ooJfxEeqEM7mFKilpXw" name="online-shopping-cart">
    <xmi:Extension extender="http://www.eclipse.org/emf/2002/Ecore">
      <eAnnotations xmi:id="_7b3ooZfxEeqEM7mFKilpXw" source="genmymodel">
        <details xmi:id="_7b3oopfxEeqEM7mFKilpXw" key="uuid" value="_53x30EihEeqonN_RS9oRzw"/>
        <details xmi:id="_7b3oo5fxEeqEM7mFKilpXw" key="gmm-documentation" value="&lt;p&gt;&amp;nbsp;Clientul online poate răsfoi sau căuta articole, vizualiza anumite articole, &amp;icirc;l poate adăuga &amp;icirc;n coșul de cumpărături, poate vizualiza și actualiza coșul de cumpărături, plata. Utilizatorul poate vizualiza coșul de cumpărături &amp;icirc;n orice moment.&lt;/p&gt;&#xA;"/>
        <details xmi:id="_7b3opJfxEeqEM7mFKilpXw" key="author" value="Gheorghe Catalin"/>
        <details xmi:id="_7b3opZfxEeqEM7mFKilpXw" key="company" value="Upit"/>
      </eAnnotations>
    </xmi:Extension>
    <ownedComment xmi:id="_7b3oppfxEeqEM7mFKilpXw" body=" Această diagramă de clasă reprezintă entitățile și relațiile unui sistem de coșuri de cumpărături online. Este unul dintre proiectele posibile pentru un astfel de sistem.">
      <xmi:Extension extender="http://www.eclipse.org/emf/2002/Ecore">
        <eAnnotations xmi:id="_7b3op5fxEeqEM7mFKilpXw" source="genmymodel">
          <details xmi:id="_7b3oqJfxEeqEM7mFKilpXw" key="uuid" value="_oozEAF2mEDCmZJZW1tvwBA"/>
        </eAnnotations>
      </xmi:Extension>
    </ownedComment>

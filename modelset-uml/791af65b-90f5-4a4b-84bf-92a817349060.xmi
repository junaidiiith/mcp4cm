<xmi:XMI xmi:version="2.1" xmlns:xmi="http://schema.omg.org/spec/XMI/2.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:uml="http://www.eclipse.org/uml2/5.0.0/UML">
  <uml:Model xmi:id="_jZFxgJlkEeqEM7mFKilpXw" name="com.genmymodel.shoppingcart">
    <xmi:Extension extender="http://www.eclipse.org/emf/2002/Ecore">
      <eAnnotations xmi:id="_jZFxgZlkEeqEM7mFKilpXw" source="genmymodel">
        <details xmi:id="_jZFxgplkEeqEM7mFKilpXw" key="uuid" value="791af65b-90f5-4a4b-84bf-92a817349060"/>
        <details xmi:id="_jZFxg5lkEeqEM7mFKilpXw" key="gmm-documentation" value="&lt;span style=&quot;font-size: 14.44444465637207px; line-height: 20px;&quot;&gt;Online customer can browse or search items, view specific item, add it to shopping cart, view and update shopping cart, checkout. User can view shopping cart at any time.&lt;/span&gt;"/>
      </eAnnotations>
    </xmi:Extension>
    <ownedComment xmi:id="_jZFxhJlkEeqEM7mFKilpXw" body="This class diagram represents the entities and relations of an online shopping cart system. It's one of the possible designs for such a system.  Fork it to generate Java, SQL and more to get a usable implementation.  See also the activity diagram available in the tree structure.">
      <xmi:Extension extender="http://www.eclipse.org/emf/2002/Ecore">
        <eAnnotations xmi:id="_jZFxhZlkEeqEM7mFKilpXw" source="genmymodel">

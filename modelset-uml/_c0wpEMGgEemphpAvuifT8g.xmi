    <ownedComment xmi:id="_wkfJBJfpEeqEM7mFKilpXw" body="Weide&#xA;Kann aufgeteilt werden in X Weideflächen&#xA;">
      <xmi:Extension extender="http://www.eclipse.org/emf/2002/Ecore">
        <eAnnotations xmi:id="_wkfJBZfpEeqEM7mFKilpXw" source="genmymodel">

        <eAnnotations xmi:id="_8BVONZlGEeqEM7mFKilpXw" source="genmymodel">
          <details xmi:id="_8BVONplGEeqEM7mFKilpXw" key="uuid" value="_oozEAF2mEDCmZJZW1tvwBA"/>

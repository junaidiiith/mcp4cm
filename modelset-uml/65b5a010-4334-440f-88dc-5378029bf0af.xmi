      <eAnnotations xmi:id="_ZqaT8ZgrEeqEM7mFKilpXw" source="genmymodel">
        <details xmi:id="_ZqaT8pgrEeqEM7mFKilpXw" key="uuid" value="65b5a010-4334-440f-88dc-5378029bf0af"/>
        <details xmi:id="_ZqaT85grEeqEM7mFKilpXw" key="gmm-documentation" value="&lt;div&gt;This a UML model for the Hospital Management System. This a a first version which has to be improved. Butthe main entites are given.&lt;/div&gt;&lt;div&gt;The hospital has several departments like Cardiology, Orthopedics, Pediatrics &amp;nbsp;etc. department.&amp;nbsp;&lt;/div&gt;&lt;div&gt;At reception the patient details are entered and the fees are also taken and the patient is tracked on the basis of his Id. &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/div&gt;&lt;div&gt;A patient can visit the doctors either directly selecting a doctor or by getting admitted to the hospital and then a doctor visits the patients.&lt;/div&gt;"/>
      </eAnnotations>
    </xmi:Extension>

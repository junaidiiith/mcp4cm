  <uml:Model xmi:id="_-8WocJfTEeqEM7mFKilpXw" name="online-shopping-cart">
    <xmi:Extension extender="http://www.eclipse.org/emf/2002/Ecore">
      <eAnnotations xmi:id="_-8WocZfTEeqEM7mFKilpXw" source="genmymodel">

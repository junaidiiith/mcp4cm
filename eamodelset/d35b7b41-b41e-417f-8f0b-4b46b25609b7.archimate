      <documentation>Het op basis van verwachte (geprognosticeerde) en vastgestelde behoeften indelen van beschikbare huisvestingsfaciliteiten in (meer)jarenplanningen en roosters.</documentation>
      <property key="SWC type" value="Bedrijfsfunctie"/>
      <property key="SWC status" value="In gebruik"/>
    </element>

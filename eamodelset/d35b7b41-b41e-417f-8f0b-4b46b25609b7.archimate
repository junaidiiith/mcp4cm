    <element xsi:type="archimate:BusinessActor" name="VO-raad" id="id-8bd708a9-17a3-4ba8-bcfc-5bad6e019f3d">
      <documentation>De VO-raad is een vereniging van schoolbesturen en ruim scholen in het voortgezet onderwijs.</documentation>
      <property key="Werkingsgebied" value="VO-raad"/>

      <property key="Werkingsgebied" value="Onderwijsdomein"/>
      <property key="Type" value="Rol"/>
      <property key="SWC status" value="In gebruik"/>
      <property key="SWC type" value="Rol"/>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Kamer van Koophandel" id="id-09721426-bfa6-4e01-b4b5-a74a33edad55">
      <documentation>Organisatie die registratie van en diensten voor bedrijven in Nederland verzorgt.</documentation>
      <property key="SWC status" value="In gebruik"/>
      <property key="SWC type" value="Organisatie"/>
    </element>

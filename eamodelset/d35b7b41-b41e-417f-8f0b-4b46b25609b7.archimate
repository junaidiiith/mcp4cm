    <element xsi:type="archimate:BusinessProcess" name="Overdragen OKR" id="id-3fc051db17e9459ab470b31392af5698"/>
    <element xsi:type="archimate:BusinessProcess" name="Uitwisselen met DUO / ROD" id="id-9f0c01c567174a4da6e5a3638e2305bc"/>
    <element xsi:type="archimate:BusinessProcess" name="Oriënteren onderwijsaanbod" id="id-08a52faffd4b40a6a639801d63d7408e"/>
    <element xsi:type="archimate:BusinessProcess" name="Verzuimmaatregelen controleren" id="id-2331be030efa428db20cf2a3f853a531">
      <documentation>Het bepalen wat het resultaat is van de uitgevoerde verzuimmaatregelen.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Opvragen gegevens voor(schools)traject" id="id-8f233d3f971b4bb5bad3aad33e599c8f"/>
    <element xsi:type="archimate:BusinessProcess" name="Bepalen meldingsplicht" id="id-6df8ca56cdf442e9add00fab3048319d">
      <documentation>Het bepalen of er een melding gedaan moet worden bij de gemeente van een ongeoorloofd verzuim. Er moet een melding bij de gemeente gemaakt worden via het DUO verzuimloket. Via DUO wordt de melding verwerkt richting de gemeente/leerplichtambtenaar.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Organiseren onderwijsaanbod" id="id-d92db36ad679472596705c7f5ca90756"/>
    <element xsi:type="archimate:BusinessProcess" name="Controleer / achterhaal BSN / onderwijsnummer" id="id-39322d8f17ad409e9f21c29cf0a2d7c4"/>
    <element xsi:type="archimate:BusinessProcess" name="Valideren aanmeldgegevens" id="id-a1cb7142557b47b88cf2709791b6cd38"/>
    <element xsi:type="archimate:BusinessProcess" name="Bevestigen inschrijving" id="id-b314aa374d954130b7e2ffea280dd465"/>
    <element xsi:type="archimate:BusinessProcess" name="Uitvoeren lokale DPIA" id="id-db9a3411c9a348049add937d324ca441"/>
    <element xsi:type="archimate:BusinessProcess" name="Voeren gesprekken" id="id-0ffedc27c0164d7e8b0d6613006bf438"/>
    <element xsi:type="archimate:BusinessProcess" name="Indienen identificatieverzoek DUO" id="id-def7511e360f458dbdb15bfcfc391c6b"/>
    <element xsi:type="archimate:BusinessProcess" name="Vaststellen toelatingsbeleid" id="id-ff0e654fac4c4df29673b0be998c58c8"/>
    <element xsi:type="archimate:BusinessProcess" name="Uitwisselen leerlinggegevens" id="id-1af2119d954a4f76b551a19344597b69"/>
    <element xsi:type="archimate:BusinessProcess" name="Registreren verzuim" id="id-4b38ecc899904255bcf3e27ed6bb1c2e"/>
    <element xsi:type="archimate:BusinessProcess" name="Publiceren vacature" id="id-a1b9a93c8f244e9ca1e105071c0e31ac"/>
    <element xsi:type="archimate:BusinessProcess" name="Informeren ouders" id="id-e36fe694545e482aaaa65828aba20251"/>
    <element xsi:type="archimate:BusinessProcess" name="Melden verzuim bij Gemeente" id="id-859118788c3c4fdb82a39d2ce0d4eb2f">
      <documentation>Indien nodig (binnen de gestelde termijn) via het verzuimloket van DUO melding maken van het ongeoorloofde verzuim (en de catagorie) bij de leerplicht ambtenaar van de gemeente.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Monitoren verzuim" id="id-ae582118e4f54e9eb783363705b3c7a9">
      <documentation>Periodiek monitoren van het verzuim van alle leerlingen op basis van rapportage omtrent de aan/afwezigheid / het verzuim van leerlingen. Hierdoor kunnen bijvoorbeeld  frequent geoorloofd verzuim en veranderingen in patronen, zowel algemeen als voor individuele leerlingen , sneller worden opgemerkt.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Voorlichten leerlingen" id="id-9561306ba2154bd9b2fec317393abf07"/>
    <element xsi:type="archimate:BusinessProcess" name="Definitief maken aanmelding" id="id-4af9158f7ca4487b9b21df0e41889181"/>
    <element xsi:type="archimate:BusinessProcess" name="Vaststellen inschrijvingsproces" id="id-f4796430a2c84990853707fae7d81b8e"/>
    <element xsi:type="archimate:BusinessProcess" name="Zorgdragen toelating op andere school" id="id-f429cd12a28949f78f957c020ad17385"/>
    <element xsi:type="archimate:BusinessProcess" name="Analyseren verzuim" id="id-91305ff7cac74b659328dba1ddcccd3d">
      <documentation>Het op basis van bijvoorbeeld frequent verzuim van een leerling of veranderingen in patronen bepalen van de oorzaak van het verzuim en eventuele passende maatregelen om het verzuim terug te dringen en/of het nemen van maatregelen om ondersteuning te bieden. Indien nodig vindt overleg plaats met de wettelijk vertegenwoordiger en/of de leerplichtambtenaar van de gemeente waar de leerling woont.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Opstellen en beheren informatielandschap" id="id-f159665f04ad45509b650ebb1633d1b6"/>
    <element xsi:type="archimate:BusinessProcess" name="Vaststellen onderwijsaanbod" id="id-588eed6155124a6ba796c83f1197da0f"/>
    <element xsi:type="archimate:BusinessProcess" name="Opvolgen verzuim" id="id-5ad893ac24014f268b011b4ee97500ab">
      <documentation>Het opvolgen van verzuim door acties intern/extern uit te zetten. De resultaten van de acties te controleren om vervolgens de melding te sluiten of de melding over te dragen voor verdere analyse.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Vacaturevraag opstellen" id="id-de1fbe35be6f4d7c87013edb532c02c4"/>
    <element xsi:type="archimate:BusinessProcess" name="Gereedmaken ict / LAS rondom onderwijsaanbod" id="id-42549b61ae9a43aabe5586062837178a"/>
    <element xsi:type="archimate:BusinessProcess" name="Inventariseren applicatieportfolio" id="id-73aeab42c55f4b2a97262da9964de431"/>
    <element xsi:type="archimate:BusinessProcess" name="Opstellen vacaturetekst" id="id-9c360eddc6554feca6dc63673658cd10"/>
    <element xsi:type="archimate:BusinessProcess" name="Afzeggen overige kandidaten" id="id-dd3743108bdf4c7b976406cf5a98bb18"/>
    <element xsi:type="archimate:BusinessProcess" name="Presenteren onderwijsaanbod" id="id-0bea3a340afe48eea18ee4b425e0c9c7"/>
    <element xsi:type="archimate:BusinessProcess" name="Samenstellen sollicitatiecommissie" id="id-bc9976745dc346138a9195bfc280e9b6"/>
    <element xsi:type="archimate:BusinessProcess" name="Inwinnen aanvullende gegevens" id="id-a0ca77daa47e4a6cb356070d781ef6c0"/>
    <element xsi:type="archimate:BusinessProcess" name="Registreren leer- en begeleidingsgegevens" id="id-381bae22790c44b6aaa821f43acbaf33"/>
    <element xsi:type="archimate:BusinessProcess" name="Opstellen / adviseren beveiligingsmaatregelen" id="id-616c56b703c64245b8a98b983c3613dd"/>
    <element xsi:type="archimate:BusinessProcess" name="Beheren aanmeldingen" id="id-c67b9cfa57da4ef88f9974f025fdbd75"/>
    <element xsi:type="archimate:BusinessProcess" name="Plaatsen leerling" id="id-ad849e1eb72d43bd8234ef585bdb05d9"/>
    <element xsi:type="archimate:BusinessProcess" name="Communiceren met wettelijke vertegenwoordiger leerling" id="id-3f31db7ae9554e1c87ab8dde24125eee">
      <documentation>Communiceren met de wettelijk vertegenwoordiger van de leerling om duidelijkheid te krijgen over de afwezigheid van de leerling, bijvoorbeeld omdat de leerling afwezig, maar niet ziek / absent gemeld is, en daarom na  te vragen of er iets is gebeurd dan wel de leerling nog niet ziek / absent gemels is.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Verwerken / delen informatie" id="id-9c7d597a989e43cab964c7b07b86b6b2"/>

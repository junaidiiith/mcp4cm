    </element>
    <element xsi:type="archimate:BusinessService" name="Toegang tot digitaal lesmateriaal" id="id-d387753606224358889623c890161479">
      <documentation>Het proces dat beschrijft hoe een gebruiker toegelaten kan worden tot het educatieve digitale product en in staat wordt gesteld gebruik te maken van digitaal leermateriaal. Bron: ECK D&amp;T 2.1</documentation>
      <property key="SWC type" value="Landelijke dienst"/>
      <property key="SWC status" value="In gebruik"/>
    </element>
    <element xsi:type="archimate:BusinessFunction" name="Samenwerken en communiceren medewerkers en extern" id="id-0cc86529-3d07-4143-a074-28f072817642">
      <documentation>Uitwisseling van berichten en/of documenten met collega's binnen en buiten de eigen onderwijsorganisatie, leveranciers en andere interne en externe partijen.</documentation>
      <property key="SWC type" value="Bedrijfsfunctie"/>
      <property key="Werkingsgebied" value="FO"/>
      <property key="SWC status" value="In gebruik"/>
    </element>
    <element xsi:type="archimate:BusinessFunction" name="Ict-servicemanagement" id="ca214a6d-7572-4cc4-81dd-fd569e32a338">
      <documentation>Verantwoordelijkheid voor het beheren en onderhouden van ict-diensten.</documentation>
      <property key="SWC type" value="Bedrijfsfunctie"/>
      <property key="SWC status" value="In gebruik"/>
    </element>

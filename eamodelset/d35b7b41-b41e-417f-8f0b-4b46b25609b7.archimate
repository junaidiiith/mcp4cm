        <sourceConnection id="id-1f58749874c643e8b8a366ffd4a399b7" font="1|Lucida Grande|12.0|0|COCOA|1|" fontColor="#000000" lineColor="#000000" source="id-2dd5a3fc4d8d4f709e3af1b416b52e5b" target="id-8e1726f53e0d4dd9980d1b139031e9ec"/>

      <property key="SWC status" value="In gebruik"/>
      <property key="SWC type" value="Organisatie"/>
    </element>
    <element xsi:type="archimate:BusinessActor" name="MBO Raad" id="e02af566-9516-4c5e-b2b4-08e377ed388a">
      <documentation>De MBO Raad is de brancheorganisatie van de onderwijsinstellingen in het middelbaar beroepsonderwijs en de volwasseneneducatie.</documentation>
      <property key="Type" value="Actor"/>
      <property key="SWC status" value="In gebruik"/>
      <property key="SWC type" value="Organisatie"/>
    </element>

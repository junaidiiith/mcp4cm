      <documentation>De archivering van documenten.</documentation>
      <property key="SWC type" value="Bedrijfsfunctie"/>
      <property key="SWC status" value="In gebruik"/>
    </element>
    <element xsi:type="archimate:BusinessFunction" name="Opstellen en uitvoering ontwikkelingsperspectief(plan)" id="id-7a3dcbdc-4153-4a96-a8a0-2e6ed1557eb3">
      <documentation>Bepalen van de doelen en wensen voor een leerling met name in het speciaal onderwijs, en vervolgens het begeleiden van de leerling bij het behalen van deze doelen. De doelen en wensen worden vastgelegd in een [[Ontwikkelingsperspectiefplan (OPP)]].</documentation>
      <property key="SWC type" value="Bedrijfsfunctie"/>
      <property key="SWC status" value="In gebruik"/>
    </element>

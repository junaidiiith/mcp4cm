        <child xsi:type="archimate:DiagramObject" id="id-24fe9a0c92fe494cb156a9c833f66ae3" targetConnections="id-12e493430b934efc80967a22f98dbb82 id-9b85a9e18d484e3d938800b56ca9731e" font="1|Lucida Grande|12.0|0|COCOA|1|" fontColor="#000000" lineColor="#5c5c5c" fillColor="#ffffb5" archimateElement="id-ca5aea2bcb804c8f923f694044ba4dee">

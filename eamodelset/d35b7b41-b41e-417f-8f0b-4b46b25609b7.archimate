    <element xsi:type="archimate:BusinessObject" name="Leerwegondersteund onderwijs" id="id-dd3af3889a76495b9d929b7d8935e456">
      <documentation>Leerwegondersteunend onderwijs (lwoo) wordt gegeven op een reguliere vmbo-school en leidt op voor een gewoon vmbo-diploma dat toegang geeft tot het mbo (middelbaar beroepsonderwijs).</documentation>
      <property key="Onderwijsbegrippen.nl" value="Nee"/>

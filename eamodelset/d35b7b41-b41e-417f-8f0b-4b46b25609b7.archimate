    <element xsi:type="archimate:BusinessObject" name="Grondslag" id="id-5bed7a41e0ec4b3096195fb503ddf1fc">
      <documentation>De reden waarvoor persoonsgegevens moeten worden verwerkt, en die de rechtmatigheid van de verwerking aangeeft.</documentation>
      <property key="Toelichting" value="De AVG kent zes grondslagen voor het verwerken van persoonsgegevens: toestemming, uitvoering van de overeenkomst, wettelijke verplichting, vitaal belang van betrokkene of andere personen, algemeen belang of gerechtvaardigd belang. Een verwerking van persoonsgegevens is alleen rechtmatig indien en voor zover aan tenminste een van de voorwaarden is voldaan."/>
      <property key="Onderwijsbegrippen.nl" value="Nee"/>
      <property key="Beschikbaarheid" value="Laag"/>
      <property key="Integriteit" value="Laag"/>
      <property key="Vertrouwelijkheid" value="Laag"/>
      <property key="Persoonsgegevens" value="Nee"/>
      <property key="Gegevenscategorie" value="Richting"/>
      <property key="Domein" value="Bedrijfsvoering"/>
      <property key="Sector" value="FO"/>
      <property key="Bron" value="FORA-Serviceteam"/>
      <property key="Status" value="Definitief"/>
      <property key="Statusdatum" value="30-9-2022"/>
    </element>

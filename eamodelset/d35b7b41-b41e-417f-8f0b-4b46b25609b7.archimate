      <child xsi:type="archimate:Note" id="id-09304f8777434ea39d595781a9772fcf" font="1|Lucida Grande|12.0|0|COCOA|1|" fontColor="#000000" lineColor="#5c5c5c" textAlignment="1" fillColor="#ffffff">

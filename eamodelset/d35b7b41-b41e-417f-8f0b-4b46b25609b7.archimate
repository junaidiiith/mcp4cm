      <documentation>Het bepalen van de gewenste leerroute van een onderwijsvolger binnen een onderwijsorganisatie en over de grenzen van onderwijsorganisaties heen.</documentation>
      <property key="SWC type" value="Bedrijfsfunctie"/>
      <property key="SWC status" value="In gebruik"/>
    </element>

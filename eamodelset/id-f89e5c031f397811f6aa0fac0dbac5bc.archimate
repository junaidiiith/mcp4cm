      <property key="Original ID" value="id-8bb4c3f8f4d54aaa9e126cf28ec3323f"/>
      <property key="Semanticsearch" value="referentieniveau rekenen"/>
      <property key="Toelichting" value="Het geheel aan beschrijvingen wordt aangeduid met ‘het referentiekader’ en is vastgelegd in de Wet referentieniveaus Nederlandse taal en rekenen die op 1 augustus 2010 van kracht is geworden."/>
      <property key="Afgeleid van" value="rijksoverheid.nl, https://wij-leren.nl/referentieniveau.php"/>
      <property key="Status" value="Concept"/>
      <property key="Sector" value="FO"/>
      <property key="Statusdatum" value="12-7-2021"/>
    </element>

      <element xsi:type="archimate:BusinessFunction" name="Vervaardiging jaarverslag" id="id-d24d5937536ba7b4256d72462508265c">
        <documentation>Het conform wettelijke verplichting jaarlijks opstellen van een verantwoordingsdocument (jaarverslag) dat bestaat uit het bestuursverslag en de jaarrekening.</documentation>
        <property key="Object ID" value="8116c7f6-da63-4583-801e-fae243fa02dc"/>
        <property key="Original ID" value="id-8116c7f6-da63-4583-801e-fae243fa02dc"/>

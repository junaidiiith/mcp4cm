        <property key="Semanticsearch" value="mediatheekbeheer systeem"/>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Integratiesysteem" id="id-f8d6447876a3e93c365e57b0da018a5e">
        <documentation>Een systeem dat zorgdraagt voor de  uitwisseling van gegevens tussen applicaties, zoals identiteitsgegevens. 
Bevat ondermeer: API's Business logica (input/output scripts) Databank Monitoring (performance en errors) 
Andere trefwoorden: ESB Broker</documentation>
        <property key="SWC type" value="Referentiecomponent"/>

        <property key="Original ID" value="id-db0a6af2aead439a98e70066852f50fc"/>
        <property key="Semanticsearch" value="integratiesysteem"/>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Gebouwbeveiligingsysteem" id="id-3306a2fdc556748caa5d6621b8d5fb90">
        <documentation>Systeem voor het beheer van gebouwbeveiligingsvoorzieningen (ook wel het RBS - Risico Beheer Systeem genoemd). 
Denk aan: gebouwtoegangsystemen (poortjes, slagbomen, zonering), parkeerruimte teller, lift controle, inbraakdetectiesystemen, brandmelders, deurmagneetcontacten, intercominstallatie, sprinklerinstallatie, alarminstallatie, centrale meldkamer systeem, portofoon systeem, EHBO registratie, beveiligingscamera's.</documentation>
        <property key="SWC type" value="Referentiecomponent"/>
        <property key="SWC status" value="In gebruik"/>
        <property key="Object ID" value="ac70d776-195f-428ba-de63-55a7fb74889"/>
        <property key="Original ID" value="id-ac70d776195f428bade6355a7fb74889"/>

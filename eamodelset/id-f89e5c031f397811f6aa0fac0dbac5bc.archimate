      <element xsi:type="archimate:ApplicationComponent" name="Learning Analyticssysteem" id="id-2b4b411c9e59e767d8e541e0a2940731">
        <documentation>Systeem of geheel van systemen en modules waarmee de voortgang van leerlingen kan worden geanalyseerd en op basis van data (bijv. referentiegroepen) een gepersonaliseerd leeraanbod gecreëerd kan worden.</documentation>
        <property key="Object ID" value="50f9c743-1d1b-405b-a9a1-6f5cc79ae516"/>

      <element xsi:type="archimate:ApplicationComponent" name="(Instant) messaging app" id="id-97661a92cb32d5e2910adf24273fa95f">
        <documentation>App waarmee berichten zeer snel tussen deelnemers kunnen worden uitgewisseld.</documentation>
        <property key="Object ID" value="6baf5b4e-3e71-4461-b41f-3bd6a3f41283"/>

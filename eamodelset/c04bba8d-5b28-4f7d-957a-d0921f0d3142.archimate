          <element xsi:type="archimate:BusinessEvent" name="Veranderde externe omstandigheden" id="id-d0c3b6c8d70c4b8ebec865f162fd6b44">
            <documentation>Bijvoorbeeld nieuwe of veranderde wet- en regelgeving, veranderde marktomstandigheden, veranderde maatschappelijke (en/of politiek dominent wordende) opvattinmgen.</documentation>
            <property key="CORA-concepttype" value="Gebeurtenis"/>
            <property key="Bron" value="CORA 4.3"/>

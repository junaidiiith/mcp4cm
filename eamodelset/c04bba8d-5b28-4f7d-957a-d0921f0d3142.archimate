          <element xsi:type="archimate:BusinessProcess" name="Bepalen portefeuillevisie" id="id-98607ace97354509a9382674f8d4764a">
            <documentation>Bepalen portefeuillevisie is het proces waarin de voornemens ten aanzien van de voorraad(ontwikkeling) van woningcorporatie worden geconcretiseerd in doelstellingen.</documentation>
            <property key="CORA-concepttype" value="Bedrijfsproces"/>
            <property key="Bron" value="CORA 4.3"/>

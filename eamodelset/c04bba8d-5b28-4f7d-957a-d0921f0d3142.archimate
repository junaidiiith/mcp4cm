        <folder name="004b Analyseren markt- en beleidsomgeving complexen/vastgoedclusters (wijk/buurt)" id="id-2a1fa58b2ad04921bc06ffd5de4e5a73">
          <element xsi:type="archimate:BusinessService" name="Marktanalyse complexen" id="id-f174b22e4ef74fe2b7ee7e1d947b50e1">

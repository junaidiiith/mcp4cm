            <property key="CORA-concepttype" value="Gebeurtenis"/>
            <property key="Bron" value="CORA 4.1"/>
          </element>
          <element xsi:type="archimate:BusinessEvent" name="Nieuwe jaarcyclus vereist" id="id-b807f99330d34cc08b4392a116a0b213">

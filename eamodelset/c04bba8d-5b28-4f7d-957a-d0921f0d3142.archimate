            <property key="Bron" value="CORA 4.1"/>
            <property key="CORA-concepttype" value="Werkproces"/>
          </element>
          <element xsi:type="archimate:BusinessProcess" name="Beëindigen zaak kort geding/bodemprocedure" id="id-fdd32b47bcc544dda8c70ae925f64503"/>
          <element xsi:type="archimate:BusinessFunction" name="&lt;&lt;Sociaal beheer>> Sociaal beheer en leefbaarheid" id="id-c9cf86e7a167448ebc1f3aad63dc79ca">
            <documentation>Het ontwikkelen en implementeren van beleid dat betrekking heeft op sociale aspecten van de wijken en buurten waarin de woningcorporatie vastgoed exploiteert.&#xD;
&#xD;
</documentation>
            <property key="CORA-concepttype" value="Bedrijfsfunctie"/>
            <property key="Soort bedrijfsfunctie" value="Primair"/>
            <property key="Bron" value="CORA 4.0"/>
          </element>
          <element xsi:type="archimate:BusinessProcess" name="Bestellen en leveren complexsleutels voor Woonstad" id="id-b3add6bb70e54cc586c6871eaa907a81"/>
          <element xsi:type="archimate:BusinessProcess" name="Herinrichten binnenterrein" id="id-f6fbfe9a90284430a6388e796a9f10b9"/>
          <element xsi:type="archimate:BusinessProcess" name="Behandelen zaak privétuin/balkon" id="id-55f3702a3625484fa2d3e6971936087a">
            <documentation>Mijlpalen&#xD;
- Tuin/balkon gecontroleerd 1e keer&#xD;
- Tuin/balkon gecontroleerd 2e keer&#xD;
- Tuin/balkon gecontroleerd 3e keer&#xD;
- Zaak overgedragen aan sociaal beheer&#xD;
- Vervolg bepaald&#xD;
- Vervolgstappen uitgevoerd&#xD;
- Juridische procedure afgehandeld&#xD;
- Tuin/balkon in orde&#xD;
- Zaak afgerond</documentation>
          </element>
          <element xsi:type="archimate:BusinessProcess" name="&lt;&lt;Afhandelen overlast>> Afhandelen overlastmelding" id="id-7d422a9b95f24761b6bdd069a7d85f65">
            <documentation>Afhandelen overlast is het werkproces waarmee de grondslag voor de overlastmelding wordt aangepakt om daarmee de mate van overlast voor bewoners op te lossen.</documentation>
            <property key="CORA-concepttype" value="Werkproces"/>
            <property key="Type proces" value="Primair"/>
            <property key="Bron" value="CORA 4.0"/>
          </element>

        <folder name="050 Coördineren asbestsanering" id="id-8c35f26a3f9345beaed6f33125d98fb9">
          <element xsi:type="archimate:BusinessEvent" name="Asbestsanering noodzakelijk" id="id-596d575865bb446dbf2991daf390e115">
            <documentation>Op basis van diverse bedrijfsregels (zoals gebouwd voor 1994) kan verondersteld worden dat er asbest aanwezig is. </documentation>
            <property key="CORA-concepttype" value="Gebeurtenis"/>
            <property key="Toelichting" value="Trigger werkproces"/>
            <property key="Bron" value="CORA 4.2"/>
          </element>
          <element xsi:type="archimate:BusinessProcess" name="Opstellen rapport asbestinventarisatie inclusief bijlagen" id="id-771bf22dad974d158a8e4bc61451b15f">

        <child xsi:type="archimate:Group" id="id-b4055d00b90c44499ed941dd9f17540c" name="'Informtieobjecten' omzetten naar bedrijfsobject" textAlignment="1">
          <bounds x="48" y="108" width="457" height="12193"/>
          <child xsi:type="archimate:DiagramObject" id="id-b01801d6dcff4141829bb8ce69da386c" textPosition="1" archimateElement="id-36b5c13b68d2421c86f4eb9dd6e00c3b">
            <bounds x="24" y="60" width="120" height="55"/>
          </child>
          <child xsi:type="archimate:DiagramObject" id="id-9f7684268fc94f85ae6173ac9f5b5a27" textPosition="1" archimateElement="id-4825256e2f0847b7925c3a93f223d178">
            <bounds x="180" y="60" width="120" height="55"/>
          </child>
        </child>
        <child xsi:type="archimate:Group" id="id-eaa39bab0809458dae0df611ae86526f" name="'Informtieobjecten' die in zuivere zin geen informatieobject of gegevensobject is" textAlignment="1">
          <bounds x="996" y="120" width="457" height="12193"/>
          <child xsi:type="archimate:DiagramObject" id="id-83695bafe6f845ce86377f9dfe768a8e" textPosition="1" archimateElement="id-e231431daa1d494ba5b8262fbf00eb35">
            <bounds x="312" y="168" width="120" height="55"/>
          </child>
        </child>
        <child xsi:type="archimate:Group" id="id-e714d48375dd4426841bb346128589c9" name="Op 7 maart 2022 hebben CORA en VERA besproken dat informatieobjecten omgezet moeten worden naar een bedrijfsobject of waar nodig in een gegevensobject. Zodra die verdeling is gemaakt worden de objecten verder onderverdeeld naar domeinen die op inhoud zijn bepaald. " font="1|Segoe UI|9.75|1|WINDOWS|1|-13|0|0|0|700|0|0|0|0|3|2|1|34|Segoe UI" fillColor="#ffffb5" textPosition="1" borderType="1">
          <bounds x="-408" y="-12" width="1861" height="97"/>
          <documentation>Let op: informatieobjecten die omgezet moeten worden naar bedrijfsobject, moeten in de views waar ze voorkomen vervangen worden door het bedrijfsobject die in CORA reeds bestaan. Vervolgens moeten die informatieobjecten worden verwijderd uit het model. Pas als die acties zijn uitgevoerd kunnen de infromatieobjecten worden omgezet naar bedrijfsobject. Tevens moeten de relaties tussen deze bedrijfsobjecten en de processtappen gewijzigd worden.</documentation>
        </child>
        <child xsi:type="archimate:Group" id="id-f97e5d60b624402c922dcd8f3bc45288" name="domein vastgoed" textAlignment="1">
          <bounds x="-408" y="240" width="400" height="140"/>
        </child>
        <child xsi:type="archimate:Group" id="id-1439fbeb692240a2af5fe7fa3332541f" name="domein ..." textAlignment="1">
          <bounds x="-408" y="440" width="400" height="140"/>
        </child>
      </element>
    </folder>
    <folder name="Stroomversnelling" id="id-c2d31d5d120444cd826ea8fcc57c8af6">
      <element xsi:type="archimate:ArchimateDiagramModel" name="SV08 Verhuren, oplevering aan bewoner" id="id-10ef6c8fae1a4e1fba7bb95fed34ec58">
        <child xsi:type="archimate:Note" id="id-5af4b8e08cb349858a06d60d264a63fe" textAlignment="1">
          <bounds x="24" y="36" width="601" height="133"/>
          <content>Verhuren, ondertekenen contract raakt in CORA de volgende processen:</content>
        </child>
        <child xsi:type="archimate:DiagramObject" id="id-0c70ea01e6ff49be969c9f9496d8cd29" fillColor="#48a8ff" textPosition="1" archimateElement="id-610ec9dd28be46ef85bd536adad76d58">
          <bounds x="48" y="75" width="120" height="55"/>
        </child>
      </element>
      <element xsi:type="archimate:ArchimateDiagramModel" name="SV05 Uitvoering en Realisatie" id="id-bfe7bccb31184c009ad694e9e5ef0a15">
        <child xsi:type="archimate:Note" id="id-a8afb3fba66b458aa938f62253acfb9e" textAlignment="1">
          <bounds x="24" y="36" width="625" height="133"/>
          <content>Uitvoering en Realisatie raakt in CORA de volgende processen:</content>
        </child>
        <child xsi:type="archimate:DiagramObject" id="id-52c46da8f75f4931b7a62bf722f8d2d9" fillColor="#48a8ff" textPosition="1" archimateElement="2086ce97-f65c-4dc3-9fb4-73cefcaaf771">

    <folder name="VERA referentieprocessen" id="id-de8ee855f016489dbb2a010982324a43">
      <element xsi:type="archimate:Grouping" name="VERA referentieproces 'Regisseren onderhoud'" id="id-a2b8783aaf3540ad96fbf08f23be3cfc"/>
      <element xsi:type="archimate:Grouping" name="VERA referentieproces 'Regisseren reparatie onderhoud" id="id-9d0a70a10e8c4b62be3551692dd22e00"/>
      <element xsi:type="archimate:Grouping" name="VERA referentieproces 'Intake reparatieverzoek'" id="id-676dad1282be487bb504be19a30bb031"/>

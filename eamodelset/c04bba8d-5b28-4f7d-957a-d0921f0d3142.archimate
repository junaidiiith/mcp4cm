        <property key="Domein" value="Woningwaardering"/>
      </element>
      <element xsi:type="archimate:Grouping" name="Dossier" id="id-757edb8229aa401191e0f5b98ae31688">
        <property key="CORA-concepttype" value="Bedrijfsobjecten-domein"/>
        <property key="Bron" value="CORA 4.2"/>
        <property key="Domein" value="Dossier"/>
      </element>
      <element xsi:type="archimate:Grouping" name="Waarde onroerende zaken (WOZ)" id="id-42b0f6a17ccc4479a56a350d915a726d">
        <property key="Bron" value="Digitale Overheid"/>

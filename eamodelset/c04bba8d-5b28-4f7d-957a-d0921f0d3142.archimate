            <property key="Bron" value="CORA 4.1"/>
          </element>
          <element xsi:type="archimate:BusinessService" name="Huurdersbelang VVEvraagstuk" id="c515847b-a1ff-47b7-aeda-bdeac5bc1d1a">
            <property key="CORA-concepttype" value="Bedrijfsservice"/>
            <property key="Toelichting" value="Output werkproces"/>
            <property key="Bron" value="CORA 4.1"/>
          </element>
          <element xsi:type="archimate:BusinessService" name="VvE participatie ALV" id="e74609f5-287a-4d85-a048-d978d37f8a0b">
            <property key="CORA-concepttype" value="Bedrijfsservice"/>
            <property key="Toelichting" value="Output werkproces"/>
            <property key="Bron" value="CORA 4.1"/>
          </element>
          <element xsi:type="archimate:BusinessProcess" name="Participeren ALV" id="01b8e6ac-482f-4da9-9c25-ae48fcc15a03">
            <documentation>Participeren ALV is het bedrijfsproces waarmee deelname aan VVE vergaderingen worden voorbereid, uitgevoerd en relevante VVEbesluiten aan huurders worden teruggekoppeld</documentation>
            <property key="CORA-concepttype" value="Bedrijfsproces"/>

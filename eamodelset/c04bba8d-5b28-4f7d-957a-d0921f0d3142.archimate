            <property key="CORA-concepttype" value="Gebeurtenis"/>
            <property key="Bron" value="CORA 4.1"/>
          </element>
          <element xsi:type="archimate:BusinessProcess" name="Voeren technisch beheer VVE" id="205fae25-6aac-49cd-9b95-68b6f10e0067">
            <documentation>Voeren technisch beheer VVE is het bedrijfsproces waarmee het technisch beheer van de VVE wordt uitgevoerd</documentation>
            <property key="CORA-concepttype" value="Bedrijfsproces"/>
            <property key="Bron" value="CORA 4.0"/>
            <property key="Type proces" value="Primair"/>
            <property key="View" value="035 Voeren technisch beheer VVE"/>
            <property key="Procesmodel" value="Ja"/>
          </element>
          <element xsi:type="archimate:BusinessEvent" name="Verzoek nieuwe MJOB VvE" id="id-f4678d75c9174cfca0f14908be836060">
            <property key="CORA-concepttype" value="Gebeurtenis"/>
            <property key="Bron" value="CORA 4.1"/>
            <property key="Toelichting" value="Trigger werkproces"/>
          </element>
          <element xsi:type="archimate:BusinessService" name="Ingekocht planmatig onderhoud" id="08b4abd2-8789-4b01-923c-b565ec93bdb6">
            <property key="CORA-concepttype" value="Bedrijfsservice"/>
            <property key="Toelichting" value="Output werkproces"/>
            <property key="Bron" value="CORA 4.0"/>
          </element>
          <element xsi:type="archimate:BusinessEvent" name="Verzoek nieuwe MJOB VvE uitgevoerd" id="id-f7d823c6af184e84ac1173252b323ba4">
            <property key="CORA-concepttype" value="Gebeurtenis"/>
            <property key="Bron" value="CORA 4.1"/>
          </element>
          <element xsi:type="archimate:BusinessProcess" name="Opstellen en verstrekken (M)JOB" id="82306304-4283-4be7-862d-fd6bec041070">
            <documentation>Opstellen en verstrekken meerjarenonderhoudsbegroting is het werkproces waarin de temporisering en omvang van te plannen onderhoudswerkzaamheden worden doorgerekend op effectiviteit en prijs  en ter besluitvoming van de jaarlijkse vvEvergadering een scenario wordt uitgewerkt en de onderhoudsbegroting voor het komende boekjaar wordt bepaald.</documentation>
            <property key="CORA-concepttype" value="Werkproces"/>
            <property key="Type proces" value="Primair"/>
            <property key="BIM" value="Ja"/>
            <property key="Bron" value="CORA 4.0"/>
            <property key="View" value="035 Opstellen en verstrekken (M)JOB"/>
            <property key="Procesmodel" value="Ja"/>
          </element>
          <element xsi:type="archimate:BusinessProcess" name="Inkopen planmatig onderhoud" id="c3b17299-3176-4837-b732-c53016570eb7">
            <documentation>Inkopen planmatig onderhoud is het werkproces waarmee de door de VvE vastgestelde planmatig onderhoudswerkzaamheden worden aanbesteed..</documentation>
            <property key="CORA-concepttype" value="Werkproces"/>
            <property key="Type proces" value="Primair"/>
            <property key="Bron" value="CORA 4.0"/>
            <property key="View" value="035 Inkopen planmatig onderhoud"/>
            <property key="Procesmodel" value="Ja"/>
          </element>

        <property key="CORA-concepttype" value="Bedrijfsobjecten-domein"/>
        <property key="Domein" value="Handelsregister"/>
      </element>
      <element xsi:type="archimate:Grouping" name="Adres (BAG)" id="id-178113c6c09247baa9d2fcdc4d42a19f">
        <property key="Bron" value="Digitale Overheid"/>
        <property key="CORA-concepttype" value="Bedrijfsobjecten-domein"/>
        <property key="Domein" value="Adres"/>
      </element>
      <element xsi:type="archimate:Grouping" name="Overeenkomsten" id="45c63290-64f9-47c1-81a2-85d1a377e164">
        <documentation>Een overeenkomst is de vastlegging van afspraken tussen minimaal twee partijen, waaronder de woningcorporatie en minimaal één relatie, over een bepaalde dienst, product of service waarin de rechten en plichten geregeld zijn.</documentation>
        <property key="Bron" value="CORA 1.0"/>
        <property key="CORA-concepttype" value="Bedrijfsobjecten-domein"/>
        <property key="Domein" value="Overeenkomsten"/>
      </element>
      <element xsi:type="archimate:Grouping" name="Energieprestatie" id="66253113-9aa7-4547-a517-4f752851971a">
        <property key="Bron" value="Stroomversnelling"/>
        <property key="CORA-concepttype" value="Bedrijfsobjecten-domein"/>
        <property key="Domein" value="Energieprestatie"/>
      </element>
      <element xsi:type="archimate:Grouping" name="Relaties" id="970766e5-a1e8-4c3a-92f4-031fe5ca3812">
        <documentation>Een relatie is een persoon of groep van personen die in het verleden, heden of in de toekomst een betrekking heeft of iets van doen heeft met de woningcorporatie. Synoniem voor een relatie: een stakeholder.&#xD;
</documentation>
        <property key="Bron" value="CORA 1.0"/>
        <property key="CORA-concepttype" value="Bedrijfsobjecten-domein"/>
        <property key="Domein" value="Relaties"/>
      </element>
      <element xsi:type="archimate:Grouping" name="Inkomen (BRI)" id="id-ed2a1e6b432d4ad0998b757650eeb302">

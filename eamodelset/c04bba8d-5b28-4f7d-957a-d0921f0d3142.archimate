      <folder name="001 Bepalen missie" id="id-3cf05fc83e2041248630cdc9b06eef76"/>
      <folder name="007 Opstellen/actualiseren sociaal beheerplan" id="id-109f6675e30d4bf4bee6fb2a18368a74"/>
    </folder>
    <folder name="CORA sjablonen" id="886966d5-1fe5-47af-9a64-c81cd7761ab0">
      <folder name="CORA proces sjabloon" id="4d33d376-e2fb-4aad-92b3-0ab52a74100c">
        <element xsi:type="archimate:Assessment" name="Risico (werkprocesniveau)" id="4c343c29-f7e2-4d49-ab8d-402bd46f225a">

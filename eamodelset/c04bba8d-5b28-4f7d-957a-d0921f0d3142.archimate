            <documentation>Dit betreft het plan waarin per administratieve eenheid wordt bepaald hoe betreffende eenheid geexploiteerd wordt en welke doelgroep van beleid daarmee bediend dient te worden.</documentation>
            <property key="CORA-concepttype" value="Bedrijfsservice"/>
            <property key="Toelichting" value="Output werkproces"/>
            <property key="Bron" value="CORA 4.0"/>

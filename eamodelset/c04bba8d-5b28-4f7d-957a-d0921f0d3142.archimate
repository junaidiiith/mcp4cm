&#xD;
Input: Behoefte bewonersbegeleiding bepaald&#xD;
Output: Dagopvangruimte geregeld</documentation>
            <property key="CORA-concepttype" value="Processtap"/>
            <property key="Bron" value="CORA 4.1"/>

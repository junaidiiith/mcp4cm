          </element>
          <element xsi:type="archimate:BusinessProcess" name="Verkrijgen prestatieverklaringen/realisatieverslagen" id="id-dc3a8d01583f44fc89c2a28449eae65e">
            <property key="CORA-concepttype" value="Processtap"/>

            <property key="Type proces" value="Sturend"/>
            <property key="Procesmodel" value="Ja"/>
            <property key="Vastgoedsturing" value="Ja"/>
          </element>
          <element xsi:type="archimate:BusinessProcess" name="Evalueren performance complexen" id="id-04ded790a11e4e8f8f4c0f3f14ff9bd1">
            <property key="CORA-concepttype" value="Werkproces"/>
            <property key="Bron" value="CORA 4.3"/>
            <property key="View" value="Werkproces nog niet beschikbaar         "/>
            <property key="Vastgoedsturing" value="Ja"/>
          </element>
          <element xsi:type="archimate:BusinessService" name="Bevindingen performance vastgoedcluster(s)" id="id-65f682b16d504c54ab8d5a4ceb01f859">
            <property key="Bron" value="CORA 4.3"/>

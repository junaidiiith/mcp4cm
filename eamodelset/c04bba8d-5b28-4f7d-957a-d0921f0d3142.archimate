            <property key="Stroomversnelling" value="Ja"/>
            <property key="Toelichting Stroomversnelling" value="In geval van nieuwe duurzame installaties is het sterk aan te raden die in showroom te laten zien"/>
          </element>
          <element xsi:type="archimate:BusinessService" name="Gemanagde relatie bewoners" id="id-bf8fd2bb9c684b8c85cd5db21ab3b2c9">

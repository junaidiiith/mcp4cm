            <property key="View" value="028/029 Splitsen vastgoed"/>
            <property key="Procesmodel" value="Ja"/>
          </element>
          <element xsi:type="archimate:BusinessProcess" name="Verwerken bezwaren splitsingsvergunning" id="id-fd19705c19254c89a0671a7b988fbf3c">
            <property key="CORA-concepttype" value="Processtap"/>
            <property key="Bron" value="CORA 4.1"/>
            <property key="(Her)ontwikkeling eenheden" value="Ja"/>
            <property key="Splitsen vastgoed" value="Ja"/>
          </element>
          <element xsi:type="archimate:BusinessService" name="Opgerichte VvE" id="id-c30747ff56554f4398e1cb2e9669c0ba">
            <property key="CORA-concepttype" value="Bedrijfsservice"/>
            <property key="Bron" value="CORA 4.1"/>
            <property key="Toelichting" value="Output werkproces"/>
            <property key="(Her)ontwikkeling eenheden" value="Ja"/>
            <property key="Splitsen vastgoed" value="Ja"/>
          </element>
          <element xsi:type="archimate:BusinessEvent" name="Gesplitst vastgoed" id="id-e6cc4445d7d7432aa4bfa6be78f9e50d"/>
          <element xsi:type="archimate:BusinessEvent" name="Opdracht Splitsen vastgoed verstrekt" id="id-f5555ba49ead486d8e4017994e2f27d0">
            <property key="CORA-concepttype" value="Gebeurtenis"/>

            <property key="P&amp;D model" value="Ja"/>
            <property key="Besturingshorizon" value="3 tot 5 jaar"/>
            <property key="Te actualiseren" value="Iedere 3 tot 5 jaar"/>
            <property key="Vastgoedsturing" value="Ja"/>
          </element>
        </folder>

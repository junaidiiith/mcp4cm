            <property key="Bron" value="CORA 4.0"/>
          </element>
          <element xsi:type="archimate:BusinessProcess" name="Behandelen urgentieaanvraag" id="9b2bd06b-ea8a-4927-8eea-dcb348b43fd8">
            <documentation>Behandelen urgentieaanvraag is het werkproces waarmee de (samenwerkende)  woningcorporatie(s) respectievelijk (samenwerkende) gemeente(s) de aanvraag van een woningzoekende, registreert en en toetst aan de vigerende wet- en regelreging</documentation>
            <property key="CORA-concepttype" value="Werkproces"/>

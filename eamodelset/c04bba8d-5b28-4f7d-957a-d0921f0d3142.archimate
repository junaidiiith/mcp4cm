          <element xsi:type="archimate:BusinessProcess" name="Opdracht informeren bewoners" id="id-1b16a7bb4cbf4c89a665790ce82144d5">
            <property key="CORA-concepttype" value="Processtap"/>
            <property key="Bron" value="CORA 4.1"/>
            <property key="(Her)ontwikkeling eenheden" value="Ja"/>
            <property key="Stroomversnelling" value="Ja"/>
            <property key="Toelichting Stroomversnelling" value="Indien het gaat om het 1e exploitatiejaar van een NOM-woning: Houdt er rekening mee dat bij een NOM-woning de energievoorschoten ver af kunnen wijken van de daadwerkelijke afname van energie (die ligt veel lager). Over een kalenderjaar is een energiebundel vastgesteld, als de huurder hier binnenblijft zijn de energiekosten nul of krijgt de huurder zelfs geld terug via de salderingsregeling. Soms moet de huurder in het 1e jaar naast EPV ook nog het voorschot aan de energieleverancier betalen."/>
          </element>

          <element xsi:type="archimate:BusinessProcess" name="Bepalen missie" id="0c928197-9f6c-4420-8555-8a5e8fb1c0f2">
            <documentation>Bepalen missie is het bedrijfsproces waarbij de organisatie bepaald wat zij voor de buitenwereld wil betekenen en hoe zij dat wil realiseren</documentation>
            <property key="CORA-concepttype" value="Bedrijfsproces"/>
            <property key="Bron" value="CORA 4.0"/>

          <element xsi:type="archimate:BusinessProcess" name="Aankopen eenheden" id="96613fdb-9368-4941-a4e4-bf23cf83e3d5">
            <documentation>Aankopen eenheden is het bedrijfsproces waarmee woningcorporaties vastgoedproposities kopen (en verkopen incdenteel) om de vastgoedportefeuille aan te vullen (of gedeeltelijk af te stoten) met als doel om het vastgoed zelf te gaan exploiteren (of gedeeltelijk te verkopen aan andere woningcorporaties, of institutionele beleggers inclusief de exploitatie en daaruitvoortkomende rechten en plichten).</documentation>
            <property key="CORA-concepttype" value="Bedrijfsproces"/>
            <property key="Bron" value="CORA 3.1"/>
            <property key="Type proces" value="Primair"/>
            <property key="View" value="040 Aankopen eenheden"/>
            <property key="Procesmodel" value="Ja"/>
          </element>

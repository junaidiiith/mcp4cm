            <property key="Wederverkoop" value="Ja"/>
          </element>
          <element xsi:type="archimate:BusinessEvent" name="Nieuw energielabel afgemeld" id="id-e4fd3543a08b437fbd08248bdd4aeb8d">
            <property key="CORA-concepttype" value="Gebeurtenis"/>
            <property key="Toelichting" value="Trigger werkproces"/>
            <property key="Bron" value="CORA 4.2"/>
          </element>
          <element xsi:type="archimate:BusinessProcess" name="Valideren kenmerken eenheid tbv nieuw label" id="id-7815a9748b954a079e174b7d6dc6efd2">

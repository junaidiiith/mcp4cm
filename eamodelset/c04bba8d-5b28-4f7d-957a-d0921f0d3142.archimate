            <property key="Vastgoedsturing" value="Ja"/>
          </element>
          <element xsi:type="archimate:BusinessProcess" name="Bepalen voorkeurscenario clusterniveau" id="id-6c5d3bfab820403581fbeaf90d6839c0">
            <property key="CORA-concepttype" value="Processtap"/>
            <property key="Bron" value="CORA 4.3"/>
            <property key="Vastgoedsturing" value="Ja"/>
          </element>
          <element xsi:type="archimate:BusinessService" name="Beleidssimulatie ex ante vastgoedbeheer- en investeringsplannen" id="id-d1ab57b4c4704128a1bcc4b7a90194ee">
            <documentation>Dit is de verzameling scenario's waarin de balans tussen doelstellingen van de woningcorporatie het voorgenomen beleid en de beoogde vastgoedportefeuilleplannen voor komende periode zijn doorvertaald naar de afzonderlijke deelgebieden/complexen/vastgoedclusters en waaruit een voorkeursvariant naar voren komt.</documentation>
            <property key="CORA-concepttype" value="Bedrijfsservice"/>
            <property key="Bron" value="CORA 4.3"/>
            <property key="Toelichting" value="Output werkproces"/>

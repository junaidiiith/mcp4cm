          <element xsi:type="archimate:BusinessProcess" name="Leveren huismeesterdienst" id="id-0752610e972c4976ad97ac03d06f0996">
            <documentation>Nog uit te werken</documentation>
            <property key="Bron" value="CORA 4.1"/>
            <property key="CORA-concepttype" value="Werkproces"/>
            <property key="Servicekosten" value="Ja"/>
            <property key="Type proces" value="Primair"/>
            <property key="View" value="023 Leveren huismeesterdienst"/>

          </element>
          <element xsi:type="archimate:BusinessProcess" name="Uitvoeren financiele bewaking realisatie" id="id-893ff96ae5324c14ab04cc1a9f6e304c">
            <property key="CORA-concepttype" value="Processtap"/>
            <property key="Bron" value="CORA 4.1"/>

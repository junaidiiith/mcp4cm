        <folder name="001a Bepalen missie" id="af412699-0003-4e1f-b9dd-bcdf41f268b5">
          <element xsi:type="archimate:BusinessProcess" name="Opstellen en vaststellen missie" id="66b94770-a73a-41bb-b888-fe71da1a93bc">

          <element xsi:type="archimate:BusinessEvent" name="Interne drijfveren" id="id-3b7de8d49a184eedac336646c3ebeba2">
            <documentation>Bijvoorbeeld huidige periode ondernemingsstrategie loopt af en/of nieuwe bestuur/management</documentation>
            <property key="CORA-concepttype" value="Gebeurtenis"/>

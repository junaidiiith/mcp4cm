          <element xsi:type="archimate:BusinessService" name="Missie-statement" id="id-291921c0b0284a8bb012856b09df819d">
            <property key="CORA-concepttype" value="Bedrijfsservice"/>
            <property key="Bron" value="CORA 4.3"/>
            <property key="Toelichting" value="Output werkproces"/>
            <property key="Vastgoedsturing" value="Ja"/>
          </element>
          <element xsi:type="archimate:BusinessService" name="Missie" id="a901d0fa-1cfe-44cb-ac62-6148b6854d1f">
            <documentation>Het statement van de organisatie dat beschrijft wat de organisatie voor de buitenwereld wenst te betekenen en hoe de organisatie dat wenst te realiseren</documentation>

            <property key="(Her)ontwikkeling eenheden" value="Ja"/>
            <property key="Wederverkoop" value="Ja"/>
          </element>
          <element xsi:type="archimate:BusinessProcess" name="Controleren voorraad c.q. bestellen materialen" id="id-0080392d1a784f6b97e1e6a7ec09716e">
            <documentation>Controleer de voorraad van het materiaal dat benodigd is voor het uitvoeren van de onderhoudsorder. Bestel wat niet op voorraad is. Dit kan gaan om materiaal in het eigen magazijn, de busvoorraad of om specialistisch materiaal dat niet standaard op voorraad is. (Het op peil houden van de bus- of magazijnvoorraad is een separaat proces dat hier niet is uitgewerkt).&#xD;
&#xD;
Input: Opdracht onderhoudsorder&#xD;
Output: Besteld materiaal</documentation>
            <property key="CORA-concepttype" value="Processtap"/>
            <property key="Bron" value="CORA 4.1"/>
            <property key="Planmatig onderhoud" value="Ja"/>
            <property key="Verhuurmutatie" value="Ja"/>
            <property key="Reparatieonderhoud" value="Ja"/>
            <property key="Aedes processenboek" value="Ja"/>

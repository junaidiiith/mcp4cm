          <element xsi:type="archimate:BusinessService" name="Control" id="ffd80c67-2d2b-4c67-9f78-e932b830c702">
            <documentation>Door periodiek te rapporteren over de eigen prestaties kan de woningcorporatie beoordelen of zij in control is en blijft.</documentation>
            <property key="CORA-concepttype" value="Dienst"/>
            <property key="Bron" value="CORA 4.0"/>

        <property key="Domein" value="Waarde Onroerende Zaken"/>
      </element>
      <element xsi:type="archimate:Grouping" name="Publicaties" id="id-a6166a05ab384e65851175aff300ea18">
        <documentation>Publicaties zijn informatieitems die met een specifiek doel wereldkundig worden gemaakt m</documentation>
        <property key="CORA-concepttype" value="Bedrijfsobjecten-domein"/>
        <property key="Bron" value="CORA 4.2"/>
        <property key="Domein" value="Publicaties"/>
      </element>
      <element xsi:type="archimate:Grouping" name="Handelsregister (HR)" id="id-6102aa15046d421ebfa332ef88ef1f2a">

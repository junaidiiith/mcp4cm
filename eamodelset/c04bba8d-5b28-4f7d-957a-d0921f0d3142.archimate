            <property key="Aedes processenboek" value="Ja"/>
          </element>
          <element xsi:type="archimate:BusinessService" name="Sociale begeleiding" id="edab3fe1-f0c3-4092-bdc4-a34f7daf8b10">
            <property key="CORA-concepttype" value="Bedrijfsservice"/>
            <property key="Toelichting" value="Output werkproces"/>
            <property key="Bron" value="CORA 4.0"/>
          </element>
          <element xsi:type="archimate:BusinessEvent" name="Sociaal beheerplan" id="e9a81769-e335-4466-9fb5-d1e17e0e2ea2">

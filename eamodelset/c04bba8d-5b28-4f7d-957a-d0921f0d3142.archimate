        <folder name="009 Opstellen/actualiseren bedrijfsvoeringsplan" id="eb37d03d-bc5d-440a-a802-ad10467bc699">
          <element xsi:type="archimate:BusinessService" name="Organisatie-inrichtingsplan" id="e9c8860f-4574-4b44-8e0b-74141c175666">
            <property key="CORA-concepttype" value="Bedrijfsservice"/>

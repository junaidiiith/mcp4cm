&#xD;
Formule: A/B * 100%&#xD;
</documentation>
          <property key="Bron" value="CORA 3.0"/>
          <property key="CORA-concepttype" value="Proces-indicator"/>
          <property key="Wederverkoop" value="Ja"/>

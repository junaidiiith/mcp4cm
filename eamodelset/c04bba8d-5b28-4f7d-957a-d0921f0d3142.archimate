          <child xsi:type="archimate:Note" id="id-596d3b8421d54430b94c8b1d11555c0d" font="1|Segoe UI|9.857142|1|WINDOWS|1|-23|0|0|0|700|0|0|0|0|3|2|1|34|Segoe UI" fontColor="#ffffff" fillColor="#7d903d" alpha="0" borderType="2">

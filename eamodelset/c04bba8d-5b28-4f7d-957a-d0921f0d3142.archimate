        <folder name="072 Inspecteren vastgoed" id="5e130964-d9a9-47e2-8eb5-9fd8e30c28c0">
          <element xsi:type="archimate:BusinessProcess" name="Beoordelen woning of alles conform afspraak wordt opgeleverd" id="id-97483c88678a4f5c9c899219de04112a">
            <property key="Bron" value="CORA 4.1"/>
            <property key="CORA-concepttype" value="Processtap"/>
            <property key="Wederverkoop" value="Ja"/>
          </element>
          <element xsi:type="archimate:BusinessProcess" name="Voorbereiden opnamerapport EPA" id="id-72149ad50d8a44ef8b7ff592bd8e31fc">

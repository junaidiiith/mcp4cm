          <element xsi:type="archimate:BusinessProcess" name="Aanmaken zaak stickeractie" id="id-051ad20729ec4a069158fe3e319b182e">
            <documentation>Suptype:&#xD;
- Spullen algemene ruimten</documentation>
          </element>
          <element xsi:type="archimate:BusinessProcess" name="Behandelen zaak overlast" id="id-e6baa76eac434d50b6dec71cf08e261f">
            <documentation>Mijlpalen:&#xD;
- Aanpak gekozen en teruggekoppeld aan betrokkenen&#xD;
- Aanpak overlast gereed&#xD;
- Juridische procedure afgehandeld&#xD;
- Zaak afgerond</documentation>
          </element>
          <element xsi:type="archimate:BusinessProcess" name="Behandeling wijzigingsverzoek servicecomponent in VVE complex_initiatief Woonstad/huurders" id="id-b14dc800fb4446b4a776b8eaf09469ad"/>
          <element xsi:type="archimate:BusinessProcess" name="Beëindigen zaak Schotelantenne - juridische procedure" id="id-78379a7b0a7a45a8abe5fa5723ff14d3"/>
          <element xsi:type="archimate:BusinessProcess" name="Beëindigen zaak woonfraude" id="id-f8f9b39503894c558e73f0c37dd5a81b"/>
          <element xsi:type="archimate:BusinessEvent" name="Besluit tot ontruiming" id="id-6f009ea2bc4841c5abb5a65a9d4479ac"/>
          <element xsi:type="archimate:BusinessProcess" name="Handhaving beleid schotelantennes - huurders" id="id-cab147fafc344853a321750b1da4cf73"/>
          <element xsi:type="archimate:BusinessProcess" name="Beëindigen zaak Schotelantenne - aanpak" id="id-7d77fdbeaabd4bbf941cf7800e401dd4"/>
          <element xsi:type="archimate:BusinessProcess" name="Behandelen zaak woonfraude" id="id-960628c63f7d48989d435d77b345041d">
            <documentation>mijlpalen:&#xD;
- woonfraude onderzocht&#xD;
- uitkomst aan betrokkene gecommuniceerd&#xD;
- gecontroleerd of afspraken zijn nagekomen&#xD;
- juridische procedure afgehandeld (verplaats naar apart zaaktype?)</documentation>
          </element>
          <element xsi:type="archimate:BusinessProcess" name="Afhandelen woonfraude huurder" id="id-124f1bed44b74223848ed32a45c00874"/>
          <element xsi:type="archimate:BusinessProcess" name="Uitvoeren welkomstgesprek" id="id-f8a3bfa21ed74ab5991fdc780901dae7"/>
          <element xsi:type="archimate:BusinessProcess" name="Aanmaken zaak overlast" id="id-5aa69ed543514115bd12262984cf9c97">
            <documentation>Subtype:&#xD;
- Agressie/bedreiging&#xD;
- Burenruzie&#xD;
- Geluidsoverlast&#xD;
- Illegaal aangebrachte bouwkundige voorzieningen&#xD;
- Onderhoud balkon&#xD;
- Onderhoud privétuin&#xD;
- Oneigenlijk gebruik algemene ruimte&#xD;
- Ongedierte&#xD;
- Overlast door bedrijfsinstelling&#xD;
- Parkeeroverlast&#xD;
- Stankoverlast&#xD;
- Tuin (privé)&#xD;
- Vandalisme&#xD;
- Vervuiling&#xD;
- Vervuiling woning&#xD;
- Zorg (verward gedrag/vereenzaming/vervuiling)&#xD;
- Zorgcliënt&#xD;
</documentation>
          </element>
          <element xsi:type="archimate:BusinessEvent" name="Overlastmelding afgehandeld" id="id-09bbff1f6f6e4c8f8f4d55ec482dec2c"/>
          <element xsi:type="archimate:BusinessProcess" name="Uitvoeren schoonmaak" id="id-c2c736f8608c4ba4a5fcb3a5e251b197"/>
          <element xsi:type="archimate:BusinessProcess" name="Aanmaken zaak kosten Juridische procedure" id="id-5162e11c9d2e434fa47554bb09a7f483"/>
          <element xsi:type="archimate:BusinessProcess" name="Beëindigen zaak  hoger beroep" id="id-77eaea79459543da9d7f0205621b60fa"/>
          <element xsi:type="archimate:BusinessProcess" name="&lt;&lt;Bijwonen VvE vergadering>> Bijwonen VvE vergadering" id="id-17793827edcf4395850d5fd3b855b037">
            <documentation>Bijwonen VvE vergadering is het werkproces waarmee de woningcorporatie - tevens VvElid - actief deelneemt aan de VvE vergadering en daardoor ook de belangen behartigt van de huurder in de VvE vergadering</documentation>
            <property key="CORA-concepttype" value="Werkproces"/>
            <property key="Type proces" value="Primair"/>
            <property key="Bron" value="CORA 4.0"/>
          </element>
          <element xsi:type="archimate:BusinessProcess" name="Behandelen zaak kort geding/bodemprocedure" id="id-3d2d7de49c804ec7a6658b46bb74278c">
            <documentation>Mijlpalen:&#xD;
- Dagvaarding verstuurd&#xD;
- Voortzetting procedure bepaald&#xD;
- Rechtzitting afgerond&#xD;
- Vervolg uitspraak bepaald</documentation>
          </element>
          <element xsi:type="archimate:BusinessProcess" name="Beheersen van plaagdieren" id="id-6287d4a8b3dd4ebfb90b7f28d5ecdd03"/>
          <element xsi:type="archimate:BusinessProcess" name="Beëindigen zaak privétuin/balkon" id="id-6a2173d73f10425185bb4393fd9cf0f5"/>
          <element xsi:type="archimate:BusinessProcess" name="Aanmaken zaak geluidsoverlast" id="id-92fcba7de16d49b6b679ae6aaf85559f"/>
          <element xsi:type="archimate:BusinessProcess" name="Beëindigen zaak kosten Juridische procedure" id="id-43922c7011784fd2bae92042246b2b71"/>
          <element xsi:type="archimate:BusinessProcess" name="Aanpakken goederen in algemene ruimten (stickeractie)" id="id-4484008b16a140b392543c0d2a9e8e4a"/>
          <element xsi:type="archimate:BusinessProcess" name="Behandelen zaak Schotelantenne - juridische procedure" id="id-f1fdba703a3f4f948272d12164375f12">
            <documentation>Mijlpalen&#xD;
- Dossier aan advocaat&#xD;
- Vonnis ontvangen/schikking getroffen&#xD;
- Vonnis uitgevoerd/schikking afgesloten</documentation>
          </element>
          <element xsi:type="archimate:BusinessEvent" name="Eenheid verhuurd" id="id-0bab9418822a463cbfa8621088074c7a"/>
          <element xsi:type="archimate:BusinessProcess" name="Aanmaken zaak Schotelantenne - juridische procedure" id="id-5ebe0a123cc646f698651c0da5456f81"/>
          <element xsi:type="archimate:BusinessProcess" name="&lt;&lt;Faciliteren bewonersparticipatie>> Faciliteren bewonersparticipatie" id="id-9f176868fdb44220a995831cfffe8916">
            <documentation>Faciliteren bewonersparticipatie is het werkproces waarmee middelen beschikbaarworden gesteld/ingezet worden om de bewoners actief te betrekken bij het beheer van het woongebouw en de woonomgeving.</documentation>
            <property key="CORA-concepttype" value="Werkproces"/>
            <property key="Type proces" value="Primair"/>
            <property key="Bron" value="CORA 4.0"/>
          </element>
          <element xsi:type="archimate:BusinessProcess" name="Behandelen zaak Schotelantenne - aanpak" id="id-c9dbc6d48552433ca8dc864b9a2540b9">
            <documentation>Mijlpalen:&#xD;
- Klanten geïnformeerd over voorwaarden&#xD;
- Herinnering verstuurd&#xD;
- Beschikbare schotel verwijderd&#xD;
- Complexaanpak afgerond</documentation>
          </element>
          <element xsi:type="archimate:BusinessEvent" name="Overlastmelding" id="id-3ac84db378e340aba5dc1125f3d291e5">
            <documentation>suptypes:&#xD;
- Geluid&#xD;
- Privétuin/balkon</documentation>
          </element>
          <element xsi:type="archimate:BusinessProcess" name="&lt;&lt;Vaststellen servicecomponenten>> Vaststellen servicecomponenten" id="id-cd75831273764a9287a09c389d1ee0be">
            <property key="CORA-concepttype" value="Bedrijfsproces"/>
            <property key="Bron" value="CORA 4.1"/>
            <property key="Type proces" value="Primair"/>
          </element>
          <element xsi:type="archimate:BusinessProcess" name="Afhandelen geluidsoverlast" id="id-cfb7cfd163be48feb8f3d64b2d688083"/>
          <element xsi:type="archimate:BusinessProcess" name="Zaaktype Juridische procedure" id="id-0ad2d9b1a6004732b18cde6854de7aff">
            <documentation>3 processen:&#xD;
- opstarten en afhandelen juridische procesdure&#xD;
- uitvoeren hoger beroep&#xD;
- verwerken kosten juridische procedure</documentation>
          </element>
          <element xsi:type="archimate:BusinessProcess" name="Behandelen zaak geluidsoverlast" id="id-4942b2bfa99246a481560da4f5ab1eb8">
            <documentation>Mijpalen:&#xD;
- Overlastmelding beoordeeld&#xD;
- Vervolg met melder besproken&#xD;
- Overlast door externe partij behandeld&#xD;
- Overlast door sociaal beheer behandeld&#xD;
- Aanhoudende overlast behandeld&#xD;
- Overlastdagboek met NPO/VvE_vertegenwoordiging beoordeeld&#xD;
- Melder en/of veroorzaker geïnformeerd m.b.t. onderzoek&#xD;
- Onderzoek uitgevoerd melder en/of veroorzaker&#xD;
- Resultaat onderzoek beoordeeld en besproken&#xD;
- Vervolg bepaald en afgerond&#xD;
- Opdracht verbeteringen uitgezet&#xD;
- Werkzaamheden woning(en) uitgevoerd&#xD;
- Volledig dossier beoordeeld&#xD;
- Akkoord overdracht teamleider&#xD;
- Dossier overgedragen aan advocaat met opdracht&#xD;
- Controle uitgevoerd afspraak met huurder&#xD;
- Dagvaarding door advocaat opgesteld&#xD;
- Akkoord dagvaarding gegeven&#xD;
- Melder geïnformeerd m.b.t. resultaat&#xD;
- Melder nazorg geboden&#xD;
- Zaak afgerond&#xD;
</documentation>
          </element>
          <element xsi:type="archimate:BusinessProcess" name="Aanmaken zaak Schotelantenne - aanvraag" id="id-10b5578a3eab420e9b7fc1afebd12c3a"/>
          <element xsi:type="archimate:BusinessProcess" name="Beheren camerasystemen" id="id-3e866cbe2b854ebcbce1b04d94294500"/>
          <element xsi:type="archimate:BusinessEvent" name="Melding mogelijke woonfraude" id="id-9d09b7a714ae42aaa4e1235f032c9ff8"/>
          <element xsi:type="archimate:BusinessProcess" name="Communicatie en herhuisvesting bij funderingsherstel" id="id-0942bfe254ab4028b18ed3524bd74b4f"/>
          <element xsi:type="archimate:BusinessProcess" name="Beëindigen zaak Schotelantenne - aanvraag" id="id-39fe85ba6ac7485097db6d4888b3b7f8"/>
          <element xsi:type="archimate:BusinessProcess" name="Beëindigen zaak kosten Ontbinden en ontruimen" id="id-e2bd226b042f4f89b5ce3f6a71aa71d5"/>
          <element xsi:type="archimate:BusinessProcess" name="Behandelen zaak  hoger beroep" id="id-73bc872c56094a9796c8ef2329beecc2">
            <documentation>Mijlpalen:&#xD;
- Dagvaarding verstuurd&#xD;
- Vervolg procedure bepaald&#xD;
- Hoger beroep afgerond&#xD;
- Vervolg arrest bepaald&#xD;
- In cassatie gegaan&#xD;
- Uitspraak Hoge Raad vastgelegd</documentation>
          </element>
          <element xsi:type="archimate:BusinessProcess" name="&lt;&lt;Informeren huurder(s) VvEcomplex>> Informeren huurder(s) VvEcomplex" id="id-86c5e4c6f13344dd89fa2c5d35bd769d">
            <documentation>Informeren huurder(s) VvEcomplex is het werkproces waarmee de huurder(s) door de woningcorporatie - tevens VvElid - op de hoogte wordt gehouden van (voor)genomen besluiten van de VvE</documentation>
            <property key="CORA-concepttype" value="Werkproces"/>
            <property key="Type proces" value="Primair"/>
            <property key="BIM" value="Ja"/>
            <property key="Bron" value="CORA 4.0"/>
          </element>
          <element xsi:type="archimate:BusinessEvent" name="Kandidaat is nieuwe huurder" id="id-b85793afa2dc444db5292f5af5f36deb"/>
          <element xsi:type="archimate:BusinessProcess" name="Behandelen zaak kosten Ontbinden en ontruimen" id="id-89028dc1609f42679e7667f6808b6df8">
            <documentation>Mijlpalen:&#xD;
- Ontruimingsprocedure afgerond&#xD;
- Uitspraak ten uitvoer gebracht</documentation>
          </element>
          <element xsi:type="archimate:BusinessProcess" name="Behandelen zaak sttickeractie" id="id-6e5e05c14d544cb381ba8bd354a05fdb">
            <documentation>Mijlpalen:&#xD;
- Beklaagde(n) geïnformeerd&#xD;
- Uitkomst stickeractie bekend&#xD;
- Goederenverwijderd/opgeslagen&#xD;
- Kosten in rekening gebracht&#xD;
- Goederen overgedragen&#xD;
- Zaak afgerond</documentation>
          </element>
          <element xsi:type="archimate:BusinessProcess" name="&lt;&lt;Opstellen voorstel servicecomponenten>> Opstellen voorstel servicecomponenten" id="id-1cb768e82ca34e848e116c04d33031d1">
            <property key="CORA-concepttype" value="Werkproces"/>
            <property key="Bron" value="CORA 4.1"/>
          </element>
          <element xsi:type="archimate:BusinessProcess" name="Aanmaken zaak hoger beroep" id="id-4796bfd2f2024bcfa3b4e231513dd680"/>

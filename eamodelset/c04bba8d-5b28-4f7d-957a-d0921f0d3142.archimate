            <property key="(Her)ontwikkeling eenheden" value="Ja"/>
            <property key="Stroomversnelling" value="Ja"/>
            <property key="Toelichting Stroomversnelling" value="Indien het gaat om het 1e exploitatiejaar van een NOM-woning: informeer de energieleveranciers dat het een NOM-woning is, zodat ze afwijkende meterstanden (bijv. geen energiegebruik op jaarbasis) kunnen verklaren."/>
          </element>

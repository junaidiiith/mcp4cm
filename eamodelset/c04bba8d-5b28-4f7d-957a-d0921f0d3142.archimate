            <property key="Bron" value="CORA 4.1"/>
            <property key="Verhuurmutatie" value="Ja"/>
            <property key="Betreft" value="Referentieproces"/>
            <property key="Toelichting" value="De verzameling van verhuur- en mutatieonderhoudsprocessen  waarop de woningcorporatie integraal stuurt."/>
            <property key="Keten" value="Ja"/>
            <property key="Aedes processenboek" value="Ja"/>
            <property key="URL" value="https://cora.wikixl.nl/index.php/Verhuurmutatie"/>
          </element>
          <element xsi:type="archimate:BusinessService" name="Exclusief gebruiksrecht huureenheid" id="2f519974-e310-4b85-b6b6-6d83958a93c9">
            <documentation>Het exclusieve gebruiksrecht huureenheid aan huurders betreft de overeengekomen dienst waarbij (mede)huurder exclusief het gebruiksrecht heeft verkregen voor de overeengekomen periode van vastgoed dat in eigendom is van de woningcorporatie en waarbij de woningcorporatie zorg draagt voor het adequaat beheer en onderhoud van dit vastgoed.</documentation>
            <property key="CORA-concepttype" value="Dienst"/>
            <property key="Bron" value="CORA 4.0"/>
            <property key="Toelichting" value="Output bedrijfsproces"/>
            <property key="Planmatig onderhoud" value="Ja"/>
            <property key="Verhuurmutatie" value="Ja"/>
            <property key="(Her)ontwikkeling eenheden" value="Ja"/>
            <property key="P&amp;D model" value="Ja"/>
          </element>
          <element xsi:type="archimate:BusinessProcess" name="Verhuren eenheden" id="5dd033eb-842d-4b56-8463-73945cceacf8">
            <documentation>Verhuren eenheden is het bedrijfsproces waarmee aangaan en beëindigen van de huurovereenkomst met huurders wordt gerealiseerd inclusief het in rekening brengen van de netto huur</documentation>
            <property key="CORA-concepttype" value="Bedrijfsproces"/>
            <property key="Bron" value="CORA 2.0"/>
            <property key="Type proces" value="Primair"/>
            <property key="View" value="020 Verhuren eenheden"/>

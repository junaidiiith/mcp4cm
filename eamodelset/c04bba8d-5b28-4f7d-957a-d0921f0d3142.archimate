            <property key="Procesmodel" value="Ja"/>
          </element>
          <element xsi:type="archimate:BusinessProcess" name="Behandelen urgentie aanvragen woningzoekenden" id="ff8e45fd-3b3a-4961-bd6f-6c7292c068a2">
            <documentation>Behandelen urgentie aanvragen woningzoekenden is het bedrijfsproces waarmee aanvragen van woningzoekenden in behandeling worden genomen en worden afgehandeld</documentation>
            <property key="CORA-concepttype" value="Bedrijfsproces"/>

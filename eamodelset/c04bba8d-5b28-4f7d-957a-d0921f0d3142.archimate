          </element>
          <element xsi:type="archimate:BusinessService" name="Informatieplan" id="49dd0b7a-bba8-4084-92c8-543e172d4549">
            <property key="CORA-concepttype" value="Bedrijfsservice"/>
            <property key="Toelichting" value="Output werkproces"/>
            <property key="Bron" value="CORA 4.0"/>
          </element>
          <element xsi:type="archimate:BusinessService" name="Communicatieplan" id="6c20d374-39ef-435f-9860-94ad9779dc08">
            <property key="CORA-concepttype" value="Bedrijfsservice"/>
            <property key="Toelichting" value="Output werkproces"/>
            <property key="Bron" value="CORA 4.0"/>
          </element>
          <element xsi:type="archimate:BusinessService" name="Bedrijfsvoering plan" id="09eec077-bc1a-462a-861f-0bec14816180">
            <documentation>Het bedrijfsvoering plan betreft de verzameling van plannen hoe de organisatie ingericht wordt gelet op de realisatie van het leveren van de producten en diensten aan de externe klant, invulling geeft aan de communicatie, hoe idealiter met informatie omgegaan wordt door de organisatie en welke interne functies benodigd zijn om die producten en diensten aan de externe klant te kunnen leveren.</documentation>
            <property key="CORA-concepttype" value="Dienst"/>
            <property key="Bron" value="CORA 4.0"/>
            <property key="Toelichting" value="Output bedrijfsproces"/>
            <property key="P&amp;D model" value="Ja"/>
            <property key="Besturingshorizon" value="3 tot 5 jaar"/>
            <property key="Te actualiseren" value="Jaarlijks"/>
          </element>
          <element xsi:type="archimate:BusinessProcess" name="Opstellen informatieplan" id="859ba705-1189-4102-8d60-baee620a3ef7">
            <property key="CORA-concepttype" value="Werkproces"/>
            <property key="Type proces" value="Sturend"/>
            <property key="Bron" value="CORA 4.0"/>
            <property key="View" value="Werkproces nog niet beschikbaar"/>
            <property key="Procesmodel" value="Ja"/>
          </element>
          <element xsi:type="archimate:BusinessProcess" name="Opstellen personeelsplan" id="09fe46b6-4df6-417b-9c2b-96ee0e1edfde">
            <property key="CORA-concepttype" value="Werkproces"/>
            <property key="Type proces" value="Sturend"/>
            <property key="Bron" value="CORA 4.0"/>
            <property key="View" value="Werkproces nog niet beschikbaar"/>
            <property key="Procesmodel" value="Ja"/>
          </element>
          <element xsi:type="archimate:BusinessProcess" name="Opstellen communicatieplan" id="f84d25f4-98a5-4933-9a61-14d8b1fedc66">
            <property key="CORA-concepttype" value="Werkproces"/>
            <property key="Type proces" value="Sturend"/>
            <property key="Bron" value="CORA 4.0"/>
            <property key="View" value="Werkproces nog niet beschikbaar"/>
            <property key="Procesmodel" value="Ja"/>
          </element>
          <element xsi:type="archimate:BusinessService" name="Personeelsplan" id="7e7eebcb-06d3-49fc-a302-0702dae9b919">
            <property key="CORA-concepttype" value="Bedrijfsservice"/>
            <property key="Toelichting" value="Output werkproces"/>
            <property key="Bron" value="CORA 4.0"/>
          </element>
          <element xsi:type="archimate:BusinessProcess" name="Opstellen organisatie-inrichtingsplan" id="d03ae6c0-348b-46dd-84ff-63d8cbc14a85">
            <property key="CORA-concepttype" value="Werkproces"/>

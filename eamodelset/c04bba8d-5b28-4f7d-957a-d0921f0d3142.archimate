          </element>
          <element xsi:type="archimate:BusinessProcess" name="Opstellen/actualiseren bedrijfsvoeringsplan" id="7950d429-1cb8-443c-8ebf-cd2b863a44b7">
            <documentation>Opstellen/actualiseren bedrijfsvoeringsplan is het bedrijfsproces waarmee ...</documentation>
            <property key="CORA-concepttype" value="Bedrijfsproces"/>
            <property key="Bron" value="CORA 4.0"/>
            <property key="Type proces" value="Sturend"/>

              <documentation>Request a service under the Building Administrative Plan</documentation>
            </element>
            <element xsi:type="archimate:BusinessInterface" name="terminateBuildingAdministrativePlan" id="341543c5-035d-4e88-9aab-e1c8da85fcae">

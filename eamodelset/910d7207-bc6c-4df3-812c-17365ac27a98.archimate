      <element xsi:type="archimate:BusinessObject" name="=ServiceProvider" id="b70c2d47-a833-45cd-b1a6-7219b227b93a"/>
      <element xsi:type="archimate:BusinessObject" name="=ServicingEvent" id="3e004e11-ff7a-405d-b0d1-e4eaf864685e"/>
      <element xsi:type="archimate:BusinessObject" name="=ServicingIssue" id="832d0916-fb40-4cc1-aeee-05cc19bce53a"/>
      <element xsi:type="archimate:BusinessObject" name="=ServicingRootCause" id="c8ae3e39-0060-450b-9a2c-c764c6b918c5"/>
      <element xsi:type="archimate:BusinessObject" name="=SpecialPricingConditions" id="7458e879-1699-4a55-8ca1-d06edf830367"/>
      <element xsi:type="archimate:BusinessObject" name="=SubCustodian" id="6507c537-1ef3-43b7-810e-3ae410327bae"/>
      <element xsi:type="archimate:BusinessObject" name="=Suitability" id="aada3d31-a08d-41a7-8dd4-fde8b921ed32"/>
      <element xsi:type="archimate:BusinessObject" name="=Supplier" id="85a183a1-ad06-4a9b-9d01-535680d24cb4"/>
      <element xsi:type="archimate:BusinessObject" name="=Syndicate" id="16ca7fc3-0b6f-4937-9076-12c36ad138de"/>
      <element xsi:type="archimate:BusinessObject" name="=SyndicatedLoan" id="ca7e36c3-bb40-416e-a00b-0669104a88c4"/>
      <element xsi:type="archimate:BusinessObject" name="=TaxAdministration" id="a3650287-466c-414b-9c66-cd683481308a"/>
      <element xsi:type="archimate:BusinessObject" name="=TechnologyStandards" id="ad1100ae-afec-4425-8caa-1eb7451affd2"/>
      <element xsi:type="archimate:BusinessObject" name="=TradeFinance" id="b7bdc82d-4432-46d6-afbc-82854ee396f9"/>
      <element xsi:type="archimate:BusinessObject" name="=TradeMatching" id="a6f2d29b-5d44-4a2b-af7f-60e6ff96069d"/>
      <element xsi:type="archimate:BusinessObject" name="=TradedPosition" id="a59cb707-0992-4b69-93ca-de57759c6165"/>
      <element xsi:type="archimate:BusinessObject" name="=TradingCreditPosition" id="4137a596-8eb1-4da8-8204-e44ac1ce28ac"/>
      <element xsi:type="archimate:BusinessObject" name="=TradingDesk" id="7ea6b247-0384-4f94-b934-1c2a15d261f1"/>
      <element xsi:type="archimate:BusinessObject" name="=TradingModel" id="34df5f46-4189-472f-8f1c-80139481c733"/>
      <element xsi:type="archimate:BusinessObject" name="=TradingPosition" id="225c639f-7281-4dca-bb03-e71265d6e2a9"/>
      <element xsi:type="archimate:BusinessObject" name="=TransactionSchedule" id="dc979700-fa34-4126-94ad-0561664113f0"/>
      <element xsi:type="archimate:BusinessObject" name="=TrustServices" id="e295a4a6-0c5f-4732-bd66-1b23849eed1d">
        <documentation>trust / кредит</documentation>
      </element>
      <element xsi:type="archimate:BusinessObject" name="=Underwriting" id="79b48f64-d7eb-4963-8053-7ea96272297e">
        <documentation>underwriting / Многоуровневая процедура оценки банком финансовой состоятельности претендента на кредит (гарантированное размещение или подписка)</documentation>
      </element>
      <element xsi:type="archimate:BusinessObject" name="=UnitTrust" id="c530eb93-8eb8-41c2-ade3-395624ae2318"/>
      <element xsi:type="archimate:BusinessObject" name="=Utilities" id="8331b4e4-afa5-4017-b4d4-bd66090d6fa4"/>
      <element xsi:type="archimate:BusinessObject" name="=VoiceChannel" id="5aed163a-5465-4103-a687-1a2986257181"/>
      <element xsi:type="archimate:BusinessObject" name="=eTradingWorkbench" id="eca79ccb-53a2-4d52-9a07-7ca2e72af452"/>
      <element xsi:type="archimate:BusinessObject" name="=interestRateGapRisk" id="09b5abf5-d1e6-4c40-bdd7-d19c29f6a4d1"/>
    </folder>
    <folder name="ISO20022" id="233adb3c-cab9-450d-9715-593914e99136">
      <folder name="BIAN Business Components" id="59677ddb-b8d7-42a5-b43a-fd0250d10e05">
        <element xsi:type="archimate:BusinessObject" name="AllocationSystem" id="cf637dc5-0a89-4891-999d-ad20e4646ef2">
          <documentation>An application -- usually an automated application -- that assists in allocating resources


Приложение-обычно автоматизированное приложение-которое помогает в распределении ресурсов</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name="BankLoan" id="c8cec77f-95de-465d-ae36-286efdbc5dbb">
          <documentation> A loan made by a bank that is not syndicated with other lenders

Note: The underwriter of a bank loan is the bank itself, so BankLoan does not have a property that designates the underwriter.

Кредит, выданный банком, который не синдицирован с другими кредиторами

Примечание: андеррайтером банковского кредита является сам банк, поэтому банковский кредит не имеет свойства, которое обозначает андеррайтера.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name="BusinessRegistry" id="379a5367-8588-4914-bf88-33d090207b51">
          <documentation>A registry whose entries represent businesses


Реестр записи которого представляют бизнес_</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name="BusinessRegistryEntry" id="60140c62-39ae-4241-997b-5677a97fc4e3">
          <documentation>An entry in a business registry


Запись в бизнес-реестре</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name="ConsumerLoan" id="ea7b1ff4-9251-4593-8a39-0fc5149fa6d3">
          <documentation> A loan made to a consumer (contrasts with a corporate loan)

Кредит, предоставленный потребителю (в отличие от корпоративного кредита)</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name="ConsumerLoanAgreement" id="1fd80c27-9067-41f4-be02-1b0374b5fdff">
          <documentation>An agreement that stipulates the obligations, rights, terms, and conditions of the parties to a loan

Соглашение, в котором оговариваются обязательства, права, сроки и условия сторон займа</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name="CorporateLoan" id="1e2bab01-aa91-47b1-8a2c-ec9256c016bb">
          <documentation> A loan made to a company or organization (contrasts with a consumer loan)

Кредит, выданный компании или организации (в отличие от потребительского кредита)</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name="CorrespondentBankPartyRole" id="13444ebb-a780-4f4b-beed-66631319ff4f">
          <documentation> A role played by a financial institution by which it acts on behalf of another financial institution


Роль финансового учреждения, которое действует от имени другого финансового учреждения</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name="CorrespondentBankRegistry" id="e33020fd-d45c-4b24-9bc7-7963240fd377">
          <documentation>A registry whose entries represent banks playing the role of a correspondent bank


Реестр, записи в котором представляют банки, играющие роль банка-корреспондента</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name="CorrespondentBankRegistryEntry" id="2581cf0d-bff0-4d9d-aaf3-f5e57c19dad8">
          <documentation>An entry in a correspondent bank registry

Запись в реестре банков-корреспондентов</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name="CustomerContactAuthentication" id="b8e62647-07f0-4f26-b7de-45a6578da747">
          <documentation>Authentication of the customer involved in a contact with a bank

Аутентификация клиента, участвующего в контакте с банком</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name="CustomerContactPartyRole" id="6c97bbd9-6f90-473d-bd7c-1db6540ed53a">
          <documentation>A role in which a person represents a customer in a relationship with a financial institution

Роль, в которой лицо представляет клиента в отношениях с финансовым учреждением</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name="CustomerContactSession" id="1369a19e-26f2-4d47-9819-695f06a4d729">
          <documentation> A session involving contact between a customer and a financial institution

Сеанс связи между клиентом и финансовым учреждением</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name="CustomerDialogueProcess" id="1fe6760c-0d09-45c3-9c18-e38d038a2fb5">
          <documentation>A management process governing the handling and structuring of dialogue with customers, including how to consolidate and present data and guidelines, provide standard dialogue/scripting, provoke questions when appropriate, and capture key data including relationship and sales triggers. 


Процесс управления, регулирующий обработку и структурирование диалога с клиентами, в том числе, как консолидировать и представить данные и руководящие принципы, обеспечить стандартный диалог/сценариев, провоцируют вопросы, когда это необходимо, и захватить ключевые данные, включая отношения и продажи триггеров.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name="CustomerHistoryReportingService" id="8761186b-9a1a-423f-b917-148e3315d24f">
          <documentation> A reporting service that provides data and data analysis regarding the history of a customer, including channel usage activity, customer service history, and customer event history including transaction history

Служба отчетов, которая предоставляет данные и анализ данных об истории клиента, включая действия по использованию канала, историю обслуживания клиентов и историю событий клиента, включая историю транзакций</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name="CustomerMasterAgreement" id="ffcd1dc3-3e4e-4c7a-8599-077fbba8b87e">
          <documentation> A master agreement that governs the relationship between a bank and a bank's customer.

Note: A customer can be a complex corporate entity with multiple subsidiaries operating in different geopolitical areas. The customer agreement is linked to as many product agreements as needed for all in-force products


Генеральное соглашение, регулирующее отношения между банком и клиентом банка.

Примечание: клиент может быть сложным юридическим лицом с несколькими дочерними компаниями, работающими в разных геополитических областях. Клиентское соглашение связано с таким количеством соглашений о продуктах, которое необходимо для всех действующих продуктов</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name="CustomerOffer" id="fbcb1dc1-b740-4aaf-aaa4-b2991a6c9afb">
          <documentation> An offer of an agreement to a prospect.

Notes: The receipt of an offer changes the classification of a party's role from a prospect to a customer. A customer offer is related to a stage in the lifecycle of an agreement with a customer, in which the agreement has been offered to the customer but is not finalised.



__банк предлагает некое соглашение предполагаемому клиенту__

Примечания: получение офера изменяет классификацию роли стороны с потенциальной на роль клиента. Клиентское предложение относится к этапу жизненного цикла договора с клиентом, на котором договор был предложен клиенту, но не завершен.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name="CustomerOfferManagement" id="3fff251a-3f36-482d-8411-571aeb1e2353">
          <documentation>A management process that governs the offering of an agreement to a prospect.

Note: The receipt of an offer changes the classification of a party role from a prospect to customer.


__Процесс управления, который регулирует предложение офера предполагаемому клиенту.__

Примечание: получение предложения изменяет классификацию роли участника от потенциального клиента к покупателю_.

</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name="CustomerPartyRole" id="7ac62724-bda8-444d-a6e9-13333c2fe49a">
          <documentation>A role that a party plays as a customer of a financial institution

Роль, которую сторона играет в качестве клиента финансового учреждения

</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name="CustomerRegistry" id="e0a04929-d0d1-4adf-b25c-19a2b95fbf1b">
          <documentation> A registry whose entries represent customers

Реестр, записи которого представляют клиентов</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name="CustomerRegistryEntry" id="dd908195-4bf7-4fb6-b861-3466360c5425">
          <documentation>An entry in a customer registry

Запись в реестре клиентов </documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name="CustomerServiceAgentPartyRole" id="cf32fa3e-7239-4e25-9d06-268d183ae2f5">
          <documentation> A person playing the role of customer service agent representing a financial institution

Лицо, выполняющее роль агента по обслуживанию клиентов, представляющего финансовое учреждение</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name="CustomerWorkbench" id="2ba3ccbe-d1ed-4f76-8e03-9fbd040766c0">
          <documentation> A set of automated applications made available to customers

Набор автоматизированных приложений, доступных клиентам</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name="CustomerWorkbenchAuthentication" id="44262be6-e841-4e6b-ad80-bb5aef1972fb">
          <documentation> Authentication of a person who attempts to use the customer workbench


Проверка подлинности пользователя, который пытается использовать рабочее место клиента</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name="CustomerWorkbenchPartyRole" id="891c3126-2bb9-4bf4-9a2d-536f386d07e0">
          <documentation> A user of the customer workbench


Пользователь _воркбенча (рабочего места пользователя)_</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name="CustomerWorkbenchSession" id="ac2b5792-6959-4629-a20d-a97b5cce3372">
          <documentation> An operating session of the customer workbench

Рабочий сеанс рабочего места клиента</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name="Device" id="f63d2d33-cd4f-492d-8b1f-def03721c6b6">
          <documentation> A mechanism created to serve a particular need, such as a credit card, a smart phone, an electronic signature, an electronic key, etc.


Механизм, созданный для обслуживания конкретной _нужды, например, кредитная карта, смартфон, электронная подпись, электронный ключ и т. д.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name="Disbursement" id="890a43f0-b058-477e-9556-a3fc1656bfe7">
          <documentation>Disbursement / выплата , выделение средств

A payment of money from a fund, from a line of credit, or simply as a one-time transfer of money from a lender to a borrower


Выплата денег из фонда, из кредитной линии или просто как одноразовый перевод денег от кредитора к заемщику</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name="Disclosure" id="b3efaaee-374f-41f2-99d1-d549021e08e9">
          <documentation>disclosure /обнаружение, открытие, разоблачение, раскрытие

The revelation of information relevant to an agreement or potential agreement


Раскрытие информации, относящейся к соглашению или потенциальному соглашению</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name="DocumentHandlingSession" id="468b7f7c-d587-4cb7-ab9a-31126f5ac013">
          <documentation>An operating session of a document handling system

Рабочий сеанс системы обработки документов</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name="DocumentHandlingSystem" id="9ae06f0d-5c5f-4189-829c-1a0101260fc2">
          <documentation> A set of applications -- typically automated -- that assists with the handling of documents

Набор приложений, обычно автоматизированных, которые помогают обрабатывать документы</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name="DunningManagement" id="b0b97aea-5110-4a3c-8a77-49acec9dde83">
          <documentation>Dunning / требовать уплаты просроченного долга

A management process that governs how dunning is handled

Процесс управления, который управляет тем, как обрабатывается __уплата просроченного долга__</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name="DunningManagementSystem" id="0b1129fd-ac98-45d4-9ae4-c0004b5fae52">
          <documentation>A set of applications -- typically automated -- that assists with the dunning management process


Набор приложений - обычно автоматизированных - который помогает в процессе управления __уплата просроченного долга__</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name="IssuedDeviceAllocationSystem" id="9988e151-ab62-46c1-89d3-a65ba5ae1172">
          <documentation>A set of applications -- typically automated -- that assists with the allocation and issuance of devices


Набор приложений, обычно автоматизированных, которые помогают распределять и выдавать устройства</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name="LoanObligation" id="7a8f0606-3ca3-429d-acd1-52adb5707b94">
          <documentation>obligation / обязательство

An arrangement regarding a loan whereby parties have rights and other parties bear the responsibility to honor those rights


Соглашение о займе, в соответствии с которым стороны имеют права и другие стороны несут ответственность за соблюдение этих прав</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name="LoanProduct" id="f6b78f3f-5d05-4b9c-8472-502ea5cf7f53">
          <documentation> A product that enables parties to borrow

Продукт, который позволяет сторонам заимствовать</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name="LocationRegistry" id="53e07cf2-75ca-4fc7-b0d0-09abb02d673d">
          <documentation> A registry whose entries represent locations

Реестр, записи которого представляют расположения</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name="LocationRegistryEntry" id="2b90a85f-358a-4c77-b57c-35730db2a7e4">
          <documentation>An entry in a location registry</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name="ManagementProcess" id="1656a6a8-93cf-472a-b5f3-cfa0e55de4dd">
          <documentation> A set of work tasks following a defined procedure in support of general office activities and product and service delivery



Набор рабочих задач в соответствии с определенной процедурой в поддержку деятельности общего офиса и предоставления продуктов и услуг</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name="PartyRegistry" id="93fdb23d-708d-4bf2-9058-1db38ff782c6">
          <documentation> A registry whose entries represent parties that can be organizations or persons


Реестр, записи которого представляют стороны, которые могут быть организациями или лицами</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name="PartyRegistryEntry" id="31035c59-5a60-495c-ac0e-933aa2d68357">
          <documentation> An entry in a party registry

Запись в реестре _участников</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name="PaymentCardAgreement" id="38188d4f-8732-4482-9e4c-555341f8d5f8">
          <documentation> An agreement established among the parties involved in a payment card service


Соглашение, заключенное между сторонами, участвующими в __предоставлении сервиса платежных карт__</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name="PaymentCardService" id="b31960a8-944b-4955-8a83-4881c723e22a">
          <documentation> A service that offers customers the use of payment cards


Сервис, который предлагает клиентам использование платежных карт</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name="PaymentOrder" id="a1e2cc0d-883a-4726-ae1c-67c31ec1110d">
          <documentation> An order by a customer to make a payment

Заказ клиента на осуществление платежа</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name="PresentationManagementSession" id="1bbb7a7c-1fc2-4d83-9541-16b8b8351fc5">
          <documentation>An operating session of a presentation management system

Операционная сессия системы _презентующей/отображающей документы_</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name="PresentationManagementSystem" id="d28c0815-d07f-407d-84b5-0a6623069e4e">
          <documentation>A set of applications -- typically automated -- that assists in managing the presentation of documents

Note: Documentation presentation includes sending documents over communication channels, and is called correspondence in some communities



Набор приложений, обычно автоматизированных, которые помогают управлять представлением документов

Примечание. Представление документации включает отправку документов по каналам связи и в некоторых сообществах называется перепиской</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name="ProductBroker" id="2c1eafa0-b31f-4cce-b483-4bd01bfd807b">
          <documentation>A party acting as a broker for a product

__Участник, действующий в качестве посредника для продукта__</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name="ProductBrokerMasterAgreement" id="13269e55-84d4-4bc7-865c-46004ab7bce4">
          <documentation> A master agreement governing the engagement of a party to act as a broker for a product


Генеральное соглашение, регулирующее привлечение стороны в качестве брокера/_посредника_ для продукта</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name="ProspectManagement" id="98429ec3-d84f-4fde-8940-5ed5b185a304">
          <documentation> A management process governing the handling of sales prospects

Процесс управления, регулирующий управление  продаж для предполагаемых клиентов</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name="ProspectPartyRole" id="47c3168e-1048-4dc8-881b-3ebae2682670">
          <documentation> A party that is a prospective customer but has not yet been offered an agreement for products and services

Note: The party is classified as a customer once the party has received an offer



Сторона, являющаяся потенциальным клиентом, но еще не __получившая офер__ на продукты и услуги

Примечание: сторона классифицируется как клиент, как только сторона получила предложение</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name="ProspectStatus" id="522675eb-bc67-4497-aca2-be59c8004656">
          <documentation> A stage in the lifecycle of a prospect

Note: A prospect becomes a customer once the prospect is offered an agreement



Этап жизненного цикла _предполагаемого клиента__

Примечание: _предполагаемый клиент__ становится клиентом, как только ему будет предложено соглашение</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name="RegistrationAuthority" id="577782d0-14c1-49b1-adae-2d0dae740492">
          <documentation> A party that is duly authorized to maintain a registry


Сторона, должным образом уполномоченная вести реестр</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name="Registry" id="17e36f4e-411c-416d-a079-114e4006a4f7">
          <documentation>directory / registry / каталог чего-либо


A system that registers some specific kind of element in a database, and is managed by a duly constituted registration authority

Note: BIAN uses the term Directory to represent the same concept as is termed a Registry in ISO 20022



Система, которая регистрирует определенный элемент в базе данных и управляется надлежащим образом созданным регистрирующим органом

Примечание: BIAN использует термин каталог для представления того же понятия, что и реестр в ISO 20022</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name="RegistryEntry" id="9b8912b5-e73d-487d-97e6-94332d1792f4">
          <documentation> An entry in a registry

Запись в реестре</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name="RemittanceOrder" id="1117551c-e1fc-4ab7-bc24-e9bb12f3a4f4">
          <documentation>An order by a customer to send a remittance


Заказ клиента на отправку денежного перевода</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name="Resource" id="0a92ba58-2291-4edc-8917-852caef58e94">
          <documentation> An object, mechanism, or collection of objects that either exists naturally or is created or assembled by people or by systems


Объект, механизм или коллекция объектов, которые существуют естественным образом или создаются или собираются людьми или системами</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name="SalesLeadManagement" id="a5caeab8-6e70-40b3-b4b6-f067eddedae4"/>
        <element xsi:type="archimate:BusinessObject" name="SalesLeadPartyRole" id="30789462-a770-4cd6-a908-4721430e37ff"/>
        <element xsi:type="archimate:BusinessObject" name="Session" id="36678aae-5de5-4dd5-b1d3-01a4623e4e0c">
          <documentation> The operation of a system -- typically an automated system -- for a bounded period of time


Работа системы - обычно автоматизированной системы - в течение ограниченного периода времени</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name="SyndicatedLoan" id="c53a87f3-ded4-4272-b92c-86978f345e91">
          <documentation> A loan made by a group of lenders

Кредит, предоставленный группой кредиторов</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name="TermsAndConditions" id="5ebfa58c-41a9-4c11-a265-b135d6a1e35c">
          <documentation>Rules that govern the use of a product

Правила, регулирующие использование продукта</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name="Underwriting" id="b1269f3c-3ae7-4b7f-ac14-4f992c36ee67">
          <documentation> A management process governing the evaluation and assumption of risk


Процесс управления, регулирующий оценку и принятие риска</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name="UnderwritingDecision" id="daaecb92-b566-443e-932c-a16e82bb55a7">
          <documentation> A decision as to whether or not to assume a risk

Решение о принятии или непринятии риска</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name="UnderwritingStatus" id="fc250f8d-498a-45d2-b825-b59f135ed92b">
          <documentation> A stage in the lifecycle of an underwriting decision

Этап жизненного цикла решения по андеррайтингу</documentation>
        </element>
      </folder>
      <folder name="DICO Business Components" id="53d629ef-392b-419c-8282-4a398d7cfa7a">
        <element xsi:type="archimate:BusinessObject" name=">AcceptorConfiguration" id="894b4e04-7507-4bc3-9771-81aa5eef2546">
          <documentation> Acceptor parameters to be downloaded from the terminal management system.


Параметры акцептора, который нужно загрузить от терминальной системы управления.



acceptor / приёмщик / получатель

</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">AcceptorRole" id="5ad1a099-9295-4ff7-a18a-64142da64e9f">
          <documentation> Entity accepting payment related cards.

Организация, принимающая карты, связанные с оплатой.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Account" id="7ea35b0f-45d1-4aaa-a5a5-047378fe7c1f">
          <documentation> Record of transactions in specific types of assets, maintained by a servicing party on behalf of one or more owning parties. Business relationship between an account servicer and one or more account owners.



Запись транзакций конкретных наборов данных, осуществляемых обслуживающей стороной от имени одной или нескольких сторон-владельцев. Бизнес-отношения между сервисом обслуживания учетных записей и одним или несколькими владельцами учетных записей.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">AccountContract" id="442e047c-8b33-4089-aaa8-63a38f4eecdd">
          <documentation>Agreement between an account servicer and an account owner about the services linked to an account.


Соглашение между __узлом обслуживания счетов__   и владельцем учетной записи об услугах, связанных с учетной записью.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">AccountEntry" id="615328cb-c7b9-4e63-8e05-0d38a3bca4d5">
          <documentation> Amount of money debited or credited on the books of an account servicer.


Сумма денежных средств, списанных или зачисленных на бухгалтерский учет __узлом обслуживания счета__ .</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">AccountIdentification" id="5980ff5e-050f-4a32-a308-123b0eff425a">
          <documentation> Unique identifier of an account, as assigned by the account servicer.

Уникальный идентификатор учетной записи, назначенный __узлом обслуживания счета__ </documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">AccountInformationRecipientRole" id="131499eb-8f0d-4e03-95f6-64d7aecf386f">
          <documentation> Party that is entitled by the account owner to receive information about movements in the account.


Сторона, которая имеет право владельцем счета получать информацию о движении средств по счету.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">AccountLink" id="714f616c-e9dc-43fb-9bb5-151f0ac4432f">
          <documentation> Defines the link between the accounts held with a market infrastructure.


Определяет связь между счетами, хранящимися в инфраструктуре рынка.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">AccountOwnerRole" id="ce6c6a32-1130-4850-b458-691120e6ea52">
          <documentation> Party that legally owns the account.

Сторона, которая юридически владеет счетом.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">AccountPartyRole" id="c8e070e7-2d4a-403a-92af-b85e09267d0f">
          <documentation> Role played by a party in the context of account operations.

Роль участника в контексте операций по счету.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">AccountReportedMovement" id="1976b164-5e87-42a1-a301-bfa47cbda876">
          <documentation> Provides statistical information on the number of movements and their value for a particular account.

Предоставляет статистическую информацию о количестве перемещений и их _значений_ для конкретного счета.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">AccountResponsiblePartyRole" id="0a5351cc-47e7-4137-ba51-01fc012dfa19">
          <documentation> Party which is responsible for creating and managing an account owned by another party.

Сторона, ответственная за создание и Управление учетной записью, принадлежащей другой стороне.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">AccountRestriction" id="46a21efc-5f8f-4ed0-9ce7-257cdce6de1d">
          <documentation> Restriction on capability or operations allowed.


Ограничение возможностей или ограничение на разрешенные операции__.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">AccountService" id="62a1cc5d-4b6e-49c3-b1b5-39ecdec27042">
          <documentation>Services linked to an account which are available to the account owner or to the holder of a mandate.


Услуги, связанные со счетом, которые доступны владельцу счета или держателю _полномочий_.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">AccountServicerRole" id="6a11dcad-70d0-40d1-ae7f-a6125a14beb8">
          <documentation>Party that manages the account on behalf of the account owner, that is manages the registration and booking of entries on the account, calculates balances on the account and provides information about the account.

Сторона, которая управляет счетом от имени владельца счета, т. е. управляет регистрацией и резервированием записей по счету, рассчитывает сальдо по счету и предоставляет информацию о счете.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">AccountStatus" id="d3a52e4f-8f83-4893-81f9-69ba5b83cff4">
          <documentation> Specifies the status of an account or the status of the processing of the actions linked to the management of an account.



Указывает состояние учетной записи или состояние обработки действий, связанных с управлением учетной записью.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">AcquirerRole" id="91cbb697-f922-40f4-bc6c-1e53981568ec">
          <documentation>acquire / приобретать, получать / приём к оплате платёжных карт 

Entity acquiring card payment transactions.


__сущность принимающая платежные транзакции по карте__

___сущность, обслуживающая платежные транзакции по карте___</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">AdditionalRight" id="ed25c34f-e718-425b-a4a8-927049a6a863">
          <documentation>Specifies how the additional rights can be granted to the shareholder. These rights can be exercised at shareholders meetings (for example, the right to ask questions, the right to add items to the agenda or table draft resolutions).

Указывает, каким образом акционеру могут быть предоставлены дополнительные права. Эти права могут быть реализованы на собраниях акционеров (например, право задавать вопросы, право добавлять пункты в повестку дня или вносить проекты решений).</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">AdditionalRightDeadline" id="98676304-db4f-4521-adf1-845aff120d9d">
          <documentation>Date and time by which security holders can propose amendments or new resolutions.


Дата и время, к которым держатели ценных бумаг могут предлагать поправки или новые резолюции.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Adjustment" id="b016c7f4-48cf-459d-999c-48c35234a10f">
          <documentation> Modification on the value of goods and / or services. For example: rebate, discount.


Изменение стоимости товаров и / или услуг. Например: скидки, скидки.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">AdministratorRole" id="f34a3738-c1fd-4b39-85b5-32d226d4fad3">
          <documentation> Entity that has been appointed by a legal authority to act on behalf of a person or organisation that has gone bankrupt.


Юридическое лицо, которое было назначено юридическим лицом действовать от имени лица или организации, которая обанкротилась.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">AffirmingPartyRole" id="fba55374-5073-4f0b-9f1f-03a33a1017a4">
          <documentation>Party (buyer or seller) that positively affirms the details of a previously agreed security trade confirmation.


Сторона (покупатель или продавец), которая положительно подтверждает детали ранее согласованного подтверждения сделки с ценной бумагой.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">AgentCorporateActionStandingInstruction" id="30a0d194-f1f6-4379-b625-be74d9c49cb6">
          <documentation>Set-up at the issuer (agent) of a standing instruction originating from the CSD Participants. These standing instructions allow the participant to indicate details for the distribution of the outturn resources of a CA event outside of the CSD. A standing instruction can be accepted or rejected by the issuer (agent) and a CSD participant can amend or cancel a standing instruction.




Настройка у эмитента (агента) постоянной инструкции, исходящей от участников кур. Эти постоянные инструкции позволяют участнику указать детали для распределения ресурсов выхода события CA вне CSD. Постоянное поручение может быть принято или отклонено эмитентом (агентом), а участник кур может изменить или отменить постоянное поручение.


CSD / Central Securities Depository / центральный депозитарий; расчетный депозитарий</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Agreement" id="850da87b-c221-45a5-b89e-45fea21c1d96">
          <documentation> Contractual details related to an agreement between parties.
</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Allocation" id="77061b26-7ccb-4d5b-8516-aba1e49abbec">
          <documentation>Distribution of the (block) trade (transactions) by the investor or investment manager to different underlying clients, ie, investment funds


 Распределение (блок) торговли (сделок) инвестором или управляющим инвестициями между различными базовыми клиентами, т. е. инвестиционными фондами.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">AllocationPartyRole" id="9a39d5d7-d544-470e-be5f-45147455e23e">
          <documentation>Party which instructs the trade allocation to the executing party.


Сторона, которая поручает распределение торговли исполняющей стороне.

</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Allowance" id="d53b58ce-de60-4632-a643-368b0018b875">
          <documentation> Amount of money deducted from a price or an amount due.

Сумма вычитается из цены или суммы.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">AmendmentOfUndertaking" id="c8845639-9e98-4a9c-b1ae-9e889f09ff5d">
          <documentation> Modification of an undertaking such as an guarantee or standby letter of credit.


Изменение обязательства, такого как гарантия или резервный аккредитив.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Assessment" id="845975f8-3789-48a0-b22c-830630348a06">
          <documentation> Assessment for the components of a system.


Оценка компонентов системы.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Asset" id="cfe79d0c-c43c-4c22-8352-cedf2b114c25">
          <documentation>Tangible items of value to a business.

Материальные ценности для бизнеса.


Asset / осязаемая вещь ценная для бизнеса
</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">AssetHolding" id="56cfc3f7-efb0-4d4e-b19a-819202f4eba2">
          <documentation>Specifies in terms of value and quantity the assets.


Специфицирован в терминах количества ассетов

</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">AssignedProxyRole" id="47bdb7cb-1031-43e8-baf0-fe11048e44b1">
          <documentation>_доверенное лицо_ 

Party appointed by the rights holder to attend a meeting and vote in its name. The proxy can be the chairman of the meeting or another party selected by the issuer. The proxy can also be a third party selected by the rights holder.
The proxy can be assigned by a specific instruction or pre-assigned by the issuer of the meeting.



Партия, назначенная правообладателем для участия в собрании и голосования от своего имени. Доверенным лицом может быть председатель собрания или другая сторона, выбранная эмитентом. Доверенным лицом может быть также третье лицо, выбранное правообладателем.
Доверенное лицо может быть назначено по определенной инструкции или предварительно назначено издателем собрания.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Assignee" id="f2c6ed4a-c39e-40e1-8935-be2d5f33aa12">
          <documentation> assignee /  назначенное лицо

Party to which the case is assigned.


Сторона, которой назначено дело.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Assigner" id="91fb3fae-5345-4064-bfee-6877b4e65724">
          <documentation>Assigner / назначающее лицо

Party who assigns the case.

Сторона, которая назначает обращение.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Assignment" id="21af030e-95f0-40f7-b539-7763b9aa1c2a">
          <documentation> Transfer by one party to a third party of its receivables.

Передача одной стороной третьей стороне своей дебиторской задолженности.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Assured" id="9d1fc714-579d-4232-a86a-66691b07d29c">
          <documentation> Party that is covered under the assurance policy.

Сторона, на которую распространяется политика страхования.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ATMTotal" id="cea4ee5b-bd56-4b4c-bbd7-39e597c5f4f6">
          <documentation> Current totals of the ATM.

Количество банкоматов</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">AttendanceCard" id="0a97b9e1-bdc1-4692-a2f9-96d76d64d508">
          <documentation>AttendanceCard/ карточка участника 
attendance / присутствие; посещение / посещаемость

Information about the attendance card which is issued for the requestor, for its underlying client or for the appointed proxy person or meeting attendee when an attendance request is included in the meeting instruction.
The instructing party can specify which information must be indicated on the attendance card and to which location the attendance card must be delivered.


Информация о карточке участника, которая выдается запрашивающему лицу, основному клиенту или назначенному доверенному лицу или участнику собрания, если запрос на участие включен в инструкцию по проведению собрания.
Инструктирующая сторона может указать, какая информация должна быть указана в карте посещаемости и в какое место должна быть доставлена карта посещаемости.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">AttendanceConfirmationDeadline" id="04c8ed4f-119c-4091-9b7f-e53cbe202e8b">
          <documentation> Date and time by which the beneficial owner or agent must notify of their intention to participate in a meeting.

Дата и время, когда бенефициарный владелец или агент должен уведомить о своем намерении участвовать в собрании.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Authentication" id="f7126f14-53ee-467a-860c-6069f058d150">
          <documentation> Data related to the authentication of the cardholder.

Данные, связанные с аутентификацией владельца карты.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">AuthorisationEntity" id="ef125bf1-f85d-4602-9101-87e13ce6ae69">
          <documentation>Party which has delivered or declined the authorisation.

Сторона, которая предоставила или отклонила разрешение.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">AuthorisedAccountModifier" id="fa2292e9-64b6-47e5-9990-73773babcb1d">
          <documentation> Authorised sender of a message related to the life cycle of an account.

Авторизованный отправитель сообщения, связанного с жизненным циклом учетной записи.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">AutomaticVariation" id="8ccba79a-d489-4be7-aec6-9f0bf6ae9ae3">
          <documentation>standby letter of credit /  резервный аккредитив / гарантийный аккредитив


Predefined variations that may be attributable to an undertaking such as a guarantee or standby letter of credit.


Предопределенные изменения, которые могут быть отнесены на счет обязательства, такого как гарантия или резервный аккредитив.



_____Резервный аккредитив - это письменное обязательство банка-эмитента перед бенефициаром (экспортером, поставщиком) произвести платеж за приказодателя (импортера, покупателя) в случае невыполнения последним своих договорных обязательств и предъявлении бенефициаром письменного требования платежа
</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Balance" id="cf918659-b7bd-4ea6-a251-6f601a25ea7e">
          <documentation>Numerical representation of the net increases and decreases in an account at a specific point in time.

Числовое представление NET увеличивается и уменьшается на счете в определенный момент времени.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">BankingTransaction" id="249ff6c0-4092-40c6-9ffc-75e5e9f9085a">
          <documentation> Transaction executed by the client of a financial institution from/to the account serviced by the financial institution, such as mortgage payment.

Сделка, совершенная клиентом финансового учреждения с / на счет, обслуживаемый финансовым учреждением, например, ипотечный платеж.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">BankOperation" id="59878487-f9c2-451d-b885-d88dae15e111">
          <documentation> Operation on a bank account. It may be limited in time, amount or type of operation.

Операция по банковскому счету. Он может быть ограничен по времени, объему или типу операции.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">BankTransaction" id="5d6be2cd-7879-4ca7-9424-265778e220b6">
          <documentation> Code of the underlying bank transaction.

Код базовой банковской операции.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">BaselineStatus" id="a3e32fe6-0a16-4c6c-9302-06f86e22aa14">
          <documentation>Indicates the status of a baseline.

Указывает состояние базы/отправной_точки.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">BasicSecuritiesRegistration" id="77753d6b-f71e-4721-8d00-a954c941c918">
          <documentation>Information related to registration of securities.

Информация, связанная с регистрацией ценных бумаг.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">BeneficialOwner" id="18bc78f8-34a5-4b53-95cc-7a7f553ad6e2">
          <documentation>beneficial owner /  выгодоприобретающий собственник
 
beneficial / выгодный, прибыльный

benefits	/ бенефиты, премии


Characteristics of an individual or entity that is ultimately entitled to the benefit of income and rights in a security, as opposed to a nominal or legal owner.


Характеристики физического или юридического лица, которое в конечном счете имеет право на получение дохода и прав в ценной бумаге, в отличие от номинального или законного владельца.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">BiddingConditions" id="27e1c969-dffe-4bc6-98e5-60d031c1835c">
          <documentation>bidding / предложение цены / аукцион, торги


Specifies the conditions under which securities can be acquired as part of a corporate action.

Определяет условия, при которых ценные бумаги могут быть приобретены в рамках корпоративных действий.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">BillTo" id="03def0e0-26c9-4b6a-8991-4f8e0c847d75">
          <documentation> Party to be invoiced for the purchase.

Сторона, которой выставляется счет на покупку.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">BookEntry" id="9f630c71-11aa-46bd-9382-948bb21d8687">
          <documentation>book entry / accounting entry / проводка

Movement of cash between two accounts. One account is debited and the other account is credited.

Движение денежных средств между двумя счетами. Один счет дебетуется, а другой кредитуется.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Borrower" id="64c0cd1f-3412-4cf6-9e8f-f81ecdf1a3a5">
          <documentation>borrower / заёмщик, берущий взаймы 
 
Party that has applied, met specific requirements, and received a monetary or securities loan from a lender.


Сторона, которая подала заявку, выполнила конкретные требования и получила денежный кредит или кредит под ценные бумаги от кредитора.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Broker" id="33586264-4359-4550-8d8f-cb280dba984c">
          <documentation>broker / посредник

Party that identifies a broker when required (for example, authorised broker, prime broker, etc).

Сторона, которая идентифицирует посредника при необходимости (например, авторизованный брокер, prime broker и т. д.).</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">BulkPayment" id="4cd7c978-c702-4f81-9935-18ae480ba2bd">
          <documentation>Payment which contains a series of other payments which have been grouped under specific criteria. A bulk payment can only contain individual payments of the same type (credit transfer or direct debit).

Платеж, который содержит ряд других платежей, сгруппированных по определенным критериям. Массовый платеж может содержать только отдельные платежи того же типа (кредитный перевод или прямое дебетование).</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">BuyerBank" id="7824dc89-b899-4a30-a0f2-7940adedbe75">
          <documentation> Financial institution of the buyer.

Финансовое учреждение покупателя.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">BuyerRole" id="7b53cea3-9eb4-42dd-bb31-eafdedea9fce">
          <documentation>Party that buys assets, good or services.

Сторона, которая покупает активы, товары или услуги.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">BuyIn" id="404d4f66-e388-4d15-bece-c8ab6ffcb5ce">
          <documentation>CCP / Central Counterparty / центральный контрагент

buy in / скупать акции /  выкупать (на аукционе) собственные вещи по низшей отправной цене


Process in which the buyer/CCP repurchases shares of stock because the seller either failed to deliver the shares or did not deliver them in a timely fashion. The seller has to make up the price difference if the new shares are more expensive than originally agreed to.


Процесс, в котором покупатель/CCP выкупает акции, потому что продавец либо не поставил акции или не поставил их своевременно. Продавец должен компенсировать разницу в цене, если новые акции будут дороже, чем первоначально договаривались.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">BuyOrSellIndicationOfInterest" id="dc17c7f5-d2c1-434b-9bc7-80819714fe92">
          <documentation> Intention to buy or sell a financial Instrument.

Намерение купить или продать финансовый инструмент.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CapitalValue" id="fd0d3dde-1aba-43e1-88d8-fc4cc545490f">
          <documentation> Value of the capital.

Стоимость капитала.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CardholderRole" id="5cb17feb-0de1-480e-b777-da90f8bd6c42">
          <documentation>Party entitled by a card issuer to use a card.

Сторона, имеющая право _от_ эмитента карты использовать карту.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CardIssuer" id="1995e1a0-32f7-4b94-9f0f-f0a187d1bc70">
          <documentation> Party that issues a payment card, as expressed by a numeric identification of the card issuer according to ISO/IEC 7812-1.

Сторона, которая выпускает платежную карту, выраженную числовой идентификацией эмитента карты в соответствии с ISO / IEC 7812-1.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CardPayment" id="7ca2f84a-6700-4e40-8099-192c9b80db32">
          <documentation>Payment through an electronic money product.

Оплата через продукт электронных денег.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CardPaymentAcquiring" id="db6a14af-1ead-43f0-b723-5afbd5ef57e0">
          <documentation> Payment processes initiated by a payment card.

Инициированный процесс оплаты банковской картой.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CardPaymentPartyRole" id="af077ccc-a89f-4436-99b8-2d32c3f1f67c">
          <documentation> Role played by a party in the context of a payment by card.

Роль, котрую играет участник в контексте оплаты картой.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CardPaymentStatus" id="28a6fc03-074c-44a6-b266-478af967ff4b">
          <documentation>Status of a payment by card.


Статус платежа по карте.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CardPaymentValidation" id="48661fcc-226c-479c-88d8-8d0db4490bc0">
          <documentation>Results and parameters of the card payment verification.

Результаты и параметры верификации платежа по карте.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Carrier" id="84067625-76d8-4d6d-8b83-df0a8065c1b3">
          <documentation>carrier/ компания-перевозчик
 
Identifies the party that is responsible for the conveyance of the goods from one place to another.


Определяет сторону, которая несет ответственность за перевозку груза из одного места в другое.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CarrierAgent" id="53cf58c3-83a5-44e5-a7de-47d7d0f069e2">
          <documentation> Carrier's agent (for example, shipping company) that acts on behalf of the carrier and may be the issuer of transport documents.

Агент перевозчика (например, судоходная компания), который действует от имени перевозчика и может выдавать транспортные документы.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CaseCreator" id="037e801d-0bfd-4da6-9339-1e29a3c04798">
          <documentation> Party who initiates the case.

Сторона, которая инициирует дело.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CashAccount" id="41d34cfa-81f2-46cd-b2e5-3292a8ae9eec">
          <documentation> Account to or from which a cash entry is made.


__Счет &quot;на&quot; &quot;из&quot; которого сделана денежная транзакция</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CashAccountContract" id="1d65ee86-c9e1-4288-9eae-e74ce683b551">
          <documentation> Account contract established between the organisation or the group to which the organisation belongs, and the account servicer.


Договор о счете, заключенный между организацией или группой, к которой принадлежит организация, и обслуживающим счет лицом.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CashAccountMandate" id="775e4fe0-dcb4-4e31-bf58-234c34b0b36a">
          <documentation> Authorisation given to a mandate holder to perform some operation on an account.

Доверенность выданная уполномоченномуЛицу_ на проведение каких-либо операций по счету.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CashAccountService" id="b58591a3-d81a-4bb9-8e8d-c670003ab87e">
          <documentation> Services linked to an account which are available to the account owner or to the holder of a mandate. The exercise of these services may be submitted to a limit.


Услуги, связанные со счетом, которые доступны владельцу счета или уполномоченномЛицу_. Осуществление этих услуг может быть ограничено.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CashAvailability" id="1db7c29d-24ef-48c1-9175-c88d0b56c7a4">
          <documentation> Indicates when the amount of money will become available, ie can be accessed and start generating interest.

Указывает, когда деньги станут доступны, т. е. можно получить и начать получать проценты.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CashBalance" id="32c2c3b6-e707-47de-afb7-ae96465d7145">
          <documentation>Numerical representation of the net increases and decreases in an account at a specific point in time. A cash balance is calculated from a sum of cash credits minus a sum of cash debits.



Числовое представление NET увеличивается и уменьшается на счете в определенный момент времени. Остаток денежных средств рассчитывается из суммы денежных кредитов минус сумма денежных дебетов.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CashClearingSystem" id="ec57e710-3d97-403d-bfad-3145600ce783">
          <documentation> Clearing system that processes only cash transfers.


Клиринговая система (_система безналичных рассчетов_), которая обрабатывает только денежные переводы.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CashDelivery" id="47cde72c-958c-4454-8837-893ea6eff6d4">
          <documentation> Amount of money representing a value paid by an agent bank to a creditor.


Денежная сумма, представляющая стоимость, уплаченную банком-агентом кредитору.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CashDeposit" id="ec1ae5af-4988-4214-a8ba-8130070eb7fa">
          <documentation> Amount of money representing a value paid by a debtor to an agent bank.

Денежная сумма, представляющая собой стоимость, уплаченную должником банку-агенту.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CashEntry" id="b666cab2-2d13-405f-ba09-5d7dbdf9fea8">
          <documentation> Posting of an item to a cash account, in the context of a cash transaction, that results in an increase or decrease to the balance of the account.

__Публикация значения на денежный счет, в контексте денежной транзакции, , которая приводит к увеличению или уменьшению сальдо счета.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Cashier" id="97eed73d-b97c-4da1-af27-4dc670763957">
          <documentation>Cashier who carried out the payment card transaction.


Кассир, осуществивший операцию по платежной карте.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CashLoanDeposit" id="ac4b42e1-3c65-4ff6-a062-a6950d0bedc1">
          <documentation>Agreement for a temporary transfer of cash from its owner (the lender) to a borrower who promises to return it according to the terms of the agreement, usually with interest for its use.

Договор о временной передаче денежных средств от своего владельца (кредитора) заемщику, который обещает вернуть их согласно условиям договора, как правило, с процентами за их использование.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CashManagementService" id="c3456b9f-4b75-41a0-9f81-7c22eafb861f">
          <documentation> Set of applications that provides services which facilitate the management of cash positions on an account.


Набор приложений, предоставляющий услуги, облегчающие управление денежными позициями на счете.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CashProceedsDefinition" id="a3c802d3-d623-428d-a983-d7a4caf5392d">
          <documentation> Definition of the cash proceeds for a corporate action in generic terms; that is, before applying it to specific securities holding. An example would be the definition of a dividend payment where all the information will be given in general on a per share basis.


???????
Определение денежных поступлений от корпоративного действия в общих чертах; то есть до применения его к конкретному холдингу ценных бумаг. Примером может служить определение выплаты дивидендов, когда вся информация будет предоставляться в целом на основе каждой акции.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CashSettlement" id="f735eb53-cb68-4fc3-9e62-46e3803d59c7">
          <documentation>Instruction between two financial institutions stipulating the cash transfer characteristics between the two parties.

Инструкция между двумя финансовыми учреждениями, предусматривающая характеристики денежных переводов между двумя сторонами.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CashSettlementInstructionPartyRole" id="fee07d43-f360-47e2-8ad3-799e9fbde494">
          <documentation> Role played by a party in cash settlement.

Роль стороны в наличном расчете.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CashStandingOrder" id="1097b523-4ec2-4428-9d46-f72696983f4e">
          <documentation> Instruction given by a party that has explicit authority to instruct a debit on the account, ie, either the debit account owner or originating party, to a first agent, to process cash transfers at specified intervals during an implicit or explicit period of time. A standing order is given once and is valid for an open or closed period of time.


Инструкция, данная стороной, которая имеет явные полномочия поручить дебет на счете, то есть, либо владелец дебетового счета или инициирующая сторона, первому агенту, для обработки денежных переводов через определенные промежутки времени в течение неявного или явного периода времени. Постоянный ордер выдается один раз и действует в течение открытого или закрытого периода времени.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CentralClearingCounterpartyRole" id="56c45168-c70c-4653-9f31-b2cac75fce3e">
          <documentation>Infrastructure that may be a component of a clearing house and which facilitates clearing and settlement for its members by standing between the buyer and the seller. It may net transactions and it substitutes itself as settlement counterparty for each position.


Инфраструктура, которая может быть компонентом информационно-координационного центра и которая облегчает клиринг и расчеты для его членов, выступая между покупателем и продавцом. Он может выполнять нетто-транзакции и заменять себя в качестве расчетного контрагента по каждой позиции.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CentralSecuritiesDepositoryRole" id="8d52638d-1feb-4a14-909b-75a9e7d17a06">
          <documentation> An infrastructure that, holds or controls, the holding of physical or dematerialised financial instruments belonging to all, or a large portion of, the investors in a securities market. This effects the centralised transfer of ownership of such securities by entries on its books and records. The depository may delegate custody to another entity (custodian).


Инфраструктура, которая удерживает или контролирует владение физическими или дематериализованными финансовыми инструментами, принадлежащими всем или значительной части инвесторов на рынке ценных бумаг. Это приводит к централизованной передаче права собственности на такие ценные бумаги посредством записей в их бухгалтерских книгах и записях. Депозитарий может делегировать право попечения другому лицу (хранителю).


CSD / Central Securities Depository / центральный депозитарий; расчетный депозитарий</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ChargeAccountAgent" id="bec808f2-ba32-43af-9e50-e2d8f0eeddbd">
          <documentation> Agent that services a charge account.

Агент, обслуживающий платежный счет.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ChargeAgent" id="79f65843-4f12-4cf2-a347-186392ac9c51">
          <documentation>Party that takes the transaction charges or to which the transaction charges are due.

Сторона, которая взимает операционные расходы или к которой относятся операционные расходы.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ChargeBearer" id="6318bc79-0103-4ed2-8a27-a06978334c31">
          <documentation> Party(ies) liable for a charge associated with the transfer of cash.


 Сторона (is) несет ответственность за плату, связанную с переводом денежных средств.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ChargePartyRole" id="337e4d08-2a19-4e8a-86a8-385dc3fc5145">
          <documentation> Role played by a party in the context of a paymentof charges.

 Роль партии в контексте оплаты.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ChargeRecipient" id="c0a95916-16bd-4e10-9814-77d81c5f085f">
          <documentation>Party entitled to the amount of money resulting from a charge.

Сторона, имеющая право на денежную сумму, полученную в результате взимания сборов.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Charges" id="b898eee9-7a46-4e2a-9007-b72567d59782">
          <documentation> Amount of money associated with a service.

Сумма денег, связанная с услугой.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CheckingPartyRole" id="7615ca38-5340-4e87-86a3-658ea231832d">
          <documentation> Identification of the person who checked the document and/or the signature.

Идентификация лица, проверившего документ и / или подпись.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Cheque" id="fbb617b3-8c9b-40cf-bfce-e716f9c9d5ff">
          <documentation>Negotiable instrument instructing a financial institution to pay a specific amount of a specific currency from the account of the drawer with that institution.

Оборотный инструмент, предписывающий финансовому учреждению выплачивать определенную сумму в определенной валюте со счета векселедателя в этом учреждении.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ChequeIssue" id="40e7d4b4-e0c2-4648-968b-d60cec2b3848">
          <documentation> Action to issue a cheque in order to settle an amount due to a creditor.


Действие по выдаче чека для погашения суммы, причитающейся кредитору.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ChequePartyRole" id="01349966-d1fc-4582-8a0a-6cdb208c1de1">
          <documentation> Role played by a party in the context of a payment by cheque.

Роль партии в контексте оплаты чеком.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ChequePayment" id="dbc79ef3-cfa3-4b5f-b423-1b7368d706f6">
          <documentation>Payment made by drawing a cheque in order to settle a debt.

Оплата производится чеком для погашения задолженности.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ChoiceCorporateAction" id="aa38fa92-6ab5-4bec-a98b-4a32181b26f1">
          <documentation> Mandatory with choice corporate action event that involves a choice on behalf of the owner of the securities. The shareholders are given a chance to choose among several options.

Обязательное с выбором корпоративное мероприятие, которое предполагает выбор от имени владельца ценных бумаг. Акционерам предоставляется возможность выбора из нескольких вариантов.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ClaimsAgent" id="5d3d7ae7-cb5b-4dac-93cb-bfff28b8bf25">
          <documentation> Party where claims under the insurance policy have to be addressed.

Сторона, в которой должны быть урегулированы претензии по страховому полису.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ClassAction" id="4171835f-bb2e-4213-9b25-13b5f82e306a">
          <documentation> Form of lawsuit in which a group of shareholders collectively bring a claim to court, mainly because it would be too expensive for each individual shareholder to launch their own lawsuit.

Форма иска, в котором группа акционеров коллективно предъявляет иск в суд, главным образом потому, что для каждого отдельного акционера было бы слишком дорого начать свой собственный иск.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Clearing" id="3558df8d-bf3b-44a4-998e-ca89375650e4">
          <documentation> Mechanism allowing financial institutions that are members of a clearing house to pay and to receive the amounts linked to the transactions that they have executed on the market. The addition of all the positions per product results in one net position (due or to receive) with the clearing house or the central clearing counterparty.

Механизм, позволяющий финансовым учреждениям, являющимся членами клиринговой палаты, выплачивать и получать суммы, связанные с операциями, которые они осуществили на рынке. Добавление всех позиций по каждому продукту приводит к одной чистой позиции (причитающейся или подлежащей получению) в клиринговой палате или центральном клиринговом контрагенте.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ClearingBroker" id="b18b92b9-4f76-47b3-ae6c-9ac6766c9f46">
          <documentation> Party which acts as a liaison between an investor and a clearing corporation.

Сторона, которая выступает в качестве связующего звена между инвестором и клиринговой корпорацией.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ClearingBrokerIdentification" id="386eb19d-daf0-4936-9945-57eb8ca54a74">
          <documentation> Reference number assigned by the clearing broker. A distinction can be made between the reference for the Central Counterparty (CCP) leg and the reference for the client leg of the transaction.

Ссылочный номер, присвоенный клиринговым брокером. Можно провести различие между ссылкой на сегмент центрального контрагента (CCP) и ссылкой на клиентский сегмент сделки.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ClearingExceptionPartyRole" id="c01ea6ab-928b-44d2-92db-391f5387dd6c">
          <documentation>Identifies the party that is exempt from a clearing obligation.

Определяет сторону, которая освобождается от обязательства по клирингу.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ClearingMemberRole" id="97ab1959-7ee2-44d5-924b-a413e9608186">
          <documentation> Member of an exchange's clearing corporation, responsible for executing client trades and involved in the clearing of trades.

Член клиринговой корпорации биржи, ответственный за осуществление клиентских сделок и участвующий в клиринге сделок.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ClearingPlace" id="27298aab-5abc-41b4-993e-7d15513a8101">
          <documentation>Infrastructure that may be a component of a clearing house and which facilitates clearing and settlement for its members by standing between the buyer and the seller. It may net transactions and it substitutes itself as settlement counterparty for each position.

Инфраструктура, которая может быть компонентом информационно-координационного центра и которая облегчает клиринг и расчеты для его членов, выступая между покупателем и продавцом. Он может выполнять нетто-транзакции и заменять себя в качестве расчетного контрагента по каждой позиции.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ClearingSystem" id="6f4e377e-faba-454e-b6a7-0b97ad8556f9">
          <documentation> Specifies the system which plays a role in the clearing process.

Указывает систему, которая играет роль в процессе _клиринга.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Collateral" id="64471f11-a3d2-4f69-a927-0b059ee890c4">
          <documentation>Assets pledged by a debtor to secure a loan or an exposure and subject to seizure in the event of default.

Активы, заложенные должником для обеспечения кредита или риска и подлежащие аресту в случае неисполнения обязательств.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CollateralAgreement" id="4338fae6-b3d7-4dd4-afb9-feab0bd1ee4c">
          <documentation> Agreement between two trading parties that contains information about their relative duties and rights regarding collateral processes.

Соглашение между двумя торговыми сторонами, содержащее информацию об их относительных обязанностях и правах в отношении процессов _залога_.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CollateralBalance" id="c7c0dd9a-6f53-455d-87af-a0a744a67ac8">
          <documentation>Specifies the different values taken into account to calculate the current collateral.

Указывает различные значения, учитываемые при расчете текущего залога.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CollateralInterestAdministration" id="95e32536-42e0-4a42-83b5-ac14a91a5fc9">
          <documentation> Calculation and request of interest linked to collateral.

Расчет и запрос процентов, связанных с залогом.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CollateralManagement" id="01d92b48-271e-4f61-bb4c-bdbacc02a851">
          <documentation>Set of operations relative to the management of collateral, variation margins, default fund participation and independent amount.

Набор операций по управлению залогами, вариационной маржой, участием Фонда по умолчанию и независимой суммой.


variation margin / вариационная маржа
</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CollateralMovement" id="3bf6e3c3-107c-43ed-97b4-9aa01721c7b1">
          <documentation>Provides the agreed amount and the collateral movement direction.

Обеспечивает согласованную сумму и направление движения залога.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CollateralPartyRole" id="b99e54cf-6e46-4cf0-9825-d83eb7ff2a91">
          <documentation>Role played by a party in the context of collateral.

Роль стороны в контексте _залога.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CollateralProposal" id="6ecff68f-f3ad-4c5e-b1ef-fef585eb7c66">
          <documentation>Specifies collateral proposed to the counterparty.

Указывает предлагаемое контрагенту обеспечение.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CollateralStatus" id="61acd433-bf72-4dd2-be78-54e5e64fb18f">
          <documentation> Specifies the status of the collateral or of an event related to collateral.

Указывает состояние обеспечения или события, связанного с обеспечением.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CollateralSubstitution" id="5a69009a-d56c-47e4-8e4a-2878d4ad3b02">
          <documentation>Substitution of collateral by specifying the collateral to be returned and proposing the new type(s) of collateral to be delivered.

Замена залога путем указания подлежащего возврату залога и предложения нового вида залога, подлежащего  поставке.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CollateralValuation" id="40f13d65-cb92-4d37-ae4c-a298ac9dfdcb">
          <documentation> Provides details about the valuation of each piece of collateral that is posted.

Предоставляет сведения об оценке каждой разнесенной части залога.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CommercialTrade" id="68208a37-5458-4d38-8771-35ae177a4747">
          <documentation>Commercial details of a trade transaction between a buyer and a seller.

Коммерческие детали торговой сделки между покупателем и продавцом.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CommercialTradePartyRole" id="bbe17188-7a25-4d76-833e-3ae2e91ccad7">
          <documentation>Role played by a party in the context of a trade.

Роль партии в контексте торговли.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CommercialTradeSettlement" id="13db544e-78e2-4246-9138-bcbd84d1031b">
          <documentation>Settlement of a commercial trade, that is, the instruction to deliver goods or services against the payment of an amount of money.

Уплата_ коммерческой сделки, то есть распоряжение о поставке товаров или услуг за счет уплаты определенной суммы денег.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Commission" id="d0127527-8831-44f3-bb30-dccb33441850">
          <documentation> Amount of money due to a party as compensation for a service.

Денежная сумма, причитающаяся стороне в качестве компенсации за услугу.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CommissionPartyRole" id="4fc9aab0-ac25-480d-9651-4fd8cb6aa6d5">
          <documentation> Role played by a party in the context of a payment of commission.

Роль стороны в контексте выплаты комиссионных.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CommissionRecipient" id="bf1b40e6-6a85-4fa1-ac83-20e5d3c1898a">
          <documentation> Party entitled to the amount of money resulting from a commission.

Сторона, имеющая право на сумму денег, полученную в результате комиссии.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CommissionWaiver" id="bc2c09a9-262d-494b-a573-e851988049d3">
          <documentation> Non-enforcement of the right to all or part of a commission by the party entitled to the commission.

Неисполнение права на всю комиссию или ее часть стороной, имеющей право на комиссию.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Commodity" id="22551238-0435-4a1f-afc9-2944dc679c9a">
          <documentation> Basic good used in commerce that is interchangeable with other commodities of the same type. Commodities are most often used as inputs in the production of other goods or services. The quality of a given commodity may differ slightly, but it is essentially uniform across producers. When they are traded on an exchange, commodities must also meet specified minimum standards, also known as a basis grade.

Основные товары, используемые в торговле, которые взаимозаменяемы с другими товарами того же типа. Товары чаще всего используются в качестве сырья при производстве других товаров или услуг. Качество данного товара может незначительно отличаться, но оно, по сути, является единым для всех производителей. Когда они торгуются на бирже, товары также должны соответствовать определенным минимальным стандартам, также известным как базовый класс.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Consignee" id="db78bc0c-39a3-45e3-aa90-2c3fbc4046e7">
          <documentation> Party to whom the goods must be delivered.

Сторона, которой должен быть доставлен товар.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Consignor" id="e862f56e-913a-4f02-bf47-ef1c0f052a0c">
          <documentation>Party responsible for dispatching the goods.

Сторона, ответственная за отправку товара.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ContactPersonRole" id="dd5dcdbb-1b5a-46a8-9d56-1bfa3b1242f4">
          <documentation>Person to be contacted in a given organisation. In the corporate action domain (including meeting notifications) , it is the contact person at the party organising the meeting, at the issuer or at an intermediary.

Контактное лицо в данной организации. В домене корпоративного действия (включая уведомления о собраниях) это контактное лицо на стороне, организующей собрание, у эмитента или у посредника.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ContactPoint" id="7ac23067-f40e-4147-a85d-da9651cc5bad">
          <documentation>Number, physical or virtual address, used for communication.

Номер, физический или виртуальный адрес, используемый для связи.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ContraClearingFirm" id="3b827976-76b3-4c40-b27d-fd8f8a84f270">
          <documentation>Party that is the clearing firm of the counterparty in a trade.

Сторона, которая является клиринговой фирмой контрагента по сделке.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Contract" id="12252bac-a045-4ab4-8cd0-58ca4a9e7b7e">
          <documentation> Document that contains the information of the contract agreed between both parties.

Документ, содержащий информацию о договоре, согласованном обеими сторонами.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ContraFirm" id="527488a2-8505-45db-8718-3483d5f73c81">
          <documentation>Party that is the counterparty in a trade.

Сторона, являющаяся контрагентом в сделке.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CorporateActionAgent" id="7b39d048-2771-421d-b367-1a9d24c167bc">
          <documentation> A firm authorised to act as an intermediary between issuer and shareholders. It takes care of the needs of the shareholders such as reporting, inquiries and regulatory compliance.

Фирма, уполномоченная выступать в качестве посредника между эмитентом и акционерами. Он заботится о потребностях акционеров, таких как отчетность, запросы и соблюдение нормативных требований.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CorporateActionCashEntitlement" id="2cedf807-4183-4446-9e62-1cbeca0348a1">
          <documentation> Rights for cash entitled to the account owner based on the terms of the corporate action event and the balance of underlying securities.

Права на денежные средства принадлежат владельцу счета на основании условий проведения корпоративного мероприятия и остатка базовых ценных бумаг.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CorporateActionDeadline" id="7dc1968a-6147-4cca-91ac-4529c286a90d">
          <documentation>Time constraints for processing corporate actions.

Временные ограничения на обработку корпоративных действий.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CorporateActionDistribution" id="0c3a580e-5eff-491e-a57b-1e833b8da99a">
          <documentation> Distribution of the proceeds of a CA event.

Распределение доходов от события CA.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CorporateActionElection" id="4273bfb7-e614-4b76-ad81-5c05c366d215">
          <documentation> Decision taken by the account holder regarding the corporate action event.

Решение, принятое владельцем счета в отношении _CA события.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CorporateActionEntitlement" id="863ced7b-65d0-44f5-bb62-45b1b2c12462">
          <documentation>Rights entitled to the account owner based on the terms of the corporate action event and the balance of underlying securities.

Права владельца счета на основании условий проведения CA_ и остатка базовых ценных бумаг.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CorporateActionEvent" id="bf0f3b46-83d1-49ac-b8bf-b0581edd41b8">
          <documentation>CA / Corporate Action / событие,решение  совета директоров


An event determined by a corporation's board of directors, that changes the existing corporate capital structure or financial condition.

Событие, определяемое советом директоров корпорации, которое изменяет существующую структуру корпоративного капитала или финансового состояния.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CorporateActionEventRegistration" id="d145e8e7-b73a-4b26-ae23-afdf2367b7ac">
          <documentation>Specifies the official date and identification of the event.

Указывает официальную дату и идентификацию события.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CorporateActionFeesAndCharges" id="c31f117d-4b0f-43b6-a565-ba0784724fb4">
          <documentation>The definition of all the charges related to a corporate action event.

Определение всех расходов, связанных с CA.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CorporateActionNotification" id="d897ec54-d9ec-4874-a48c-e0422ec7019c">
          <documentation> The process of notifying of an upcoming corporate action. It provides corporate action details including the different options.

Процесс уведомления о предстоящем CA. Он предоставляет детали CA, включая различные варианты.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CorporateActionOfferor" id="679fd280-7889-4cd5-af63-f38d00cb1889">
          <documentation> Provides the entity making the offer and that is different from the issuing company.

Предоставляет организацию, которая делает предложение и которая отличается от компании-эмитента.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CorporateActionOption" id="56617d64-1bad-4779-9a45-355975e868fd">
          <documentation> Provides information about the alternatives available to an account owner when participating to a corporate action event. This is defined at a general level without looking at the specificities of the securities balances.

Предоставляет сведения об альтернативах, доступных владельцу учетной записи при участии в CA. Это определяется на общем уровне без учета специфики остатков ценных бумаг.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CorporateActionOptionServicing" id="874167d1-8c52-4618-89ce-56609ae03f16">
          <documentation> Option servicing process which calculates the entitlement based on a corporate action option.

Процесс обслуживания опции, который вычисляет право на основе параметра CA.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CorporateActionPartyRole" id="5e2b2657-a9c2-427f-af8d-9c8986f2e994">
          <documentation> Role played by a party in the context of a corporate action.

 Роль участника в контексте CA.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CorporateActionPrice" id="0c5c1c97-a62c-4c58-9ebf-211fd2ffc53c">
          <documentation> Prices related to a corporate action.

Цены, связанные с CA.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CorporateActionProceedsDeliveryInstruction" id="ac05601a-de58-4a92-9b11-29dde8e76389">
          <documentation> Specifies the delivery instructions for the securities and cash proceeds at any stage of the Corporate Action process.

Указывает инструкции по доставке ценных бумаг и денежных средств на любом этапе процесса CA.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CorporateActionSecuritiesEntitlement" id="a0977c79-24c5-4ae3-a4e9-558d21877d33">
          <documentation>Rights for securities entitled to the account owner based on the terms of the corporate action event and the balance of underlying securities.

Права на ценные бумаги принадлежат владельцу счета на основании условий проведения CA и остатка базовых ценных бумаг.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CorporateActionServicing" id="376279c3-cae0-46cd-9055-9894c0d63531">
          <documentation> Services which consists in notifying the investor or its agent of a corporate event and calculating its proceeds based on its holdings.


Услуги, которые заключаются в уведомлении инвестора или его агента о CA и расчете его доходов на основе его холдингов.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CorporateActionStatus" id="7b160311-a784-441b-80b4-ac81bf50e785">
          <documentation>Status of the corporate action process.

Состояние процесса CA.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CorporateActionStatusReason" id="521eff5b-884b-4260-8fd4-c070280ddc03">
          <documentation>Specifies the underlying reason for a status of a corporate action.

Указывает на причину текущего состояния CA.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CorporateInvestor" id="1e157637-d0f3-484b-9275-07b12fe9c0d7">
          <documentation> Corporate that makes investment decisions in relation with its investment account. 

Корпоративный, который принимает инвестиционные решения в отношении своего инвестиционного счета.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CorrespondentClearingFirm" id="b1f18584-2fc0-48c5-bbe5-1a4e9e635097">
          <documentation> Firm that is going to carry the position on their books at another clearinghouse (exchanges).

Фирма, которая будет нести позицию на своих книгах в другой клиринговой палате (биржах).</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CounterpartyRisk" id="a534bd31-6c3f-45b4-93eb-eee06b5d7869">
          <documentation> Calculation of the exposure amount that one party has vis-a-vis one counterparty or a central system, based on its credit risk.

Расчет суммы риска, которую одна сторона имеет по отношению к одному контрагенту или центральной системе, на основе кредитного риска.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CreditDefaultSwap" id="ffddd795-f6fc-4ca2-bc9d-30a38c153201">
          <documentation> Credit default swap is a particular type of swap designed to transfer the credit exposure of fixed income products between two or more parties. 

Кредитный дефолтный своп-это особый тип свопа, предназначенный для передачи кредитного риска продуктов с фиксированным доходом между двумя или более сторонами.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CreditInstrument" id="e4a90acd-2b4e-4e69-a723-5e8061289f81">
          <documentation>Specifies the instrument to be used for the credit of a payment.

Указывает инструмент, используемый для кредита платежа.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CreditNote" id="1ece1541-1a9a-4fe4-87e4-ca19ee16167c">
          <documentation> Monetary instrument issued by a seller that allows a buyer to purchase an item or service from that seller on a future date.

Денежный документ, выдаваемый продавцом, что позволяет покупателю приобрести товар или услугу у продавца в будущем.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CreditorAgentRole" id="113a5659-2a26-4e71-bfa6-aef5ed8c405b">
          <documentation>Financial institution servicing an account for the creditor.

Финансовое учреждение, обслуживающее счет кредитора.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CreditorRole" id="66fe0586-ed19-4a2f-bb17-adef56713073">
          <documentation>Party to which an amount of money is due.

Сторона, которой причитается денежная сумма.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CreditSideTaxDebtor" id="d177e5b1-ac04-41fd-a6eb-36b9942c36fc">
          <documentation> Party on the credit side of the transaction to which the tax applies.

Сторона по кредитной стороне сделки, к которой применяется налог.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CreditTransfer" id="1bcfd482-2478-4699-8f74-87f07e454314">
          <documentation> Payment made by transferring an amount of money from a debtor to a creditor. The payment flows through one or more financial institutions or systems.


Оплата производится путем перечисления денежной суммы от должника кредитору. Оплата проходит через одно или несколько финансовых учреждений или систем.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CrossTrade" id="f0147a8b-bc92-47e8-91bf-097e426638b8">
          <documentation>Transaction where either the buy-broker and the sell-broker are the same, or the buy-broker and the sell-broker belong to the same firm.

Сделка, где посреник_купли и посредник_продажи такие же, или посреник_купли и посредник_продажи  принадлежат той же фирме.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CRSStatus" id="81ac9f5f-0152-4d68-b3ed-380b5e73d541">
          <documentation>CRS / Common Reporting Standard / общий стандарт отчетности

Common Reporting Standard (CRS) status and the status source of the investor.

статус общего стандарта отчетности (CRS)  и статус источника инвестора.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CurrencyExchange" id="0a11dabd-aa3b-4a5a-9a25-d960566344d1">
          <documentation> Information needed to process a currency exchange or conversion.

Информация, необходимая для обработки обмена или конвертации валюты.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CurrencyOption" id="25b246c5-3954-478d-84cc-15670c96820d">
          <documentation> Right to buy (call) or sell (put) an underlying amount in one currency against another amount in another currency at a predetermined exchange rate, within a specified period of time or at a specified date and time.

Право купить (call) или продать (put) базовый сумма в одной валюте против другой суммы в другой валюте по заранее установленному курсу в течение определенного периода времени или на определенную дату и время.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Curve" id="4966b217-8269-4d27-9ade-aece388a7a24">
          <documentation>Describes a benchmark curve.

Описывает базовую кривую.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CustodianForMinor" id="873419e1-6f8d-4248-ab8d-dcb0297da2c3">
          <documentation> Entity that holds shares/units on behalf of a legal minor. Although the account is registered under the name of the minor, the custodian retains control of the account.

Юридическое лицо, владеющее акциями/паями от имени несовершеннолетнего юридического лица. Хотя учетная запись зарегистрирована на имя несовершеннолетнего попечителя сохраняет контроль над аккаунтом.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CustodianRole" id="3bf9b967-58dc-420a-b8d2-d3fa0793ad92">
          <documentation>custodian / попечитель / лицо управляющее активами от имени владельца
 

The party that safekeeps and administers assets on behalf of the owner.

 Сторона, которая хранит и управляет активами от имени владельца.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">CustodyService" id="314ddca9-bacd-4d84-9157-5dbba713e239">
          <documentation> A service in which a financial institution holds securities on behalf of the client. Custody provides an investor a place to store assets. Assets in custody are not fungible for the brokerage because they remain on the client's name.

Услуга, в рамках которой финансовое учреждение владеет ценными бумагами от имени клиента. Хранение предоставляет инвестору место для хранения активов. Опекаемые активы невзаимозаменяемы для брокера, потому что они все-еще остаются на имя клиента.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">DataSetInitiator" id="8106c2eb-4b4d-4cd1-8638-bc3944f4ad5b">
          <documentation> Initiator of a data set.

Инициатор набора данных.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Deadline" id="f40c6e0f-4939-4e30-9b7f-57b1c1b94cfb">
          <documentation> Specifies the different deadlines available for the different processes related to corporate action processes.

Определяет разные сроки для различных процессов, связанных с процессами корпоративного действия.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">DebitAuthorisation" id="3e81ad47-e067-4754-b2b3-16191dff9a07">
          <documentation> Permission given by an account owner to debit its account as the result of a cancelled payment. The authoriser is the party whose account was credited as the result of a payment instruction.

Разрешение владельца счета на списание средств с его счета в результате аннулированного платежа. Автором является сторона, чей счет был зачислен в результате платежного поручения.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">DebitCreditFacility" id="a0aef4fe-44d4-4592-9cca-5a81712115a0">
          <documentation> Specifies the conditions for overdraft on the account or for positive amounts.

Определяет условия овердрафта на счете или положительных сумм.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">DebitSideTaxDebtor" id="de67af87-67a7-4aba-97e0-1d4b22b40f99">
          <documentation> Party on the debit side of the transaction to which the tax applies.

Сторона на дебетовой стороне проводки, к которой применяется налог.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">DebtorAgentRole" id="49ad5029-82b8-4c6f-b8dd-ac82cf297f56">
          <documentation> Financial institution servicing an account for the debtor.

Финансовое учреждение, обслуживающее счет должника.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">DebtorRole" id="2b52f585-0ddf-4400-b859-c7a417be1b60">
          <documentation> Party that owes an amount of money to the (ultimate) creditor. For example, as a result of receipt of goods, assets, services, gifts, or charity payments.

Сторона, которая должна определенную сумму денег (конечному) кредитору. Например, в результате получения товаров, активов, услуг, подарков или благотворительных платежей.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">DefaultFund" id="d322c222-f18b-4cd5-a4fe-5af7a2dcf207">
          <documentation> Assets posted by participants in a clearing fund that can be used in the event of a default by a participant to compensate non-defaulting participants for losses they suffer due to this default.

Активы, размещенные участниками в клиринговом фонде, которые могут быть использованы в случае дефолта участника для компенсации участникам, не имеющим дефолта, убытков, понесенных ими в результате дефолта.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">DefaultFundContribution" id="148cd95d-2db3-4699-9d48-e3cccba927be">
          <documentation> Portion of the participation to the default fund that clearing member must provide. It is the sum of the individual contributions.

Часть участия в Фонде по умолчанию, которую должен предоставить клиринговый член. Это сумма индивидуальных взносов.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">DeliverersCustodian" id="b33486b3-2884-48d3-b1d4-519ab435ee41">
          <documentation>Party that acts on behalf of the seller of securities when the seller does not have a direct relationship with the delivering agent.

Сторона, которая действует от имени продавца ценных бумаг, если продавец не имеет прямых отношений с доставляющим агентом.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">DeliverersIntermediary" id="758c98aa-4248-4ea4-8301-78d04eaa86f9">
          <documentation> Party that the deliverer's custodian uses to effect the delivery of a security, when the deliverer's custodian does not have a direct relationship with the delivering agent.

Сторона, которую хранитель сдатчика использует для осуществления поставки ценной бумаги, когда хранитель сдатчика не имеет прямых отношений с доставляющим агентом.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">DeliveringAgent" id="846d1f9d-7eeb-499d-ae3b-89016bc56668">
          <documentation> Party that delivers securities to the receiving agent at the place of settlement. For example, a central securities depository.

Сторона, которая доставляет ценные бумаги получающему агенту по месту расчетов. Например, Центральный депозитарий ценных бумаг.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">DeliveringDepositoryRole" id="5b6b1192-9cae-4bfb-9cf0-ab33365c4ca8">
          <documentation>Organisation holding securities to enable book entry transfer of securities. Such an organisation may also carry out centralised comparison and transaction processing such as clearing and settlement of securities. The physical securities may be immobilised by the depository, or securities may be dematerialised (so that they exist only as electronic records). It is also responsible for compliance of the portfolio with legal ratios etc. The depository may delegate custody to another entity (custodian).


Организация, владеющая ценными бумагами для обеспечения возможности внесения ценных бумаг в Книгу. Такая организация может также осуществлять централизованное сравнение и обработку операций, таких как клиринг и расчеты по ценным бумагам. Физические ценные бумаги могут быть обездвижены в депозитарии, или ценные бумаги могут быть бездокументарными (так что они существуют только в виде электронных записей). Он также отвечает за соответствие портфеля правовые отношения и т. д. Депозитарий может делегировать право попечения другому лицу (хранителю).

</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">DeliveryNote" id="ee33a021-5044-4381-aeac-2fb70f8be2b4">
          <documentation>Document which is a proof of delivery of the product.

Документ, который является доказательством доставки товара.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Demand" id="733b489b-2645-46c7-950a-2298a13d9e8d">
          <documentation> Document signed by the beneficiary demanding payment under a demand guarantee or standby letter of credit.

Документ, подписанный бенефициаром, требующим оплаты по гарантии до востребования или резервному аккредитиву.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Deposit" id="d07d5749-f577-407b-a8d3-e673bf2bd85f">
          <documentation> An arrangement in which a lender gives money or property to a borrower, and the borrower agrees to return the property or repay the money, usually along with interest, at some future point(s) in time.

Соглашение, в котором кредитор дает деньги или имущество заемщика, и заемщик соглашается вернуть имущество или погасить деньги, как правило, вместе с процентами, в какой-то будущий момент(ы) во времени.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">DepositoryRole" id="862ce466-7df0-4edf-adcb-f85f80493f39">
          <documentation> Place where securities are deposited, that is company, bank or institution that holds and facilitates the exchange of securities.

Место, где депонируются ценные бумаги, то есть компания, банк или учреждение, которое держит и облегчает обмен ценными бумагами.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Derivative" id="77c4006c-8a5f-4372-9ed2-527cfd749c3f">
          <documentation> Specifies the parameters of a derivative instrument based on a specific asset.

Задает параметры производного инструмента на основе определенного актива.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">DirectDebit" id="78afeefb-eabf-4992-8218-6eb24c67f7f3">
          <documentation>Payment, initiated by the creditor, to debit a debtor's account in favour of the creditor. A direct debit can be pre-authorised or not. In most countries, authorisation is in the form of a mandate between the debtor and creditor.

Платеж, инициированный кредитором, для дебетования счета должника в пользу кредитора. Прямое дебетование может быть предварительно авторизовано или нет. В большинстве стран санкционирование осуществляется в форме мандата между должником и кредитором.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">DirectDebitMandate" id="d73ed9e5-4ab5-4ddc-aec4-7d775d2c873f">
          <documentation>Authorisation in favour of the creditor given by the debtor to debit its own account.

Предоставленное должником разрешение кредитору дебетовать свой собственный счет.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">DirectMember" id="f6e72c2c-04ae-4d63-9a6e-abad5b26b51f">
          <documentation>Financial institution or member of a system having full rights to the system specifications.

Финансовое учреждение или участник системы, имеющий полные права на спецификации системы.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">DisclosedListTrading" id="b61d0997-6384-42b7-b9e4-0d2dccc4201b">
          <documentation> List trading by which the buy-side details the exact stocks and sizes to be traded and the sell-side offers the buy-side a two-way price, to buy or to sell the indicated stocks. All sell-side firms see all of the stocks and quantities in the portfolio during the bidding phase regardless of whether or not they win the business.

Список торгов по которым покупают на стороне детали точных запасов и размеров можно торговать и на стороне предложения купить сторона в двусторонней цене, покупать или продавать указанные акции. Все продающие фирмы видят все акции и количества в портфеле на этапе торгов независимо от того, выиграют они бизнес или нет.

</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Discount" id="6aaaef20-f613-4958-a127-47cf762beb18">
          <documentation> Decrease of the value of goods and / or services by applying a discount rate to the original amount.

Снижение стоимости товаров и / или услуг путем применения ставки дисконтирования к исходному значению.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Discrepancy" id="8004479f-2cb7-46a8-8516-886d41fc2bd9">
          <documentation> Identification of a discrepancy.

Выявление несоответствия.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Discretion" id="40106583-94f6-473d-86a4-e3c4ca5d46de">
          <documentation> Indicates on an order that the trader wishes to display one price in the market but will accept trades at another price.

Указывает на ордер, что трейдер хочет отобразить одну цену на рынке, но будет принимать сделки по другой цене.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">DisputeManagement" id="547c2173-29e9-4f8f-96ec-90f7152cd2c4">
          <documentation> Provides the dispute details on the variation margin and/or the segregated independent amount.

Предоставляет подробную информацию о споре по вариационной марже и/или отдельной независимой сумме.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Document" id="173ceed6-7a42-4c5c-8437-83f590bbdc80">
          <documentation>General information that unambiguously identifies a document, such as identification number and issue date time.

Общие сведения, однозначно идентифицирующие документ, такие как идентификационный номер и дата выпуска.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">DocumentIssuer" id="21abef58-3801-4a18-9703-9839e1eb369e">
          <documentation> Party that issues a document such as a bank guarantee or letter of / documentary credit. For instance the inspection company for a trade certificate or the insurance company or its agent for an insurance certificate.

Сторона, которая выдает документ, такой как банковская гарантия или аккредитив. Например, инспекционная компания для получения торгового сертификата или страховая компания или ее агент для получения страхового сертификата.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">DocumentPartyRole" id="a5e91378-7ff5-477c-85f7-b4d328b282ec">
          <documentation>Role played by a party in the context of a document.

Роль партии в контексте документа.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">DocumentSignatory" id="42f7805e-1228-4586-a52d-60d0661e4289">
          <documentation> Person who binds himself or herself, or the entity he or she is authorized to represent, by his or her signature on the document.

Лицо, связывающее себя или организацию, которую оно уполномочено представлять, своей подписью на документе.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Drawee" id="f7843c6f-7bc2-46e4-a29d-eb26b9bd181f">
          <documentation> Financial institution on which a cheque is drawn, ie, the financial institution that services the account of the entity that issued the cheque.

Финансовое учреждение, на котором выписан чек, т. е. финансовое учреждение, обслуживающее счет лица, выдавшего чек.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Drawer" id="55206aa7-fbcb-471a-944a-e35e3b2f0ce8">
          <documentation> Account owner that issues a cheque ordering the drawee bank to pay a specific amount, upon demand, to the payee.

Финансовое учреждение, на котором выписан чек, т. е. финансовое учреждение, обслуживающее счет лица, выдавшего чек.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">DuplicateCase" id="36d12f5e-cc65-4aa3-ba4a-febc843e79a7">
          <documentation> Outcome that results in closing a case as duplicate because the same issue has been reported by another party.

Результат, который приводит к закрытию дела как дубликат, потому что та же проблема была сообщена другой стороной.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ElectronicAddress" id="488cd4c5-1f43-4d5f-af73-aa8f90e70fc8">
          <documentation> Address which is accessed by electronic means.

Адрес, к которому осуществляется доступ с помощью электронных средств.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ElectronicSignature" id="3eb76d3b-bcc7-4903-a672-52ce8588302c">
          <documentation>Additional security provisions, such as a digital signature.

Дополнительные меры безопасности, такие как цифровая подпись.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">EmployingPartyRole" id="47ef8b3d-9bb7-4196-9055-9268455d21b2">
          <documentation>Organisation represented by a person, or for which a person works.

Организация, представленная лицом, или для которого лицо работает.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">EnteringFirm" id="18fc8bcb-dfe8-4666-b32e-bb2949457da0">
          <documentation> Broker that has recorded or reported an execution of a trade. When an entering firm that is not a party to a trade enters the trade into a trade recording system, any inquiries can be directed to the appropriate source.

Брокер, который зарегистрировал или сообщил об исполнении сделки. Когда входящая в сделку фирма, не являющаяся стороной сделки, входит в систему регистрации сделок, любые запросы могут быть направлены в соответствующий источник.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Entry" id="ce4fd758-a29a-4015-9858-eba93917ac18">
          <documentation> Posting to an account that results in an increase or decrease to a balance.

Разноска на счет, которая приводит к увеличению или уменьшению сальдо.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Equalisation" id="d1a1053e-e4c3-4b12-8495-dbcf410fbd7e">
          <documentation> Part of an investor's subscription amount that is held by the fund in order to pay incentive / performance fees at the end of the fiscal year.

Часть суммы подписки инвестора, которая удерживается фондом для оплаты поощрительных / исполнительских взносов в конце финансового года.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ETCServiceProvider" id="5c866848-c64d-4aa7-ab16-5be35320652f">
          <documentation> Party that provides electronic trade confirmation services to its clients. For example, trade and allocation matching.

Сторона, предоставляющая своим клиентам услуги электронного подтверждения сделок. Например, сопоставление торговли и распределения.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Evidence" id="e1d1b5fe-2ba6-43ac-b932-e7ce02c10e33">
          <documentation> Element such as signature that can be used to prove a fact.

Такой элемент, как подпись, которая может быть использована для доказательства факта.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ExchangeForPhysicalTrade" id="f749f76c-f718-4185-860e-8a797f3b066c">
          <documentation> Technique whereby a position in the underlying is traded for a futures position in the physical commodity markets.

Техника, при которой позиция в базовом торгуется за фьючерсную позицию на физических товарных рынках.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ExecutingBrokerRole" id="237592a9-b539-4a43-b08b-174c62888b9c">
          <documentation>Party responsible for executing an order (e.g. an executing or give-up broker).

Сторона, ответственная за исполнение ордера (например, исполняющий или отдающий брокер).</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ExecutingTrader" id="c3f0e5ae-f8a3-4453-8da7-384e3f444df5">
          <documentation>Trader that executes a trade for an organisation.

Трейдер, который выполняет сделку для организации.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ExecutionDestination" id="94f6d3e8-db4e-4eff-9667-7a550baf48b3">
          <documentation> Destination for the execution, as defined by an institution when an order is entered.

Назначение для выполнения, как определено учреждением при вводе заказа.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ExpectedCollateralType" id="78fa5c85-4d3c-4375-907d-bd5c78d44c0c">
          <documentation>Expected collateral type.

Ожидаемый тип залога.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Expiry" id="f88bed51-426f-46d5-9a21-9ae317a6b0bc">
          <documentation>Expiry parameters.

Параметры окончания.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ExposureCalculation" id="c0306bce-2d5b-416d-8c46-24f51f1cb2d3">
          <documentation>Description of the calculation of the amounts representing the risk that needs to be covered, together with the calculation of the existing coverage.


Описание расчета сумм, представляющих риск, который необходимо покрыть, вместе с расчетом существующего покрытия.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ExposureTerm" id="80cd117b-cc63-4af4-b7c9-33fc838a22f8">
          <documentation> Specifies the terms used to calculate a risk exposure and its coverage.

Определяет термины, используемые для расчета риска и его покрытие.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">FATCAStatus" id="40c5a483-576e-44e0-ad41-250012c6b712">
          <documentation> Foreign Account Tax Compliance Act (FATCA) status and the status source of the investor.

Закон О налоговом соответствии иностранных счетов (FATCA) статус и источник статуса инвестора.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">FinancialDocument" id="fdaa0968-3d52-40d7-a01f-20ca5aa3ce4f">
          <documentation> Type of document used in relation with financial transactions.

Тип документа, используемого в отношении финансовых операций.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">FinancialInstitution" id="691d15a0-4ab1-4deb-9a53-592b75fb334f">
          <documentation> Organisation established primarily to provide financial services.

Организация, созданная в первую очередь для предоставления финансовых услуг.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">FinancialInstrumentSwap" id="86ab27ff-9fc1-472a-9d8f-195b08de9054">
          <documentation>Characteristics and conditions by which a borrower can exchange one type of financial instrument for another.

Характеристики и условия, на которых заемщик может обменять один вид финансового инструмента на другой.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">FinancialProduct" id="72783870-82dc-4c6b-9ee4-33737159c63a">
          <documentation> Product offered by a financial institution to its customers.

Продукт, предлагаемый финансовым учреждением своим клиентам.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">FinancialService" id="01391a9c-77ec-4164-b8a3-51ace643bd2f">
          <documentation> Services provided by a financial institution to its clients.

Услуги, предоставляемые финансовым учреждением своим клиентам.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">FinancialTransaction" id="7e6de652-7015-4fc9-8d86-cbccdf11f5a1">
          <documentation> Process which includes the order, the execution, the settlement of trades in the financial domain.

Процесс, который включает в себя ордер, исполнение, урегулирование сделок в финансовой области.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">FinancingRequestorRole" id="9e8f6d5f-8672-47a4-b486-8a8b81e2a50f">
          <documentation> Credit party that requests the invoice financing, on behalf of creditor.

Кредитная сторона, запрашивающая финансирование счета-фактуры от имени кредитора.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">FirstAgentRole" id="03739e67-ba94-41c8-822b-c41517078168">
          <documentation> Organisation offering invoice financing services. 

Организация, предлагающая услуги по финансированию счетов.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">FixingCondition" id="c648f812-bdac-4bb7-a154-20f27ede7092">
          <documentation> Set of parameters used to calculate a rate for instance the fixing rate to be applied to a non-deliverable agreement.

Набор параметров, используемых для расчета ставки, например фиксированной ставки, применяемой к договору, не подлежащему поставке.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ForeignExchangeSwap" id="eaa314a3-37f3-4dfd-b20d-0921d2a8155c">
          <documentation> Combination of two foreign exchange trades, in opposite directions, for different value dates and for the same pair(s) of currencies.

Комбинация двух валютных сделок, в противоположных направлениях, для разных дат валютирования и для одной и той же пары валют.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ForeignExchangeTrade" id="aa5d3dfe-add9-4c57-8d96-c87235d82740">
          <documentation> Agreement between two parties in which one party buys a currency and the other party sells a different currency.

Соглашение между двумя сторонами, в котором одна сторона покупает валюту, а другая сторона продает другой валюте.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ForwardingAgentRole" id="1623df3f-a501-4a8d-9cd4-ba59806f4f26">
          <documentation>Financial institution that receives the instruction from the initiating party and forwards it to the next agent in the payment chain for execution.

Финансовое учреждение, которое получает инструкцию от инициирующей стороны и направляет ее следующему агенту в платежной цепочке для исполнения.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">FundsCashFlow" id="18bf2c29-674c-4d19-ad71-30a55989e37f">
          <documentation> Cash movements from or to a fund as a result of investment funds transactions, for example, subscriptions or redemptions.

Движение денежных средств из фонда или в фонд в результате операций с инвестиционными фондами, например, подписки или погашения.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Garnishment" id="4c5196ae-b95f-4cf8-b2c5-c19f7814a8ad">
          <documentation> Legal process whereby the debtor pays another party than the creditor to settle a debt due by the creditor to that other party.

Правовой процесс, в соответствии с которым должник платит другой стороне, чем кредитор, для погашения задолженности кредитора перед этой другой стороной.



юр. наложение ареста на имущество должника у третьего лица или на суммы, причитающиеся должнику с третьего лица</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">GiverRole" id="2ac28636-7353-4955-9326-43a0f103279d">
          <documentation> Party which provides the collateral. A party can be both a taker and a giver in a collateral relationship.

Сторона, которая предоставляет залог. Сторона может быть как берущей, так и дающей в залоговых отношениях.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">GiveUpClearingFirm" id="759db6ba-dbb5-4a3d-9dcf-63a10bd7469c">
          <documentation> Firm to which the trade is given up (carries the position that results from a trade).

Фирма, которой отдана сделка (занимает позицию, являющуюся результатом сделки).</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Goods" id="27ef2d9e-4e2f-4ae1-ac85-37d63f733124">
          <documentation> Good is a physical product that can be delivered to a purchaser and that involves the transfer of ownership from seller to customer.

Хорошо-это физический продукт, который может быть доставлен покупателю и предполагает передачу права собственности от продавца к покупателю.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">GoodsPartyRole" id="e4877bc5-6718-473d-86e1-562b49394d03">
          <documentation> Role played by a party in the context of handling goods.

Роль партии в контексте обработки товаров.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">GovernanceRules" id="9f46c140-a085-4e5f-9702-71ad547d7cf8">
          <documentation>Rules governing an undertaking such as a guarantee or standby letter of credit.

Правила, регулирующие такие обязательства, как гарантия или резервный аккредитив.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Grantor" id="8a4927a0-15f1-4ff4-ad39-9f3caf7b2157">
          <documentation> Grantor role in the hedge funds industry.


Роль лица, предоставляющего право, в индустрии хедж-фондов.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Guarantee" id="9210d04c-d941-4829-8542-1a734b4fe2fa">
          <documentation> Partial or full coverage of amounts by a party other than the debtor.

Частичное или полное покрытие сумм другой стороной, помимо должника.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">GuaranteeBeneficiary" id="3a21c375-5ac0-417f-b992-67bc98d91095">
          <documentation>Party that is the beneficiary of the guarantee.

Сторона, являющаяся бенефициаром гарантии.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">GuaranteePartyRole" id="2dd92a45-7104-450d-9e8e-802832b28b18">
          <documentation>Role played by a party in the context of guarantees.

Роль стороны в контексте гарантий.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">GuarantorRole" id="b7a434b5-7ef2-4eb3-aac8-c7cceb02c8d6">
          <documentation> Legal entity, other than the issuer, who gives a guarantee. The guarantor becomes liable in case of default.

Юридическое лицо, не являющееся эмитентом, предоставляющее гарантию. Гарант несет ответственность в случае неисполнения обязательств.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">HaircutValuation" id="22a1f154-a3b0-4328-b7bc-4f6957f1f88c">
          <documentation>haircut / стрижка

Basic valuation details of an asset's market value.

Основные детали оценки рыночной стоимости актива.


</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Household" id="33dd515e-8ce0-4c54-a2ea-3f6f3a61f78a">
          <documentation>Specifies the members of a household in relation with the ownership of an account.

Указывает членов домохозяйства в связи с владением учетной записью.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">IdentificationIssuerRole" id="bdb7d7c0-2989-41b3-be17-d4d3708a1ffc">
          <documentation>Entity that assigns the identification.

Сущность, назначающая идентификатор.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">IncentivePremium" id="05168912-08a9-4fe0-a369-fe6a61ca5ea5">
          <documentation> Cash premium made available if the securities holder consents or participates to an event.

Денежная премия предоставляется, если держатель ценных бумаг соглашается или участвует в мероприятии.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Incoterms" id="13598842-ac0b-42e4-9da3-5bfc3d52c29c">
          <documentation>Incoterms / International commercial terms

 International commerce terms are a series of international sales terms, published by International Chamber of Commerce (ICC) and widely used in international commercial transactions. These are accepted by governments, legal authorities and practitioners worldwide for the interpretation of most commonly used terms in international trade. Scope of this is limited to matters relating to rights and obligations of the parties to the contract of sale with respect to the delivery of goods sold. They are used to divide transaction costs and responsibilities between buyer and seller and reflect state-of-the-art transportation practices.

Международные торговые термины-это серия международных торговых терминов, опубликованных Международной Торговой палатой (ICC) и широко используемых в международных коммерческих сделках. Они приняты правительствами, правовыми органами и практиками во всем мире для толкования наиболее часто используемых терминов в международной торговле. Рамки это ограничивается вопросами, связанными с правами и обязанностями сторон договора купли-продажи в отношении поставки проданных товаров. Они используются для разделения трансакционных издержек и ответственности между покупателем и продавцом и отражают современную транспортную практику.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">IndependentAmount" id="b02ba9a6-f13a-486b-a64e-073ef44fd814">
          <documentation> Amount applied as an add-on to the exposure usually intended to cover a possible increase in exposure before the next valuation date.

Сумма, применяемая в качестве дополнения к покрытию_рисокв, обычно предназначенной для покрытия возможного увеличения покрытию_рисокв до следующей даты оценки.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">IndependentAmountTerm" id="4e727456-fa59-4ae7-a08f-91cc04c81fa0">
          <documentation>Defines the specific terms used to calculate an independent amount.

Определяет конкретные термины, используемые для расчета маржевой суммы.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Index" id="8194b6b6-2633-4ab9-95e0-0c7f22f323f3">
          <documentation> Identifies the index.

Определяет индекс.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">IndirectMember" id="80ea0127-92fd-4cfb-9028-d1692b4a5bfd">
          <documentation> Financial institution or member of a system having limited rights to the system specifications.

Финансовое учреждение или участник системы, имеющие ограниченные права на спецификации системы.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">IndividualInvestor" id="8b5c7716-8ab4-4816-a23b-37eed063fdbf">
          <documentation> Individual person which makes investment decisions in relation with its investment account.

Физическое лицо, которое принимает инвестиционные решения в отношении своего инвестиционного счета.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">IndividualPayment" id="3982e7a5-48f4-4ff4-a709-12010cdceaa6">
          <documentation> Payment which consists of one single transaction. This payment may be grouped with other similar payments to form a bulk payment.

Платеж, состоящий из одной транзакции. Этот платеж может быть сгруппирован с другими аналогичными платежами, чтобы сформировать массовый платеж.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">InformationPartyRole" id="7ef0e06d-2dd7-4678-a182-80e11c89bd91">
          <documentation> Role played by a party as source of information.

Роль стороны как источника информации.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">InitiatingPartyRole" id="3e3ba55b-d5cb-43f6-a74e-e29491c79c49">
          <documentation> Party initiating the payment to an agent. In the payment context, this can either be the debtor (in a credit transfer), the creditor (in a direct debit), or a party that initiates the payment on behalf of the debtor or creditor. In the context of treasury, the party that instructs the trading party to execute a treasury deal on its behalf.

Сторона, инициирующая платеж агенту. В контексте платежа это может быть либо должник (при передаче кредита), кредитор (при прямом дебете), либо сторона, которая инициирует платеж от имени должника или кредитора. В контексте казначейства - сторона, которая поручает Торговой стороне совершить казначейскую сделку от ее имени.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Instalment" id="1b82e837-77e9-4e66-9c53-28056fc7746f">
          <documentation> Specifies the details of each successive payment in settlement of a debt or in an investment plan.

 Определяет детали каждого последующего погашения должником в инвестиционный план.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">InstructedAgentRole" id="19d6a422-ebd2-47eb-b6af-3f0afbbbdc37">
          <documentation> Agent that is instructed by the previous party in the chain to carry out the (set of) instruction(s).

Агент, которому предыдущая сторона в цепочке поручила выполнить (набор) инструкций(инструкций).</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">InstructedReimbursementAgent" id="55eaee58-bca0-4c57-b291-f509ba45ecbb">
          <documentation>Agent at which the instructed agent will be reimbursed.
Usage: If the instructing and instructed agents have the same reimbursement agent, then only InstructedReimbursementAgent is not allowed.
Usage: If InstructedReimbursementAgent contains a branch of the instructed agent, then the instructed agent will claim reimbursement from that branch/will be paid by that branch.


Агент, на котором поручил агенту возмещаются.
Использование: если инструктирующие и проинструктированные агенты имеют один и тот же агент возмещения, то только InstructedReimbursementAgent не допускается.
Использование: если InstructedReimbursementAgent содержит филиал уполномоченного агента, то уполномоченный агент будет требовать возмещения из этого филиала / будет оплачен этим филиалом.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">InstructingAgentRole" id="c0132274-2836-4ed5-9e94-4041feb6d377">
          <documentation>Agent that instructs the next party in the chain to carry out the (set of) instruction(s).

Агент, который поручает следующей стороне в цепочке выполнить(набор) инструкций (инструкций).</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">InstructingReimbursementAgent" id="ddbf3be1-b2a9-473f-b1ba-eaa61e288553">
          <documentation> Specifies the agent through which the instructing agent will reimburse the instructed agent.
Usage: If the instructing and instructed agents have the same reimbursement agent, then only InstructingReimbursementAgent must be used.

Указывает агент, через которого инструктирующий агент возместит расходы указанному агенту.
Использование: если инструктирующие и проинструктированные агенты имеют один и тот же агент возмещения, необходимо использовать только InstructingReimbursementAgent.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">InstructionForMeeting" id="2f0a30f1-4c74-49bc-a3ac-6a05b88169a3">
          <documentation> Identifies the position of the instructing party and the actions that it wants to take in relation with the meeting.

Определяет позицию инструктирующей стороны и действия, которые она хочет предпринять в связи со встречей.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">InsuranceCertificate" id="546d868a-d9fd-4bbe-ae2d-e0d278fa3e2d">
          <documentation> Formal document used to record a fact and used as proof of the fact that goods have been insured under an insurance policy.

Формальный документ, используемый для фиксации факта и используемый как доказательство того, что товар был застрахован по страховому полису.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">InsurancePartyRole" id="e992384a-e045-4afd-8028-7c1c932bc401">
          <documentation>Role played by a party in the context of insurance.

Роль стороны в контексте страхования.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Insurer" id="6c004ab7-f665-482c-8e08-043ed19700cb">
          <documentation> Insurance company that issues a particular insurance policy to an assured party.

Страховая компания, которая выдает конкретный страховой полис застрахованной стороне.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Interest" id="07d8ddc8-8f2a-432f-bcfe-3fe41344505b">
          <documentation> Consideration, such as amount of money, paid or received in exchange for an asset that has been invested, loaned or borrowed for a certain period. The interest is expressed as a fixed amount or percentage of the amount upon which the interest is applied.

Вознаграждение, например денежная сумма, уплаченная или полученная в обмен на актив, который был инвестирован, одолжен или заимствован на определенный период. Проценты выражаются в виде фиксированной суммы или процента от суммы, на которую начисляются проценты.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">InterestCalculation" id="01df7b3b-4c0e-4fae-bbd9-c433ebc2ffca">
          <documentation> Set of parameters used to calculate an interest amount.

Набор параметров, используемых для расчета суммы Вознаграждения.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">InterestManagement" id="6fe2debd-56e7-42c6-bf17-a02730d2d3ce">
          <documentation> Management of interest which consists into calculating the interest, requesting its payment or distributing the interest proceeds.

Управление процентами, которое заключается в начислении процентов, запросе их выплаты или распределении  вознаграждений _дохода.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">IntermediaryAgentRole" id="3b0dd50e-d982-4070-89fc-729fe1fd82aa">
          <documentation> Agent between the debtor's agent and the creditor's agent. There can be several intermediary agents specified for the execution of a payment.

Агентом между агентом должника и представителя кредитора. Для осуществления платежа может быть указано несколько посредников.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">IntermediaryRole" id="06160d50-4b2c-4609-9cf1-f5daecdcad1e">
          <documentation> Party that provides services relating to financial products to investors, for example, advice on products and placement of orders.

Сторона, предоставляющая инвесторам услуги, связанные с финансовыми продуктами, например, консультирование по продуктам и размещение заказов.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">IntraPositionTransfer" id="ced647f6-7165-4a46-a536-c6cb8d822cb6">
          <documentation>Transfer of securities from one sub-balance to another or from one balance status to another.

Перевод ценных бумаг из одной суб-баланса к другой или от одного состояния равновесия к другому.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">IntroducingFirm" id="8e077fa3-0d5e-4753-b2d0-0db7cb2b7a7d">
          <documentation> Party (broker or other intermediary) that owns the relationship with the investor. It can relay an order directly to the trading floor, or give clients direct access to the floor.

Сторона (брокер или иной посредник), которой принадлежат отношения с инвестором. Он может передавать ордер непосредственно в торговую площадку или предоставлять клиентам прямой доступ к площадке.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">InvestigationCase" id="914307de-65cf-47fa-a5e3-fe3c7ee1b6d2">
          <documentation> Set of activities performed to handle an exception to a normal transaction flow.

Набор действий, выполняемых для обработки исключения из нормального потока транзакций.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">InvestigationCaseStatus" id="b1db48fe-317b-464c-942a-7f3ebdcaa2b8">
          <documentation> Status of an investigation case.

Статус следственного дела.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">InvestigationPartyRole" id="19a14932-8be5-4058-a726-b3f46032f103">
          <documentation>Role played by a party in the context of an investigation process.

Роль партии в контексте процесса расследования.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">InvestigationResolution" id="b2bf39d4-1cd3-4859-bab2-6d67dcea0e07">
          <documentation> Specifies the actions taken as a result of an investigation.

Указывает действия, предпринятые в результате расследования.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">InvestmentAccount" id="deb53200-9ee7-4d79-a46b-c5742d161523">
          <documentation> Account between an investor(s) and a fund manager or a fund. The account can contain holdings in any investment fund or investment fund class managed (or distributed) by the fund manager, within the same fund family.

Счет между инвестором(инвесторами) и управляющим фондом или Фондом. Счет может содержать средства в любом инвестиционном фонде или классе инвестиционных фондов, управляемых (или распределяемых) управляющим фондом в рамках одной семьи фондов.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">InvestmentAccountContract" id="30eaf244-052f-42b9-9b08-817a38141f5d">
          <documentation> Contract defining the related investment account.

Договор, определяющий соответствующий инвестиционный счет.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">InvestmentAccountPartyRole" id="1013d161-ddd4-41af-bea0-6f4d5d6e1541">
          <documentation>Specifies roles played by a party that are related to an investment account.

Определяет роли, которые играет сторона, связанная с инвестиционным счетом.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">InvestmentAccountService" id="b6556f3a-a910-4687-ac1e-2d2a9917148f">
          <documentation> Services linked to an account which are available to the account owner or to the holder of a mandate. The exercise of these services may be submitted to a limit.

Услуги, связанные со счетом, которые доступны владельцу счета или держателю мандата. Осуществление этих услуг может быть ограничено.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">InvestmentFund" id="0730dfdf-d61f-477d-90f8-f8dd00982205">
          <documentation> Distinct pool of financial instruments managed by a single investment policy. May or not be part of an umbrella fund. The pool is issued in at least one investment fund class.

Отдельный пул финансовых инструментов, управляемый единой инвестиционной политикой. Может быть или не быть частью зонтичного фонда. Пул выпускается как минимум в одном классе инвестиционных фондов.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">InvestmentFundFamily" id="0f583966-bccf-4eca-b934-54fa2661e66b">
          <documentation> Group of investment funds under the same fund management company.

Группа инвестиционных фондов под управлением одной управляющей компании.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">InvestmentFundOrder" id="e113d06f-201a-4262-bc94-2b644b3d00ed">
          <documentation> An investor's instruction to either subscribe or redeem an amount of money or its equivalent, for example other assets, into or out of an investment fund.

Распоряжение инвестора о подписке или выкупе суммы денег или ее эквивалента, например, других активов, в инвестиционный фонд или из него.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">InvestmentFundOrderExecution" id="cd24f6a1-ce65-4bac-89a7-53beb9250d24">
          <documentation>Creation/cancellation of investment units on the books of the fund or its designated agent, as a result of executing an investment fund order.

Создание / аннулирование инвестиционных паев, находящихся на балансе фонда или его уполномоченного агента, в результате исполнения распоряжения инвестиционного фонда.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">InvestmentFundPartyRole" id="0d74f31c-45a7-4c04-ba68-29bbd2d8566a">
          <documentation> Specifies roles played by a party that are linked to the handling of investment funds but not related to a specific process.

Определяет роли стороны, связанные с управлением инвестиционными фондами, но не связанные с конкретным процессом.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">InvestmentFundTax" id="f7390e57-88d4-4b24-a35e-f5f68f6c5aed">
          <documentation>Tax related to an investment fund order.

Налог, связанный с распоряжением инвестиционного фонда.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">InvestmentFundTransaction" id="52209485-e1a0-4e7d-a5da-bf1f0cc765f4">
          <documentation> Process of buying, selling, switching or transferring fund units.

Процесс покупки, продажи, переключения или передачи паев фонда.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">InvestmentPlan" id="b70303c1-ad08-4877-83e4-db8cdcf69a5f">
          <documentation> Plan that allows investors to schedule periodical investments or divestments, according to pre-defined criteria.

 План, который позволяет инвесторам планировать периодические инвестиции или сделки, в соответствии с предопределенными критериями.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Investor" id="f591e863-ef7b-489d-aa97-6699d6cd1682">
          <documentation> Party which makes investment decisions in relation with its investment account.

Сторона, которая принимает инвестиционные решения в отношении своего инвестиционного счета.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">InvestorRole" id="9b286ca9-7d68-409b-85f7-eeb7800b4e01">
          <documentation> Party that makes investment decisions. Identifies the beneficiary or its broker.

Сторона, которая принимает инвестиционные решения. Идентифицирует получателя или брокера.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Invoice" id="6f9f8e41-4141-49cd-bb5f-ade792a6e4f9">
          <documentation> General information about an invoice, such as number, issue date date and monetary amounts.

Общие сведения о накладной, такие как номер, дата выпуска и денежные суммы.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">InvoiceeRole" id="63ea8c81-9f3a-493f-ba50-88ee909c96b5">
          <documentation> Party identified as the liable party on the face of a commercial invoice.

Сторона, идентифицированная как ответственная сторона на лицевой стороне коммерческого счета.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">InvoiceFinancingAgreement" id="dd6aac1b-622c-4b3a-a8c5-d9b49cac5777">
          <documentation>Set of characteristics that unambiguously identify an invoice financing agreement. An invoice financing agreement between a factor and its client allows to transfer a payment obligation that exists between the client and a third party from the client to the factor.

Набор характеристик, однозначно идентифицирующих договор финансирования по накладной. Договор финансирования счета-фактуры между фактором и его клиентом позволяет передать фактору платежное обязательство, существующее между клиентом и третьим лицом.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">InvoiceFinancingPartyRole" id="3bd18ac7-4ea6-4745-b464-23147dc07afd">
          <documentation> Role played by a party in the context of financing an invoice.

Роль партии в контексте финансирования счета-фактуры.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">InvoiceFinancingStatus" id="9b48cef6-576a-4f76-be94-b6b899d27f4e">
          <documentation> Status of an invoice financing transaction and of the instructions related to the invoice financing.

Состояние проводки финансирования накладной и инструкций, связанных с финансированием накладной.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">InvoicePartyRole" id="b2f378da-6b76-41f3-90a8-d791c2e99db1">
          <documentation> Role played by a party in the context of an invoice.

Роль партии в контексте счета-фактуры.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">InvoicerRole" id="d35887d1-5cd3-4961-a0aa-bae822b22ee9">
          <documentation> Party identified as the liable party on the face of a commercial invoice.

Сторона, идентифицированная как ответственная сторона на лицевой стороне коммерческого счета.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">InvoiceStatus" id="7a122a6c-7cc9-4b48-9d01-28784c909605">
          <documentation> Status of the invoice or of the billing process.

Состояние счета или процесса выставления счетов.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">IssuerRole" id="da3bc03c-92c9-4265-8cf3-6542c5416a3a">
          <documentation> Legal entity that has the right to issue securities.

Юридическое лицо, имеющее право выпуска ценных бумаг.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">JointOwner" id="526c666d-41fe-481f-a5a0-e0ca7aefd5c7">
          <documentation>Co-owner of an investment account when the ownership is assigned to more than one party.

Совладелец инвестиционного счета, если право собственности принадлежит более чем одной стороне.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Jurisdiction" id="d5dc9a24-04f7-4a19-8c09-79f0bdb74eae">
          <documentation> Specifies the jurisdiction (country, county, state, province, city).

Определяет юрисдикцию (страна, округ, штат, провинция, город).</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Leg" id="a2774924-9914-4580-b091-369ad8400712">
          <documentation> Separate transactions which combined together form a trade.

Отдельные сделки, которые объединяются вместе, образуют сделку.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Lender" id="4f57d3a0-8551-4fa8-9c5f-7b4fe7da041c">
          <documentation> Party that has accepted under specific requirements to provide a monetary or securities loan to a borrower.

Сторона, которая согласилась в соответствии с конкретными требованиями предоставить заемщику денежный кредит или кредит под ценные бумаги.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">LetterOfCredit" id="f3c872aa-fca8-4040-98b5-6d65c471910b">
          <documentation>Instrument issued by a bank substituting its name and credit standing for that of its customer. A letter of credit is a written undertaking of the bank, issued for the account of a customer (the applicant), to honour a demand for payment, upon the beneficiary's compliance with the terms and conditions set forth in the undertaking.

Документ, выпущенный банком, заменяющий его наименование и кредитоспособность на имя его клиента. Аккредитив-это письменное обязательство банка, выданное за счет клиента (заявителя), выполнить платежное требование, при соблюдении бенефициаром условий, изложенных в обязательстве.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Limit" id="575d8760-905c-40fe-b22b-e373e7ed02a5">
          <documentation> Value used for risk containment in a system or towards counterparts. The limit may be a current limit or a default limit.

Значение, используемое для сдерживания риска в системе или по отношению к аналогам. Пределом может быть текущий предел или предел по умолчанию.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">LimitStatus" id="d0efa88c-8795-4100-9d30-6efe8290003a">
          <documentation> Current status of the limit.

Текущее состояние лимита.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">LineItem" id="ca332a96-bc6b-4760-afef-a8908e06cd1c">
          <documentation> Unit of information showing the related provision of products and/or services and monetary summations reported as a discrete line item.

Единица информации, показывающая соответствующее предоставление продуктов и / или услуг и денежные суммирования, представленные в виде отдельной позиции.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Liquidity" id="b0e32485-6b4d-430c-ab9d-4ac3fa058b5c">
          <documentation>Ability of a financial instrument to be easily traded and converted to cash, at conditions that do not affect its price.

Способность финансового инструмента быть легко проданы и конвертированы в наличные деньги, в условиях, которые не влияют на его цену.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">LiquidityManagementLimit" id="0ebdffda-d350-4153-869b-cf72d6def0c1">
          <documentation> Cash management feature limiting the amount of liquidity needed to perform clearing and settlement operations. At any point in time during the process, the limit imposes the maximum amount of liquidity available for operations concerning the system or other managed elements, for example, transaction amount or counterparty.

Функция управления денежными средствами ограничивает объем ликвидности, необходимый для осуществления клиринговых и расчетных операций. В любой момент времени в ходе процесса лимит накладывает максимальный объем ликвидности, доступный для операций, касающихся системы или других управляемых элементов, например, суммы сделки или контрагента.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ListTrading" id="9141ae2d-ccac-4f9e-9462-004860834264">
          <documentation> Provides the details for negotiating and trading a large number of securities contained in or comprising a portfolio. One example is index arbitrage, which consists in the purchase or sale of a basket of stocks in conjunction with the sale or purchase of a derivative product (for example index futures) to profit from price differences between the basket and the derivative product. Other examples include liquidation of EFP (Exchange for Physical) stock positions, portfolio realignment and portfolio liquidation.

Предоставляет подробную информацию для ведения переговоров и торговли большим количеством ценных бумаг, содержащихся в портфеле или входящих в него. Одним из примеров является арбитраж индексов, который заключается в покупке или продаже корзины акций в сочетании с продажей или покупкой производного продукта (например, фьючерсов на индексы) для получения прибыли от разницы в ценах между корзиной и производным продуктом. Другие примеры включают ликвидацию позиций EFP (Exchange for Physical), реорганизацию портфеля и ликвидацию портфеля.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Loan" id="dc0bc38e-1ac2-4d0b-b65c-fecc23847480">
          <documentation> Act of provding an amount of money, a property or other material goods to a another party in exchange for future repayment of the principal amount along with interest or other finance charges.

Акт передачи денежной суммы, имущества или других материальных ценностей другой стороне в обмен на будущее погашение основной суммы вместе с процентами или другими финансовыми расходами.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">LocalBroker" id="937b55ba-60ff-4982-b351-0ab408f6303e">
          <documentation>Party paid a commission following the execution of a trade, as directed by the investment manager.

Сторона выплатила комиссию после заключения сделки по указанию управляющего инвестициями.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">LocalDepositoryRole" id="f507facf-21af-4742-a1b3-64af4a0af224">
          <documentation>Place where securities are deposited, that is company, bank or institution that holds and facilitates the exchange of securities at a local/national level.

Место, где депонируются ценные бумаги, то есть компания, банк или учреждение, которое держит и облегчает обмен ценными бумагами на местном/национальном уровне.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">LocalSettlementAgentRole" id="bd2eace0-06c6-4198-a88d-9ad1f4fac9e5">
          <documentation> Party which holds securities and settles trades for non-resident customers. The customers' securities are held in one omnibus account or in sub accounts at the local central securities depository.

Сторона, владеющая ценными бумагами и осуществляющая расчеты по сделкам с клиентами-нерезидентами. Ценные бумаги клиента хранятся на одном счете или на счетах в местных центрального депозитария.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Location" id="34269625-bb25-4f6c-8881-2e3d4d9e7936">
          <documentation>Specifies a place.

Указывает место.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">LotBreakdown" id="b8e5f5be-5986-4fcf-aa7e-58aeb94b99fd">
          <documentation> Number of securities purchased or sold in one transaction. In terms of options, a lot represents the number of contracts contained in one derivative security.

Количество ценных бумаг, купленных или проданных за одну сделку. С точки зрения опционов, лот представляет собой количество контрактов, содержащихся в одной производной ценной бумаге.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Lottery" id="7efa9952-2511-4cdc-a548-ab04ffba69c9">
          <documentation> The parameters required to manage the organisation of a lottery.

Параметры, необходимые для управления организацией лотереи.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">MailingInstructions" id="ac8c9cbf-00c2-471f-8f5b-4d500d1b698f">
          <documentation> Characteristics of an address.

Характеристики адреса.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ManagedAccountProduct" id="d1298f4c-0700-4b07-bfb8-ad733c37a39b">
          <documentation>Product which provides guidance to investors to manage their portfolios.

Продукт, который предоставляет рекомендации инвесторам по управлению их портфелями.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Mandate" id="fc40ab85-8316-4191-91ea-c5e7bf9e5c9f">
          <documentation>Authorisation given by an issuing party to a holder party to act on the issuer's behalf.

Разрешение, предоставленное стороной-эмитентом стороне-держателю, действовать от имени эмитента.


mandate / полномочие действовать от имени
MandateHolder / уполномоченное лицо</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">MandateHolder" id="0a0c7ad7-51c3-4c24-879f-4effc9424e96">
          <documentation> Entity that was given by another entity the authority to act on its behalf.

Субъект, которому другой субъект предоставил полномочия действовать от его имени.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">MandateIssuer" id="5b1cdce2-bb37-459b-9921-02fbdbd533c4">
          <documentation> Issuer of the mandate.

Издатель мандата.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">MandatePartyRole" id="baebe163-ed67-4174-802f-2bc95f3ed938">
          <documentation> Role played by a party in the context of a mandate.

Роль партии в контексте мандата.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">MandateStatus" id="239dd4af-f07f-42b8-9c14-f6b71877ddee">
          <documentation> Specifies whether a mandate is accepted or rejected.

Указывает, принимается или отклоняется мандат.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">MandatoryCorporateAction" id="4a4d937a-6b48-4567-b55b-80bf3451e3b1">
          <documentation>Corporate action that will result in only one possibility for account holders. The shareholder is just a passive beneficiary of these actions.



Корпоративное действие, которое приведет только к одной возможности для владельцев счетов. Акционер является лишь пассивным бенефициаром этих действий.


mandate / полномочие действовать от имени</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Manufacturer" id="265cb6d5-073d-4f7a-a920-d0a0bb9db58b">
          <documentation>Manufacturer of the goods.

Производитель товара.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">MarginAmountRequirement" id="93208446-1de4-4dad-b494-09f5723cdc62">
          <documentation> Amount of expected margin required by any of the parties of the margin calculation.

Сумма ожидаемой маржи, требуемой любой из сторон расчета маржи.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">MarginCall" id="5a1bbd7c-2678-43d4-b2eb-362ee905c64d">
          <documentation> Specifies the calculation and the resulting margin and independent amount needed to cover the risk exposure of one party versus another.

Определяет расчет и полученную маржу и независимую сумму, необходимые для покрытия риска одной стороны по сравнению с другой.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Market" id="4fb18203-b944-4523-8a56-34379c8c9f37">
          <documentation> Context or geographic environment in which trading parties execute trades.

Контекст или географическая среда, в которой торговые стороны осуществляют сделки.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">MarketClaim" id="ea1f08d2-f7f1-4740-a61b-1bbf139526d0">
          <documentation> Processes that reallocate corporate action proceeds to the entitled party and that compensate financial penalties or indirect costs due to late delivery or payment.

Процессы, которые перераспределяют корпоративные действия, переходят к правомочной стороне и компенсируют финансовые штрафы или косвенные расходы из-за несвоевременной поставки или оплаты.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">MarketClaimCounterparty" id="1e8ba095-6fa5-479c-b1e7-5b9e2acce286">
          <documentation> Party that has reimbursed the account owner with funds to which they were legally entitled.

Сторона, которая возместила владельцу счета денежные средства, на которые он имел законное право.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">MarketInfrastructure" id="7e038eb5-bd23-41ba-bb46-9715da9e7048">
          <documentation> Multilateral system among participating institutions, including the operator of the system, used for the purposes of clearing, settling, or recording payments, securities, derivatives or other financial transactions.

Многосторонней системы, среди участвующих учреждений, включая оператора системы, которая используется для клиринга, расчетов или учета платежей, ценных бумаг, деривативов или других финансовых операций.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">MasterAgreement" id="991cd39a-752e-4899-89ab-f1e268d66285">
          <documentation>Agreement which defines the framework of a contract between two trading parties in different domains such as collateral, derivatives, trade..


Соглашение, которое определяет рамки договора между двумя торговыми сторонами в различных областях, таких как обеспечение, деривативы, торговля..</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">MatchingSystem" id="71b44268-435a-44d4-8296-4aba47d29112">
          <documentation> System which compares two sets of data and provides the comparison result to its users.

Система, которая сравнивает два набора данных и предоставляет результат сравнения своим пользователям.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Meeting" id="dbf7866d-f811-4c98-84a7-a76d48f0512e">
          <documentation>Specifies the physical parameters of a general meeting. Several dates and places can be defined for a meeting.

Задает физические параметры общего собрания. Для встречи можно определить несколько дат и мест.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">MeetingAttendance" id="5c4895ef-a71e-4a4f-86f0-38fd75202928">
          <documentation> Information on the participation of the security holder or of its assigned representative.

Информация об участии держателя обеспечения или его уполномоченного представителя.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">MeetingAttendeeRole" id="1f75d557-a2ba-47c4-84d0-e3319a143a07">
          <documentation> Security holder who will attend and vote at the meeting in person and/or a person assigned by the security holder to attend the meeting without having any voting rights or taking any action.

Владелец ценной бумаги, который будет присутствовать и голосовать на собрании лично и / или лицо, назначенное владельцем ценной бумаги для участия в собрании без права голоса или принятия каких-либо действий.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">MeetingDeadline" id="d8bb5f77-4ce1-4d60-b544-7edb7100cdf7">
          <documentation>Specifies the different deadlines available for the different processes related to meeting attendance, proxy voting and entitlement assessment.

Определяет разные сроки для различных процессов, связанных с посещаемость собрания, голосования и оценок права.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">MeetingEntitlement" id="d999b32a-b66f-49aa-a2bd-b4b216a48fe1">
          <documentation>Notification of the entitlement that one party has in relation with a specific meeting.

Уведомление о праве, которое одна сторона имеет в связи с конкретным совещанием.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">MeetingInitiatorRole" id="56dbea68-3139-428f-bc78-bfc0d41ad42d">
          <documentation> Specifies a party, other than the issuer, that requested that the meeting take place. It may be a court of justice or an association of security holders.

Указывает сторону, отличную от издателя, которая запросила проведение собрания. Это может быть суд или ассоциация владельцев ценных бумаг.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">MeetingParticipation" id="c67598fa-95d1-47c5-b5e9-32b5b3571a92">
          <documentation>Specifies the number of voting rights and of outstanding securities.

Определяет количество прав голоса и находящихся в обращении ценных бумаг.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">MeetingParticipationRegistrationDeadline" id="2e72c697-a7d6-4b76-8e68-72848b2246bc">
          <documentation>Date and time by which the beneficial owner or agent must notify of their intention to participate in the meeting process in order to be allowed to participate in the meeting event.

Дата и время, к которым бенефициарный владелец или агент должен уведомить о своем намерении участвовать в процессе собрания, чтобы иметь возможность участвовать в мероприятии собрания.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">MeetingPartyRole" id="5c31c7d9-212a-4ffc-8d54-bf004b64108e">
          <documentation>Role played by a party in the context of a meeting.

Роль партии в контексте встречи.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">MeetingResultDissemination" id="df309187-da74-4a48-8964-b31fe45abc65">
          <documentation> Provides information on the voting results of a shareholders meeting.

Предоставляет информацию об итогах голосования на собрании акционеров.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">MeetingServicing" id="7a3fdd82-3c58-4ffb-a81b-832f86c0dcc6">
          <documentation>Services which consists in notifying the investor or its agent of a meeting, in validating and relaying its instructions and in calculating its entitlement based on its holdings.

Услуги, которые заключаются в уведомлении инвестора или его агента о встрече, в проверке и ретрансляции его инструкций и в расчете его прав на основе его холдингов.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">MeetingStatus" id="57e00835-47ba-4570-8d1e-c9d0c44852c5">
          <documentation> Status of the instructions related to a meeting.

Состояние инструкций, связанных со встречей.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">MeetingStatusReason" id="aebda9ff-8b01-40f6-91a0-7f6b9a6d8e40">
          <documentation>Specifies the underlying reason for a status of a meeting or related instructions.

Указывает основную причину состояния собрания или связанных инструкций.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">MerchantRole" id="b5d96672-8fe5-4adc-b84c-21e20a703d0c">
          <documentation>Party performing the card payment transaction.

Сторона, осуществляющая платеж картой.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ModelForm" id="8d314a57-e28d-4057-9689-fdaa7cf35a60">
          <documentation>Identification of a model form.

Идентификация типовой формы.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Money" id="ec1fac53-8e97-4f1c-b017-59ca8cb8f5dd">
          <documentation>Currency (banknotes and coins) and demand deposits or 'bank money' (the balance held in checking accounts and savings accounts).

Валюта (банкноты и монеты) и депозиты до востребования или &quot;банковские деньги&quot; (остаток на расчетных и сберегательных счетах).</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Negotiation" id="3265e0d3-f035-4a97-afce-01fe9da6750e">
          <documentation>Decision making on the transfer of a financial instrument.

Принятие решения о передаче финансового инструмента.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Netting" id="cd122b38-4c05-4dd7-a275-0d7d7c7620a5">
          <documentation>Offset of payables against receivables to reduce credit exposure to a counterparty.

Взаимозачет кредиторской задолженности с дебиторской задолженностью для уменьшения кредитного риска контрагенту.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">NetworkAccess" id="553018b1-5d3b-4a22-9215-afd43eeed16d">
          <documentation>Parameters used to access a network.

Параметры, используемые для доступа к сети.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Nominee" id="aef0b439-5627-4276-87e2-7220d3e42a84">
          <documentation>Entity (the registered owner) named by the beneficial owner to act on its behalf, often to facilitate dealing, or to conceal the identity of the beneficiary. Securities and other assets are recorded in the nominee's name.

Юридическое лицо (зарегистрированный владелец) назван бенефициарным владельцем действовать от его имени, часто для облегчения сделок, или скрыть личность бенефициара. Ценные бумаги и другие активы отражаются на имя номинального держателя.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">NonClearingMemberRole" id="9d4c90c9-fc48-4ba3-a4d2-6155f2c85333">
          <documentation> Party that is involved in a trade but which must clear the trade through a member of an exchange's clearing corporation.

Сторона, которая участвует в торговле, но которая должна очистить торговлю через члена клиринговой корпорации биржи.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">NonDeliverableTrade" id="666a5917-12d2-4d47-af4f-700c8df2714f">
          <documentation> Foreign exchange contract where one of the exchanged amounts is specified in a non-deliverable currency.

Валютный контракт, в котором одна из обменных сумм указана в валюте, не подлежащей поставке.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">NonDisclosedListTrading" id="8f6e23a9-3ee8-43bd-a923-13504cdf370a">
          <documentation> List trading by which the buy-side provides details to the sell-side information about the sector, country, index and potential market impact of the financial instrument to be bought or sold. Using this information, the sell-side firms bid for the trade.

Список торговых операций, с помощью которых buy-side предоставляет подробную информацию sell-side о секторе, стране, индексе и потенциальном рыночном влиянии финансового инструмента, который будет куплен или продан. Используя эту информацию, фирмы продающей стороны предлагают цену для торговли.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">NonFinancialInstitution" id="9c66e9b9-29b5-4cad-9a27-69edd1f6cc2f">
          <documentation>An organisation primarily established to offer and perform services other than financial services.

Организация, созданная в первую очередь для предоставления и выполнения услуг, отличных от финансовых услуг.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">NotificationReceiver" id="f572ce90-f3dc-4955-9b8a-575ce244771f">
          <documentation> Identifies the party (to be) notified of the content of a document.

Определяет сторону (подлежащую) уведомлению о содержании документа.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">NotifyingParty" id="0c2d37ff-a37b-4251-90b6-f2bf79ad49c4">
          <documentation> Identifies the party that notifies the content of a document to a third party.

Определяет сторону, которая уведомляет о содержимом документа третью сторону.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Novation" id="48016b4c-64a4-4b90-b6ce-a9542a6460c8">
          <documentation> Act of either replacing an obligation to perform with a new obligation, or replacing a party to an agreement with a new party.

Акт либо замены обязательства по исполнению новым обязательством, либо замены стороны соглашения с новой стороной.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Obligation" id="e7bf00cc-d2ca-4ee6-82e2-55e5eb3ac586">
          <documentation> Specifies the assets (quantity of securities, goods, services, and cash amounts) that have to be delivered.

Указывает активы (количество ценных бумаг, товаров, услуг и суммы денежных средств), которые должны быть поставлены.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ObligationFulfilment" id="21d3ead5-f71f-4fa5-ad7b-31782b6b5ee5">
          <documentation>Processes by which an obligation is extinguished fully or partially.

Процессы полного или частичного погашения обязательства.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ObligorBank" id="9c820cbd-af74-4591-8932-6b8439a67cb2">
          <documentation> Bank that has to pay under a payment obligation contracted between two financial institutions related to the financing of a commercial transaction.

Банк, который должен платить по платежному обязательству, заключенному между двумя финансовыми учреждениями, связанному с финансированием коммерческой сделки.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">OperationThreshold" id="776ed24b-9dab-4949-89d5-2497263d87e6">
          <documentation>Threshold related to a bank account operation.

Порог, связанный с операцией банковского счета.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Order" id="c2f830b0-e80a-4edd-bdc8-d45e957dbd1d">
          <documentation>Order placed by an investor to buy or sell an asset at a price specified or not.

Заказ инвестора на покупку или продажу актива по указанной или нет цене.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">OrderBook" id="9e6f097c-a99b-4644-b0f3-12977328d5b1">
          <documentation>Record of orders to buy and sell a financial instrument.

Запись ордеров на покупку и продажу финансового инструмента.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">OrderOriginationFirm" id="dfd53d26-c8c9-4f94-939a-339510a53283">
          <documentation>Firm that originates or submits the original order for execution.

Фирма, которая берет начало или подает первоначальный заказ на исполнение.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">OrderOriginationTrader" id="a5255d9b-2d98-4afe-94e5-2af79a41be99">
          <documentation> Identifies the trader at the order origination firm that submitted the order.

Определяет трейдера на возникновение  заказа, представивших заявки.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Organisation" id="b9d65f0d-d66c-4b10-bd2d-6af90fcfa643">
          <documentation>Organised structure that is set up for a particular purpose. For example, a business, government body, department, charity, or financial institution.

Организованная структура, созданная для определенной цели. Например, бизнес, государственный орган, департамент, благотворительная организация или финансовое учреждение.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">OrganisationHierarchy" id="be602bf4-347f-45c4-959a-cbf91cbcca0d">
          <documentation>Description of the structure of a company.

Описание структуры компании.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">OrganisationIdentification" id="e8e34e5d-c975-46f4-9526-aa7df620b201">
          <documentation>Unique and unambiguous way to identify an organisation.

Уникальный и однозначный способ идентификации организации.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">OrganisationName" id="a68fcc3f-f5b1-4d77-ba49-54d059d532e3">
          <documentation>Name by which an organisation is known and which is usually used to identify that organisation.

Название, по которому известна организация и которое обычно используется для идентификации этой организации.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Packaging" id="b8444739-27cd-4eb6-ac69-455e358f9abe">
          <documentation> Physical packaging of goods for transport.

Физическая упаковка грузов для транспортировки.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">PairOff" id="b0086ae8-bfe2-48cf-9691-ae7064381994">
          <documentation> Transaction is paired off and netted against one or more previous transactions.

Сделка на пары и в сочетании с одним или более предыдущих сделок.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Party" id="1ab00726-8f82-47e7-9693-ded8ea05ca32">
          <documentation>Entity involved in an activity.

Субъект, участвующий в деятельности.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">PartyIdentificationInformation" id="599aac06-426e-4780-aec3-858e8e7def19">
          <documentation>Unique and unambiguous way to identify a party

Уникальный и однозначный способ идентификации стороны</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">PartyName" id="789e8d3b-871b-4102-918f-f97e0fb0be6a">
          <documentation> Name by which a party is known and which is usually used to identify that party.

Название, по которому известна сторона и которое обычно используется для идентификации этой стороны.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Payee" id="8f682eaa-3f39-4136-b742-bb424e03824b">
          <documentation>Party to which a cheque is made payable.

Сторона, которой выплачивается чек.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Payment" id="04814e71-ba1c-4b96-99ad-0760309d4a92">
          <documentation> Payment information and processes required to transfer cash end to end from the debtor to the creditor.

Платежная информация и процессы, необходимые для передачи денежных средств от должника к кредитору.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">PaymentCard" id="a19f3120-4550-4c60-84b6-dbcf5af6ac48">
          <documentation> Electronic money product that provides the cardholder with a portable and specialised computer device that typically contains a microprocessor.

Электронные деньги продукт, который предоставляет держателю карты с портативным и специализированным компьютерным устройством, которое обычно содержит микропроцессор.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">PaymentExecution" id="7feb2700-32f4-4435-ba86-6bc986fd1740">
          <documentation> Process required for executing an end to end payment. It consists of a payment initiation which may be followed by a series of instructions.

Процесс, необходимый для выполнения сквозного платежа. Он состоит из инициирования платежа, за которым может следовать ряд инструкций.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">PaymentIdentification" id="e18b810d-2f13-47e2-aa15-1af3727a9a6f">
          <documentation>Specifies the different identifications associated with a payment transaction.

Указывает различные идентификаторы, связанные с проводкой платежа.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">PaymentInitiation" id="5f414eea-9623-413d-84be-0dabbb9f814d">
          <documentation> Instruction to pay an amount of money to an ultimate beneficiary, on behalf of an originator. This instruction is the first of the series of instructions which may be used to execute a payment. It is normally sent by the initiating party to the forwarding agent or to the debtor's agent.

Поручение выплатить сумму денег конечному бенефициару от имени составителя. Эта инструкция первая из серии инструкций, которые могут быть использованы для выполнения платежа. Как правило, она направляется инициирующей стороной экспедитору или агенту должника.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">PaymentInstruction" id="06a16299-ea72-4451-a1d2-0f5849928816">
          <documentation> Instruction to pay an amount of money to an ultimate beneficiary, on behalf of an originator. This instruction may have to be forwarded several times to complete the settlement chain.

Поручение выплатить сумму денег конечному бенефициару от имени составителя. Эту инструкцию, возможно, придется переслать несколько раз для завершения цепочки расчетов.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">PaymentInvestigationCase" id="73ac5eb3-272c-4293-b963-bc953cf82546">
          <documentation>Set of activities performed to handle an exception to a normal payment transaction flow, such as: - a payment has not been received. - a payment has been received but is incorrect. - a payment must be corrected or cancelled (requested by the party which ordered the payment).

Набор действий, выполняемых для обработки исключения из нормального потока проводок платежей, например: - платеж не получен. - платеж получен, но неверен. - платеж должен быть исправлен или отменен (по требованию стороны, заказавшей платеж).</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">IntermediateAgentRole" id="ba6d7892-9de3-4526-8ef0-bb61f5429d8e">
          <documentation> Financial institution that receives a financing request from the financing requestor and forwards it to the first agent for execution.

Финансовое учреждение, которое получает запрос на финансирование от запрашивающей стороны и направляет его первому агенту для исполнения.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">PaymentInvestigationCaseRejection" id="3260471e-efbd-4c2c-9972-d9f1de569609">
          <documentation>Specifies the rejection of an activity linked to a payment. The rejected activity may be the assignment of an investigation case, the cancellation or the modification of a payment.

Указывает отклонение действия, связанного с платежом. Отклоненная деятельность может быть назначением следственного дела, отменой или изменением платежа.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">POIManufacturer" id="8d014191-b3fd-4bc0-a1e4-b4119139d7a4">
          <documentation>Manufacturer or the software, hardware or system of the POI component.

Производителя или программного обеспечения, оборудования или системы компонента POI.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">PaymentInvestigationCaseResolution" id="c09cf38f-eef5-4d9b-ba1a-532c3de6be91">
          <documentation> Specifies the status of an investigation case and the actions taken as a result of this status.

Указывает состояние расследования и действия, предпринятые в результате этого состояния.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">PaymentObligation" id="4f06eeee-2817-4519-b0c9-8ce3d5f0f248">
          <documentation>Obligation for the debtor to pay the creditor an amount of cash.

Обязательство должника по уплате кредитору денежной суммы.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">PaymentObligationPartyRole" id="2a9f8559-16c7-4b84-85cd-40c9da743cf6">
          <documentation>Role played by a party in the context of a payment obligation.

Роль партии в контексте платежное обязательство.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">PaymentPartyRole" id="a232f4b6-19f4-443c-ab3c-4d9b0c8df873">
          <documentation> Role played by a party in the context of a payment.

Роль партии в контексте оплаты.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">PaymentProcessing" id="3b949d08-fd90-40a6-aaad-0746d55776a6">
          <documentation>Specifies how a payment must be processed, for instance through which specific clearing channel.

Указывает, как должен обрабатываться платеж, например, через какой конкретный клиринговый канал.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">PaymentStatus" id="aa98b800-6655-428a-b951-630421a3a244">
          <documentation> Specifies the status of a payment at a specified time.

Указывает состояние платежа в указанное время.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">PaymentTerms" id="8adfec4f-4238-4995-b696-81d7ceea78b5">
          <documentation> Specifies the payment terms of the obligation.

Определяет условия оплаты обязательства.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Penalty" id="eb19e272-af6b-4097-b67d-7be612e5b0f7">
          <documentation> Fee charged when the conditions of a contract are not met.

Плата взимается в случае невыполнения условий договора.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">PerformanceFactors" id="70dd49cd-5caa-49b1-a038-bd1fff08a90c">
          <documentation>Performance factors of the investment fund / fund class.

Коэффициенты эффективности инвестиционного фонда / класса фонда.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Person" id="54dd128f-5da7-4106-a3b8-6b69fb75aaad">
          <documentation> Human entity, as distinguished from a corporate entity (which is sometimes referred to as an 'artificial person').


Человеческая сущность, в отличие от корпоративной организации (которую иногда называют &quot;искусственным лицом&quot;).</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">PersonIdentification" id="3108893a-10f1-4c66-951b-df22f0b2b1c7">
          <documentation>Unique and unambiguous way to identify a person.

Уникальный и однозначный способ идентификации человека.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">PersonName" id="87fcdaac-7ec8-4f70-b220-4b500e010d9a">
          <documentation> Name by which a person is known and that is usually used to identify that person.

Имя, по которому человек известен и которое обычно используется для идентификации этого человека.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">PersonProfile" id="f8cf0f81-5d93-4338-980d-6d710e054bda">
          <documentation>Information to support Know Your Customer (KYC) processes.

Информация для поддержки процессов Знай своего клиента (KYC).</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">PhoneAddress" id="c1b9ff4a-1b10-44c9-b48d-bff367c5d82e">
          <documentation> Collection of information that identifies a phone address.

Сбор информации, идентифицирующей телефонный адрес.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">PhysicalDelivery" id="a0844172-97e4-4cbb-9b24-db6ef06f530b">
          <documentation>Parameters of a physical delivery.

Параметры физической поставки.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">PlaceOfRegistry" id="94f8c36c-7095-45e7-a1a7-e78ec6d3f77f">
          <documentation>Location at which records of ownership are maintained for a financial instrument, and at which ownership changes must be recorded.

Место, в котором ведется учет владения финансовым инструментом и в котором должны регистрироваться изменения в праве собственности.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">PlaceOfSettlement" id="682feb75-3574-4076-9004-6bddc9e1e63a">
          <documentation> Place where settlement of securities occurs.

Место проведения расчетов по ценным бумагам.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">PlacementAgent" id="bc50116b-c710-43a6-9be4-c35e66e2cb54">
          <documentation>Party that helps hedge funds to refine their strategy. May also introduce partners such as fund of funds, pension funds, insurance companies and family offices.

Сторона, которая помогает хедж-фондам совершенствовать свою стратегию. Могут также представляться такие партнеры, как фонд фондов, пенсионные фонды, страховые компании и семейные офисы.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Pledgee" id="8f470f6b-ba4f-4c38-aee5-7065b91495c2">
          <documentation>Organisation used as the pledgee for the securities.

Организация, используемая в качестве залогодержателя ценных бумаг.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">PointOfInteraction" id="6da23c7d-fd15-453a-bed1-384ab60a0121">
          <documentation> Point of interaction (POI) is the entry point to a card payment system. It could be a physical or logical card payment terminal containing software and hardware components, it could be a payment system including a set of card payment terminals linked to a local or remote server, or it could be just an interface to make payments as telephone or Internet browser.

Точка взаимодействия (POI) - точка входа в карточную платежную систему. Это может быть физический или логический карточный платежный терминал, содержащий программные и аппаратные компоненты, это может быть платежная система, включающая набор карточных платежных терминалов, связанных с локальным или удаленным сервером, или это может быть просто интерфейс для совершения платежей в качестве телефона или интернет-браузера.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">PortfolioManagerRole" id="d147b6fd-a08a-4e40-ae3e-257c4597c0de">
          <documentation> Party responsible for investing another party's assets and for managing the day-to-day operations.

Сторона, ответственная за инвестирование активов другой стороны и за управление повседневной деятельностью.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">PortfolioTransfer" id="20443dbc-e748-4ee8-9a26-9859a04100bf">
          <documentation> Transfer by the delivering account servicer to the receiving account servicer of a retail or institutional client portfolio. A portfolio can be any grouping of investments, for example stocks, bonds, options, warrants. held by an institution or an individual.

Передача поставщиком услуг по обслуживанию счетов получающему клиенту розничного или институционального клиентского портфеля. Портфелем может быть любая группа инвестиций, например акции, облигации, опционы, варранты. удерживается учреждением или физическим лицом.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">PortfolioValuation" id="460f115c-7135-496a-935c-9ecc2099c6fa">
          <documentation> Valuation information of the portfolio.

Информация об оценке портфеля.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Position" id="35e89027-a3d5-4cdd-a09e-39a406d1546d">
          <documentation>Specifies the status of trades and their value inside a system.

Указывает статус сделок и их значение внутри системы.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">PostalAddress" id="848d19c7-a4d3-4f06-ae9b-447a07420afa">
          <documentation>Information that locates and identifies a specific address.

Информация, которая находит и идентифицирует конкретный адрес.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">PowerOfAttorney" id="69ac4d10-c2fb-49fa-8870-941ff62d7601">
          <documentation>power of attorney / доверенность 

Document that transfers specific rights from a party to another party.

Документ, который передает определенные права от одной стороны другой стороне.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">PowerOfAttorneyRequirements" id="cbc50716-3b73-4e7e-a29c-5f7d286be5a9">
          <documentation> Specifies the conditions to be filled in to obtain a valid power of attorney.

Определяет условия, которые необходимо заполнить для получения действительной доверенности.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">PremiumCalculation" id="2f48f35e-ebd8-4ddb-9887-0d82fff532db">
          <documentation> Specifies the amount of a premium on a currency option together with its calculation method.

Определяет размер премии по валютному опциону вместе с его методом расчета.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Presentation" id="df3b67ea-ac7d-49cf-8a4d-b1625eb4c0a7">
          <documentation> Presentation of documents.

Представление документов.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Price" id="deb61875-68d0-47ff-b70f-8e8215334582">
          <documentation> Amount of money for which goods, services or assets are offered, sold, or bought.

Сумма денег, за которую предлагаются, продаются или покупаются товары, услуги или активы.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">PrimaryOwner" id="5fce2362-d294-429d-b184-46d766c581f6">
          <documentation> Single owner of the investment account or, when the ownership is split among several owners, the primary owner is the one giving its address and account details for the registration.

Один владелец инвестиционного счета или, когда право собственности разделено между несколькими владельцами, основным владельцем является тот, кто указывает свой адрес и реквизиты счета для регистрации.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">PrimaryPlaceOfDeposit" id="063d6442-3a10-4446-ad56-40946cc49bc3">
          <documentation> Specifies the primary place of deposit for the securities.

Указывает основное место депонирования ценных бумаг.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">PrivateCertificate" id="6376349d-671b-492e-80b3-64f39357b58c">
          <documentation> Specifies the parameters associated with the production of a certificate to identify the profile of a customer.

Задает параметры, связанные с производством сертификата для идентификации профиля клиента.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ProceedsDefinition" id="5c3df9fc-146e-4ce8-844f-38c5d6816f09">
          <documentation>Definition of exchanges of cash and/or securities available in the processing of corporate actions.

Определение бирж наличных денег и / или ценных бумаг, имеющихся в процессе обработки корпоративных действий.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Product" id="e142604b-ad85-4b70-8081-0d8c39dc3ab4">
          <documentation> Item that is offered for sale. Products can be services or goods.

Товар, который предлагается к продаже. Продукты могут быть услуги или товары.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ProductCategory" id="3a63f0a2-03ec-4b22-b529-5f5acc3ebed0">
          <documentation>Specifies the category of the product.

Указывает категорию продукта.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ProductCharacteristics" id="26ffae73-4eba-45f8-b41c-339b2019cb26">
          <documentation>Identifies the characteristic of a product.

Определяет характеристику продукта.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ProductDelivery" id="48e00093-ed3d-4bde-ba42-26968ef0e01a">
          <documentation>Arrangements for delivery of invoiced products and/or services.

Организация доставки оплаченных товаров и/или услуг.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ProductDeliveryObligation" id="a6150b0e-fde1-445a-b513-acd2fb3e9702">
          <documentation> Obligation for the seller to deliver goods or services to the buyer.

Обязательство продавца поставлять товары или услуги покупателю.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ProductIdentification" id="5a84c9b7-8264-4046-a377-b0047f0d55d7">
          <documentation> Information used to identify a product.

Информация, используемая для идентификации продукта.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ProxyAgent" id="994d3210-91a1-46a0-9548-4689fd4ff00b">
          <documentation> Party appointed to organise the issuer meeting. Also called vote tabulator.

Сторона, назначенная для организации собрания эмитента. Также называется голосование табулятор.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ProxyAppointment" id="299907cc-7dec-4ed2-8320-538e0710604d">
          <documentation> Specifies that a proxy has been appointed to represent a party authorised to vote at a general meeting.

Указывает, что доверенное лицо было назначено представлять сторону, уполномоченную голосовать на общем собрании.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ProxyAppointmentCondition" id="5c8fa3eb-02ad-4977-a1b9-ff96c6d7fd88">
          <documentation>Conditions that must be met to appoint a proxy.

Условия, которые должны быть выполнены для назначения доверенного лица.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ProxyAppointmentDeadline" id="6195dace-7727-43c0-a1ac-23e8734fc0dd">
          <documentation> Date by which the information on proxy assignment must be received.

Дата, к которой должна быть получена информация о назначении доверенности.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ProxyAssignerRole" id="1f8597fb-37fd-4e56-a2fc-bc3ea206f5cb">
          <documentation>Party entitled to appoint a proxy.

Сторона, имеющая право назначить доверенное лицо.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">PurchaseOrder" id="4c6689c5-6564-4672-b192-3eca805b1ab1">
          <documentation> Document issued by a buyer and containing the details of a purchase, including description of goods, transport information, payment terms, etc.

Документ, выданный покупателю и содержащий сведения о закупке, в том числе описание товаров, информацию о транспорте, условия оплаты и т. д.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">QualifiedForeignIntermediary" id="a409b8fa-0e95-43a1-bea8-98a3f7a127c8">
          <documentation> Foreign financial institution that has been authorised by local authorities to act as account management institution in the country.

Иностранное финансовое учреждение, уполномоченное местными органами власти выступать в качестве учреждения по управлению счетами в стране.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Quorum" id="ed73943d-96bf-4c38-81ad-ebf81f881bc9">
          <documentation> Specifies whether a quorum is required or not together with the quorum parameters.

Указывает, требуется ли кворум вместе с параметрами кворума.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Quote" id="27ae782d-fc95-4bfa-8f35-f96af29587b6">
          <documentation> Indicates whether the quote details are indicated as an offer, a bid or a mid of a security, commodity, currency (the latter being an average of the offer and the bid).

 Указывает, указываются ли детали котировки в виде предложения, предложения или Амида ценной бумаги, товара, валюты (последняя является средним значением предложения и предложения).</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">QuoteOriginator" id="c112f07b-5dff-49f1-81b7-4d9e6c8676da">
          <documentation> Originator of the quote.

Автор котировки.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">QuoteRequestor" id="27399b59-965f-4965-8303-9f01637c5290">
          <documentation>Requestor of the quote

Запрашивающая котировка</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">QuoteStatus" id="edd47dcb-e022-42c2-a897-15eb4056a22b">
          <documentation>Status of a quote and if required, the rejection reason.

Статус предложения и, если требуется, причина отклонения.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">QuotingInstitution" id="bfdb2634-c648-41c3-b9a1-45d7c8158d4c">
          <documentation> Source of the quote, party that proposes a rate.

Источник _котировки, сторона, которая предлагает ставку.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Rating" id="77f9c1df-14a8-4c11-9162-f70072d76d34">
          <documentation> Assessment of securities credit and investment risk.

Оценка кредитного и инвестиционного риска ценных бумаг.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Reassignment" id="100f2692-3282-4f93-a6cf-6ce0949ca2d6">
          <documentation> Action that consists in forwarding an investigation case assignment to another party which becomes the new assignee.

Действие, заключающееся в передаче назначения следственного дела другой стороне, которая становится новым цессионарием.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ReceiversCustodian" id="88e4bc81-af69-4edb-8e28-125c43db45b2">
          <documentation>Party that acts on behalf of the buyer of securities when the buyer does not have a direct relationship with the receiving agent.

Сторона, которая действует от имени покупателя ценных бумаг, если покупатель не имеет прямых отношений с получающим агентом.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ReceiversIntermediary" id="d9eda8f6-2c4c-4f89-9604-a77e914528ef">
          <documentation> Party that the receiver's custodian uses to effect the receipt of a security, when the receiver's custodian does not have a direct relationship with the receiver agent.

Сторона, которую опекун получателя использует для получения ценной бумаги, если опекун получателя не имеет прямого отношения к агенту получателя.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ReceivingAgent" id="9c28e375-e449-43c5-98e2-4bbeedcfc237">
          <documentation> Party that receives securities from the delivering agent at the place of settlement. For example, a central securities depository.

Сторона, получающая ценные бумаги от агента по доставке по месту расчетов. Например, Центральный депозитарий ценных бумаг.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ReceivingDepositoryRole" id="d5034c14-d7ed-42e2-a224-7deed89cffe5">
          <documentation> Organisation holding securities to enable book entry transfer of securities. These organisations may also carry out centralised comparison and transaction processing such as clearing and settlement of securities. The physical securities may be immobilised by the depository, or securities may be dematerialised (so that they exist only as electronic records). Also responsible for compliance of the portfolio with legal ratios etc. The depository may delegate custody to another entity (custodian).

Организация, владеющая ценными бумагами для обеспечения возможности внесения ценных бумаг в Книгу. Эти организации могут также проводить централизованное сравнение и обработку транзакций, например, клиринг и расчеты по ценным бумагам. Физические ценные бумаги могут быть обездвижены в депозитарии, или ценные бумаги могут быть бездокументарными (так что они существуют только в виде электронных записей). Также несет ответственность за соблюдение портфель правовые отношения и т. д. Депозитарий может делегировать право попечения другому лицу (хранителю).</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ReceivingSettlementParty" id="6f916bda-2941-4589-847f-214b9167ebb0">
          <documentation> Party that receives securities as part of a chain of settlement parties or as ultimate party.

Сторона, которая получает ценные бумаги как часть цепочки расчетных сторон или как конечная сторона.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">RecipientBank" id="a7f0eaf0-dd37-42d1-bf5c-bed4660ae5c1">
          <documentation>Bank that will be paid under a payment obligation contracted between two financial institutions related to the financing of a commercial transaction.

Банк, который будет выплачиваться в соответствии с платежным обязательством, заключенным между двумя финансовыми учреждениями, связанным с финансированием коммерческой сделки.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Reconciliation" id="24861007-5088-4a12-9749-be7b87c90605">
          <documentation>Process of matching different documents submitted by parties to a trade.

Процесс сопоставления_сверки различных документов, представленных сторонами сделки.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ReconciliationTransaction" id="8700b89b-dc56-4ee0-8b16-53e3a9e9497e">
          <documentation> Totals performed during the reconciliation period, for a certain type of transaction.

Итоговые значения, выполненные в период выверки для определенного типа проводки.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">RedemptionExecution" id="03f89942-1629-43e4-9f2d-e6b4898731b9">
          <documentation> Execution of a redemption order.

Исполнение ордера на выкуп.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">RedemptionOrder" id="ba231965-8385-477c-bbc8-32e0fdba6db6">
          <documentation> Instruction from an investor to sell investment fund units back to the fund.

Распоряжение инвестора о продаже паев инвестиционного фонда обратно в Фонд.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">RedemptionSchedule" id="fe80a597-6848-4cd5-a14d-9dae6108905f">
          <documentation> Describes the reason and terms for early partial or total redemption, amortisation or extension of an issue.

Описывает причину и условия досрочного частичного или полного погашения, амортизации или продления выпуска.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">RegisteredContract" id="4781dd8d-5eb6-47b0-ba75-8d18b1c98922">
          <documentation> Contract registered for regulatory purpose by a registration agent for the journaling of payments made against the contract.

Договор, зарегистрированный в нормативных целях регистрационным агентом для ведения журнала платежей, произведенных по договору.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">RegistrarRole" id="3695b085-4fb4-44eb-a3e2-93cc46fba33d">
          <documentation> Party responsible for keeping track of the owners of securities.

Сторона, ответственная за отслеживание владельцев ценных бумаг.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">RegistrationBeneficiary" id="d0166d22-f17d-4194-9985-28191826d312">
          <documentation>Party in whose name securities are registered.

Сторона, на имя которой зарегистрированы ценные бумаги.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">RegulatoryAuthorityRole" id="bffff344-3833-4e20-a2e7-6d9ea090543e">
          <documentation>Entity requiring the regulatory reporting information.

Субъект, требующий нормативной отчетной информации.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">RegulatoryReport" id="8a392e69-be0f-491b-86cb-d1fdf7d534ba">
          <documentation> Information needed due to regulatory and statutory requirements.

Информация, необходимая в связи с нормативными и законодательными требованиями.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">RegulatoryReportingRole" id="29b447e4-ffbf-4553-98c4-76c5981b4bf7">
          <documentation> Party which plays a role for regulatory reporting.

Сторона, которая играет определенную роль в области нормативной отчетности.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Reinvestment" id="f62c50f6-7394-401a-9fc1-234fb6881d85">
          <documentation>Parameters of the reinvestment of the income on the fund.

Параметры реинвестирования дохода по фонду.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ReportingPartyRole" id="f93fbaad-05a5-419a-9a51-3e87b3da15bc">
          <documentation> Party responsible for providing regulatory reports.

Сторона, ответственная за предоставление нормативных отчетов.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ReportingService" id="aeade28e-0d73-4a6a-8c63-f95704dc1e75">
          <documentation>Specifies the reporting parameters that are included in the account contract which specifies the services linked to the account..

Задает параметры отчетности, включенные в контракт учетной записи, в котором указываются службы, связанные с учетной записью..</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">RepresentativeOfficer" id="99fdfd03-6987-4e1d-a5d0-12f6df883c46">
          <documentation> Officer who has some rights to represent a given organisation. In account management, it is the person to be contacted by the account servicer.

Сотрудник, который имеет некоторые права представлять данную организацию. В управлении учетными записями это лицо, с которым должен связаться пользователь службы.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">RepurchaseAgreement" id="4f5ef3a4-3f8e-4520-b1cb-939acf5c822b">
          <documentation>Sale of securities together with an agreement for the seller to buy back the securities at a later date.
A repo is equivalent to a spot sale combined with a forward contract.
For the seller of the security it is a repo; for the buyer of the security it is a reverse repurchase agreement. 

Продажа ценных бумаг вместе с Договором о выкупе ценных бумаг продавцом на более поздний срок.
РЕПО эквивалентно СПО-продаже в сочетании с форвардным контрактом.
Для продавца ценной бумаги это РЕПО,для покупателя ценной бумаги-соглашение обратного РЕПО.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Reservation" id="65d21e56-2be7-4fe0-8597-22a4097733b7">
          <documentation>Liquidity set aside by the payer for specific purposes.

Ликвидность, резервируемая плательщиком на конкретные цели.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Resolution" id="71c6aade-c7ba-41eb-b17f-7c203dc92771">
          <documentation> Specifies an item in the agenda of the meeting. Some resolutions are submitted to the vote of the security holders, some are presented for information only.

Определяет пункт повестки дня собрания. Некоторые резолюции выносятся на голосование держателей ценных бумаг, а некоторые представляются только для информации.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ResolutionProposal" id="2b09a55f-4df8-4d99-b701-de5167881522">
          <documentation> Conditions that must be met to propose a resolution.

Условия, которые должны быть выполнены, чтобы предложить решение.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ResolutionProposalDeadline" id="0a05649c-5a8d-435e-9650-574bf1099626">
          <documentation>Date and time by which security holders can propose amendments or new resolutions.

Дата и время, к которым держатели ценных бумаг могут предлагать поправки или новые резолюции.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Response" id="15a44abb-0235-4d6e-9f36-4ca21a36dc80">
          <documentation>Response of a requested service.

Ответ запрашиваемой услуги.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ResponsiblePartyRole" id="34257fae-db6a-44cf-b52b-20377da09f28">
          <documentation>Identification of the party who is responsible for the certificate.

Идентификация стороны, ответственной за сертификат.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">RightsHolder" id="575d7ad5-154f-429e-981a-9856258306bc">
          <documentation> Owner of voting rights.

Владелец права голоса.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">RiskManagementLimit" id="804d6c75-a2a9-4cbf-b13d-894f1dcacdf2">
          <documentation> Cash management feature limiting the maximum risk that a party accepts to take with respect to a counterparty or a set of counterparties. A risk management limit is either bilateral, for a counterparty, or multilateral, for a set of counterparties or all other members in a system.The limit may also apply to sponsored or indirect members. In principle, a risk management limit is calculated on the net position between two members and is expressed as a credit or debit limit, from the point of view of the party setting the limit.

Функция управления денежными средствами ограничивает максимальный риск, который сторона принимает в отношении контрагента или группы контрагентов. Лимит управления рисками является двусторонним для контрагента или многосторонним для группы контрагентов или всех других участников системы.Ограничение может также применяться к спонсируемым или косвенным членам. В принципе, лимит управления рисками рассчитывается по чистой позиции между двумя участниками и выражается как кредитный или дебетовый лимит, с точки зрения стороны, устанавливающей лимит.
</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Role" id="c0f2af17-bab1-4681-b92c-e44cab5e31eb">
          <documentation> Role of a party in an activity.

Роль участника в деятельности.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">RolePlayer" id="0cdb2232-76ad-4040-9362-7e84a6c267d1">
          <documentation> Type of entity that plays a specific role in a specific context.

Тип сущности, играющей определенную роль в определенном контексте.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Rollover" id="04787c0a-ba8b-4f53-aa4a-c645cba4efb7">
          <documentation>rollover / рефинансирование


Process whereby a financial instrument is reinvested at maturity.

Процесс реинвестирования финансового инструмента в конце срока.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SafekeepingPlace" id="97b9cc46-315c-462e-8302-041d2a728653">
          <documentation> Organisation used as the safekeeping place for the securities.

Организация, используемая в качестве места хранения ценных бумаг.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SchemeOwner" id="453b08e1-a63f-4ac7-a25c-b38bac57f0b6">
          <documentation> Description of the owner of a code scheme, for example, International Standards Organization.

Описание владельца кодовой схемы, например, Международной Организации по стандартизации.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SecondaryOwner" id="8687aa62-4872-45b6-b940-7229e5a2b9c1">
          <documentation>Entity that is not the primary owner when the ownership of the investment account is split among several owners.

Организация, не являющаяся основным владельцем инвестиционного счета, если право собственности на инвестиционный счет разделено между несколькими владельцами.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SecuritiesAccount" id="8ea3b17a-cbbb-4fa7-94c3-ffb2315c0257">
          <documentation> Account to or from which a securities entry is made.

Счет, на который или с которого производится запись ценных бумаг.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SecuritiesBalance" id="8bd8d5fd-76ba-4fe9-be08-ea249b4e681b">
          <documentation> Net position of a segregated holding, in a single security, within the overall position held in a securities account. A securities balance is calculated from the sum of securities' receipts minus the sum of securities' deliveries.

Чистая позиция сегрегированного холдинга в рамках одной ценной бумаги в рамках общей позиции на счете ценных бумаг. Баланс ценных бумаг рассчитывается из суммы поступлений ценных бумаг за вычетом суммы поставок ценных бумаг.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SecuritiesBlockingDeadline" id="fb6a857a-a2b0-49f2-b3c5-aac317512100">
          <documentation>Date by which the securities should be blocked.

Дата, до которой ценные бумаги должны быть заблокированы.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SecuritiesCertificate" id="fd923390-cccc-474b-8aff-832db09e4bff">
          <documentation> Physical representation of a security.

Физическое представление ценной бумаги.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SecuritiesClearing" id="5ff27da4-58e8-49ed-a371-20c65cff6daa">
          <documentation>Process of settling securities through a central system.

Процесс урегулирования ценных бумаг через центральную систему.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SecuritiesDeliveryObligation" id="648ef2e4-d4ca-4106-a46a-0abc2ea36e9e">
          <documentation> Obligation for one party to deliver securities to another party.

Обязательство одной стороны по поставке ценных бумаг другой стороне.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SecuritiesEntry" id="09704b79-5bf7-4926-a3d7-ae6e8f974f41">
          <documentation> Posting to a securities account as a result of a securities creation, deletion or transfer in the context of a securities transaction.

Проводка на счет ценных бумаг в результате создания, удаления или передачи ценных бумаг в контексте операции с ценными бумагами.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SecuritiesFinancing" id="b80d1c8b-c851-4a76-8fd9-123cf8b253ff">
          <documentation> Process of lending or borrowing cash or securities against securities or cash collateral. It aims at optimising liquidity, support a trading strategy, or increase settlement efficiency.

Процесс кредитования или заимствования денежных средств или ценных бумаг под ценные бумаги или денежное обеспечение. Он направлен на оптимизацию ликвидности, поддержку торговой стратегии или Повышение эффективности расчетов.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SecuritiesFinancingAgreement" id="df223915-9ef2-4576-92f8-cf2479ccebf6">
          <documentation> Contractual details related to the agreement between parties.

Контрактные детали, связанные с соглашением между сторонами.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SecuritiesLending" id="d95a0709-77ec-4ef5-b846-bd560781f4cc">
          <documentation> Lending of securities by one party to another. The terms of the loan are governed by an agreement that requires the borrower to provide the lender with collateral of value equal to or greater than the loaned securities. As payment for the loan, the parties negotiate a fee, quoted as an annualised percentage of the value of the loaned securities.

Предоставление ценных бумаг одной стороной другой стороне. Условия займа регулируются соглашением, которое обязывает заемщика предоставить кредитору обеспечение на сумму, равную или превышающую стоимость предоставленных ценных бумаг. В качестве оплаты по кредиту стороны договариваются об уплате комиссии, выраженной в процентах годовых от стоимости предоставленных ценных бумаг.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SecuritiesModification" id="6836851e-7c6a-4488-85ea-8dc270649a99">
          <documentation> Modification of the reference data of a security or of the organisation that issued it.

Изменение справочных данных ценной бумаги или организации, выдавшей ее.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SecuritiesOptionTrade" id="dbd2ccdc-b693-42d4-9319-2730a768896b">
          <documentation> Process of buying or selling an option which has securities as underlying asset.

Процесс покупки или продажи опциона, который имеет ценные бумаги в качестве базового актива.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SecuritiesOrder" id="c81c5052-29cc-4728-b033-b18512e29e4f">
          <documentation> Intention to transfer an ownership of a financial instrument.

Намерение передать право собственности на финансовый инструмент.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SecuritiesOrderExecutionInstruction" id="fc264e0c-7369-4515-8d54-0c28296e852e">
          <documentation> Identifies the instructions for order handling

Определяет инструкции для обработки заказа</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SecuritiesOrderParameters" id="f9ada07b-cf07-43ad-b467-ef0cfb3b45ef">
          <documentation> Parameters of the transfer of a financial instrument.

Параметры передачи финансового инструмента.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SecuritiesOrderPartyRole" id="290975dc-ec03-41cf-a0ca-661574f453cf">
          <documentation> Role played by a party associated with an order to buy or sell securities.

Роль играет сторона, связанная с распоряжением на покупку или продажу ценных бумаг.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SecuritiesOrderStatus" id="b3116c6f-8652-4d5e-854b-1b1d6b783e12">
          <documentation> Status of a securities order or of the processing of a securities order.

Статус заказа ценных бумаг или обработки заказа ценных бумаг.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SecuritiesPartyRole" id="8945951e-9cff-4c31-871e-ef0562315afa">
          <documentation> Specifies roles played by a party that are linked to the handling of securities but not related to a specific process.

Определяет роли стороны, связанные с обращением с ценными бумагами, но не связанные с конкретным процессом.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SecuritiesPegOrderInstruction" id="88e604d4-5395-4ec7-a08e-c43ef54be274">
          <documentation> Instructions specific to pegged orders, which consist in an investor buying large amounts of the underlying asset of a derivative it holds.

Инструкции, специфичные для привязанных ордеров, которые состоят в том, что инвестор покупает большие суммы базового актива производного инструмента, который он держит.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SecuritiesPostTradeBooking" id="ccfb436a-971d-4889-9ac9-6978819c13c8">
          <documentation> Information used to book the executions of a trade.

Информация, используемая для исполнения торговли.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SecuritiesPricing" id="9897253b-a766-4fa1-9239-58e8f796d3bc">
          <documentation> Characteristics related to the price of the security.

Характеристики, связанные с ценой ценной бумаги.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SecuritiesProceedsDefinition" id="6d0bf2fd-0332-4e03-a06e-2e354d97df9b">
          <documentation> The definition of the securities proceeds for a corporate action in generic terms; that is, before applying it to specific securities holding. An example would be the definition of a bonus rights issue where all the information will be given in general on a per share basis.

Определение ценных бумаг для корпоративного действия в общих чертах; то есть, прежде чем применять его к конкретным держателям ценных бумаг. Примером может служить определение вопроса о бонусных правах, когда вся информация будет предоставляться в целом на основе каждой акции.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SecuritiesQuantity" id="68b560bf-f972-451d-9cd8-b74e96f9ac1b">
          <documentation> Quantity of a security.

Количество ценной бумаги.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SecuritiesQuoteVariable" id="f8cf3671-950e-41fc-9b26-15757444fc0f">
          <documentation> Proposition of price for a financial instrument.

Предложение цены финансового инструмента.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SecuritiesRegistrationDeadline" id="e0453722-8f87-4583-98eb-d56d92a1e7b1">
          <documentation> Date by which the securities have to be registered.

Дата, до которой ценные бумаги должны быть зарегистрированы.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SecuritiesRegulatoryDetails" id="a6d59cad-bea9-41a9-ac55-43ff1c98c5f1">
          <documentation> Information related to order and required for regulatory purposes.


Информация, связанная с заказом и необходимая для целей регулирования.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SSIDatabaseProvider" id="f3e5cab0-02ce-43e2-bdcd-e0f344a50f50">
          <documentation> Provider of a standing settlement instruction (SSI) database.

Поставщик базы данных постоянных расчетных инструкций (SSI).</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SecuritiesRelatedFees" id="5120238a-e2ab-4f80-a253-d7bcf0f91320">
          <documentation>Fees related to securities trades.

Сборы, связанные с торговлей ценными бумагами.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SecuritiesRestriction" id="103dd5dc-f637-4985-bef1-67d96f97ec60">
          <documentation>Restrictions applicable to the security.

Ограничения, применимые к безопасности.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SecuritiesSettlement" id="b3cc6ee6-8f86-497e-89e9-0a6d854dbeb2">
          <documentation>Settlement of the securities in a securities transaction, that is, the instruction to deliver or receive securities, involving the payment of an amount of money or not.

Осуществление расчетов по ценным бумагам в сделке с ценными бумагами, то есть поручение на поставку или получение ценных бумаг, предполагающее выплату денежной суммы или нет.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SecuritiesSettlementPartyRole" id="203577a3-1ea7-4c8a-b109-fccbee490283">
          <documentation> Role played by a party in the context of the settlement of securities.

Роль стороны в контексте расчетов по ценным бумагам.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SecuritiesSettlementSystem" id="1e39d5de-a9ee-4985-960e-e969f16708b8">
          <documentation>Specifies the system used in a settlement process.

Указывает систему, используемую в процессе сопоставления.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SecuritiesStatus" id="1d132cac-334b-435a-9866-753f56774090">
          <documentation>Specifies the status of the security within its lifecycle.

Указывает состояние безопасности в течение жизненного цикла.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SecuritiesSwapLeg" id="e5eb4a6a-309a-4e51-b16b-5d63e2ec1d0d">
          <documentation> Contains the details of one of the legs of a swap, both in time (spot versus [partial] forward details) and the side (sell versus buy).

Содержит сведения об одном из сегментов свопа, как во времени (спот против [частичных] форвардных деталей), так и в стороне (продажа против покупки).</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SecuritiesTax" id="a6362dff-0e94-411c-bb44-03949f4bb2b8">
          <documentation>Amount of money due to the government or tax authority, according to various pre-defined parameters such as thresholds or income.

Сумма денег, причитающаяся государству или налоговому органу, в соответствии с различными заранее определенными параметрами, такими как пороговые значения или доходы.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SecuritiesTrade" id="6997b156-d511-4ff1-aea0-595b4e9a2d8a">
          <documentation> Specifies trades linked to securities operations such as the exchange of securities, the lending of securities and the transactions related to investment funds.

Определяет сделки, связанные с операциями с ценными бумагами, такими как обмен ценными бумагами, кредитование ценных бумаг и операции, связанные с инвестиционными фондами.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SecuritiesTradeExecution" id="463656eb-68ec-43f7-815d-d7c9f348b2c7">
          <documentation> Transaction between two counterparties in which they agree to buy and sell a financial instrument. A trade transaction occurs with the matching of the two counterparties orders. There could be several trade transactions necessary to execute the trade.

Сделка между двумя контрагентами, в которой они соглашаются покупать и продавать финансовый инструмент. Торговая сделка происходит при сопоставлении ордеров двух контрагентов. Для совершения сделки может потребоваться несколько торговых операций.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SecuritiesTradeIdentification" id="ba952874-33bf-4653-9cfc-965f320ffa3f">
          <documentation> Specifies the different identifications associated with a securities transaction.

Указывает различные идентификаторы, связанные со сделкой с ценными бумагами.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SecuritiesTradePartyRole" id="f2adbd8c-5f37-4939-8d51-055ebd62535e">
          <documentation>Role played by a party in the context of a securities trade.

Роль партии в контексте торговли ценными бумагами.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SecuritiesTradeStatus" id="bb480b9d-9d7f-46a7-ad57-5d1c5f9b8825">
          <documentation>Status of a securities trade.

Статус сделки с ценными бумагами.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SecuritiesTradeStatusReason" id="988f7cef-911e-489a-8f23-5ba529414824">
          <documentation> Specifies the underlying reason for a status of a securities trade.

Указывает основную причину состояния сделки с ценными бумагами.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SecuritiesTradeSystemRole" id="a28da1ca-72a1-4254-9873-189a999ee59a">
          <documentation> Role played by a system in the context of a securities trade.

Indicates the main reason for the status of the securities transaction.

Роль системы в контексте торговли ценными бумагами.

Указывает основную причину статуса сделки с ценными бумагами.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SecuritiesTransaction" id="47ec8547-9728-4b1b-ab3c-91d93971aa95">
          <documentation> Exchange of securities.

Обмен ценными бумагами.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SecuritiesTransfer" id="486532e3-a9d3-4668-932c-ac967e19f65e">
          <documentation> Completion of a securities settlement instruction, wherein securities are delivered/debited from a securities account and received/credited to the designated securities account.

Заполнение расчетной инструкции по ценным бумагам, в которой ценные бумаги доставляются/дебетуются со счета ценных бумаг и поступают/зачисляются на указанный счет ценных бумаг.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SecurityCertificate" id="a326161b-656d-4855-b149-b3527de582a4">
          <documentation> Certificate linked to a digital signature.

Сертификат, связанный с цифровой подписью.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SecurityCertificateHolderRole" id="3d885aff-bad5-486b-86a7-c2818bb3b39e">
          <documentation> Holder of the security certificate.

Обладатель сертификата безопасности.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SecurityCertificateIssuerRole" id="b9a26c18-5d32-4d83-b636-be60472b61bf">
          <documentation> Party that issues security certificates.

Сторона, которая выдает сертификаты безопасности.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SecurityCertificatePartyRole" id="8e043609-c14b-4c05-bf2c-fcc2f7599aee">
          <documentation> Role played by a party in the context of a security certificate

Роль партии в контексте сертификат безопасности </documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SellerBank" id="f53db966-e6dd-40a6-9010-1460df1e1d2a">
          <documentation> Financial institution of the seller.

Финансовое учреждение продавца.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SellerRole" id="046c09cb-5424-42d7-8c17-82557ecfad6f">
          <documentation> Party that sells assets, goods or services.

Сторона, которая продает активы, товары или услуги.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Service" id="d7988a7d-df75-46cc-b2f3-64877be2dba9">
          <documentation> Service is the intangible equivalent of a good.

Обслуживание является нематериальным эквивалентом товара.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ServiceLevel" id="b7cb7246-b3e9-43f9-92da-32411757a3db">
          <documentation> Agreement under which or rules under which the transaction should be processed.

Соглашение, в соответствии с которым или правила, в соответствии с которыми сделка должна быть обработана.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ServicingPartyRole" id="1c146a5c-9e09-48bc-a9a0-f60c8976c2cc">
          <documentation> Party that is acting on behalf of another party and that offers collateral management services.

Сторона, действующая от имени другой стороны и предлагающая услуги по управлению сервисами.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Settlement" id="415c4189-310a-4921-95a9-4c909cc95b10">
          <documentation>settlement / уплата, рассчет / процесс передачи денег

Process which consists in transferring the proceeds related to a trade from one party to the next one.

Процесс, который заключается в передаче выручки, связанной с торговлей, от одной стороны к другой.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SettlementInstructionSystemRole" id="a2f4f27f-e534-4d4b-8dc0-cb0f6cbdfc20">
          <documentation> Identification of a specific system or set of rules and/or processes to be applied at the settlement place.

Определение конкретной системы или набора правил и / или процессов, которые должны применяться в месте урегулирования.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SettlementPartyRole" id="26ce64e2-3180-4a05-bed1-1977208c0979">
          <documentation> Role played by a party in a settlement process.

Роль партии в процессе урегулирования.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SettlementTimeRequest" id="6447b7e9-0b2c-4fdf-872d-721d2cdbe0f5">
          <documentation> Provides information on the requested settlement time(s) of the payment instruction.

Предоставляет информацию о запрашиваемых  сроках _уплаты в платежной инструкции.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Settlor" id="eaa4abe3-b2d8-495a-a967-6558bdc62c58">
          <documentation> Entity that creates a trust or contributes assets to the trust.

Организация, которая создает кредит или вносит в него активы.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ShareholderRegister" id="458669aa-4acf-4dcd-a965-0dd776033ae7">
          <documentation>Contains a list of owners and the quantity of securities they own.

Содержит список владельцев и количество ценных бумаг, которыми они владеют.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ShipFrom" id="75ef7c7a-305d-4447-b9e3-045f8c38661c">
          <documentation> Party from whom the goods are dispatched.

Сторона, от которой отправляется товар.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ShipTo" id="10d17003-8202-450d-8b18-3ec71ed09ed7">
          <documentation> Party to whom the goods must be delivered.

Сторона, которой должен быть доставлен товар.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ShipmentDateRange" id="ae78ba4a-a681-4e03-b5d4-b19ba32137bc">
          <documentation> Specifies a shipment period or a shipment date.

Указывает период отгрузки или дату отгрузки.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SidePocket" id="8fe22cdc-ff67-48c9-9b00-860acc2e0f83">
          <documentation> Separate account containing illiquid assets of a hedge fund portfolio. Only the present participants in the hedge fund will be entitled to a share of it.

Отдельный счет, содержащий неликвидные активы портфеля хедж-фонда. Только нынешние участники хедж-фонда будут иметь право на долю в нем.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Signature" id="2ecc98ea-b465-4e16-9ce4-2f33f06bbc2a">
          <documentation> Additional security provision attached to a contract. A (numeric) signature can be used as evidence of origin and integrity, i.e., authenticity of the signed data. A judge can accept this evidence as proof.

Дополнительное обеспечение безопасности, прилагаемое к контракту. (Цифровая) подпись может использоваться в качестве доказательства происхождения и целостности, т. е. подлинности подписанных данных. Судья может принять эти доказательства в качестве доказательства.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SignatureCondition" id="756c182b-9fef-4b69-90e8-6a503d7af8fa">
          <documentation> Specifies the signature requirements for managing an account.

Определяет требования к подписи для управления учетной записью.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SourceOfPrice" id="c3ff0c36-6b1b-4524-ad9d-bad8fb71816a">
          <documentation> Place from which the price was obtained.

Место, из которого была получена цена.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Spread" id="047331b3-8e21-4b52-98b9-ba0ac530e2f0">
          <documentation> Margin over or under an index which determines a rate.

Маржа над или под индексом, который определяет ставку.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">StandingOrder" id="b3d83911-7d66-41a8-8305-1392c1f7fac2">
          <documentation>Standing Order / регламент, распорядок

 Instruction given by an account holder to an account servicer to make regular transfers on given dates to the same beneficiary.

Поручение владельца счета к обслуживающему счет, чтобы сделать регулярные переводы на указанные даты на одного получателя.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">StandingOrderResponsible" id="a5ad5161-7cea-44a1-833c-561cdea21d54">
          <documentation> Party responsible for creating, maintaining and deleting a standing order.


Сторона, ответственная за создание, поддержание и удаление постоянного поручения.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">StandingSettlementInstruction" id="08f96bb3-799e-4a71-9d25-c87d027d187d">
          <documentation> Settlement instruction database information.

Информация базы данных расчетных инструкций.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Status" id="6ce7d95c-7bcf-4534-aa12-0f874ebe76d7">
          <documentation> The status of an instruction, advice or request.

Состояние инструкции, рекомендации или запроса.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">StatusOriginator" id="4546f23b-2031-482f-98c9-7c07af260262">
          <documentation> Provides the identification of the originator issuing the transaction reason.

Обеспечивает идентификацию отправителя, выдавшего причину проводки.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">StatusReason" id="b3206ffb-2af4-4010-bb47-4b055422da52">
          <documentation> Specifies the underlying reason for the status of an object.

Указывает основную причину состояния объекта.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">StepInBroker" id="302321df-7fcb-480d-ba7c-c683d4a8e51a">
          <documentation> Broker to which the investment manager directs the execution of a portion of the trade.

Брокер, которому инвестиционный менеджер направляет исполнение части сделки.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">StepOutBroker" id="5beb601c-710f-4b06-9767-9421ee4af4d7">
          <documentation> Brokerage firm that executes an order, but gives other firms credit and some of the commission for the trade.

Брокерская фирма, которая выполняет заказ, но дает другим фирмам кредит и некоторую комиссию за торговлю.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">StockExchange" id="21352edf-9b04-43a1-a446-0b941f82cacb">
          <documentation> Party that identifies the stock exchange.

Сторона, идентифицирующая фондовую биржу.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SubmittingPartyRole" id="8f2797fd-0929-4fa2-9f24-e09078428075">
          <documentation> Specifies the party which submits trade data sets to a system or to a counterparty.

Указывает сторону, которая передает наборы торговых данных в систему или контрагенту.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SubscriptionExecution" id="8f4d8485-c2df-4934-9c03-dcaadfcf0d54">
          <documentation> Execution of a subscription order.

Выполнение заказа на подписку.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SubscriptionOrder" id="c13ac840-38f9-42a0-9c7f-c33c9793fbed">
          <documentation> Order to invest the investor's principal in an investment fund.

Распоряжение об инвестировании основного капитала инвестора в инвестиционный фонд.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SuccessorOnDeath" id="fb0ea361-bb8e-420c-9952-0dd92ae8c2d3">
          <documentation> Deceased's estate, or successor, to whom the respective percentage of ownership will be transferred upon the death of one of the owners.

Имущество умершего, или наследника, которому соответствующий процент владения будет передан после смерти одного из владельцев.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SuspensionPeriod" id="fa1cd1f1-ccf8-42e6-a017-40076ef4d934">
          <documentation> Period defining the last date for which an action will be accepted and the date on which the suspension will be released and normal processing will resume.

Период, определяющий последнюю дату, на которую будет принято действие, и дату, на которую будет выпущена приостановка и возобновлена нормальная обработка.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Swaps" id="bb78f8a1-8fee-4141-8109-b006655b05f5">
          <documentation> Derivative contract through which two parties exchange financial instruments.

Производный контракт, по которому две стороны обмениваются финансовыми инструментами.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SwitchExecution" id="94107fae-efc9-4536-ab97-27837b19b9e8">
          <documentation> Execution of a switch order.

Выполнение заказа на переключение.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SwitchExecutionRedemptionLeg" id="7dadd977-5945-4fc7-8864-be7bb179d1f3">
          <documentation> Execution of the redemption part, in a switch between investment funds or investment fund classes.

Исполнение выкупной части, при переключении между инвестиционными фондами или классами инвестиционных фондов.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SwitchExecutionSubscriptionLeg" id="69e0ee64-3228-48ed-a1a5-a1439be5dc22">
          <documentation> Execution of the subscription part, in a switch between investment funds or investment fund classes.

Выполнение подписной части, при переключении между инвестиционными фондами или классами инвестиционных фондов.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SwitchOrder" id="053aa7ee-de7a-4b06-80b3-cfcae597ec5a">
          <documentation> Transfer from one investment fund/fund class to another investment fund or investment fund class by the investor. A switch is composed of one or several subscription legs, and one or several redemption legs.

Переход из одного инвестиционного фонда класса/фонда в другой инвестиционный фонд или инвестиционный фонд класса инвестором. Свитч состоит из одного или нескольких подписок_ЛЕГ  и одного или нескольких погашение_ЛЕГ.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SwitchRedemptionLeg" id="2d045328-81c9-4614-b4ae-66f937ef9cd8">
          <documentation> Redemption leg, or switch-out, of a switch transaction.

Этап погашения или отключения транзакции switch.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SwitchSubscriptionLeg" id="5f0e8168-c920-4582-8df1-9d3404aa8f21">
          <documentation> Subscription leg, or switch-in, of a switch order.

Нога подписки, или switch-in, заказа переключателя.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">System" id="94da67b8-d4e4-4d57-bf62-9029f15ae572">
          <documentation> Set of integrated applications that provides centralised services such as clearing, netting, reconciliation, trading and/or settlement.

Набор интегрированных приложений, предоставляющих централизованные услуги, такие как клиринг, Неттинг, сверка, торговля и/или расчеты.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SystemAdministratorRole" id="a18a7c69-8bcc-4104-8ccc-df8061189b53">
          <documentation>Party that administers a system.

Партия, которая управляет системой.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SystemBusinessInformation" id="cacc124b-a9a3-4499-b7b5-c0274d82b1b4">
          <documentation> Details about business information related to a system.

Сведения о бизнес-информации, связанной с системой.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SystemIdentification" id="c89fd72c-cc14-4bba-b114-369696364d0e">
          <documentation> Parameters that identify a system.

Параметры, идентифицирующие систему.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SystemMemberRole" id="6c408706-b030-4436-bb29-98c7d7acc32b">
          <documentation> Information about the members of a system.

Информация о членах системы.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SystemName" id="3447cbb1-b5d2-43b5-8571-16e39b6096b3">
          <documentation> Name of a system.

Имя системы.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SystemPartyRole" id="e07ac66e-6811-422d-a68a-f08ededb5c78">
          <documentation> Role played by a party in a system.

Роль партии в системе.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SystemReferenceDataResponsible" id="7308d763-0f5c-47c9-a758-2a2cabcdc70b">
          <documentation> Party responsible for the maintenance of other parties reference data.

Сторона, ответственная за ведение справочных данных других сторон.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SystemStatus" id="f9050880-c274-4097-81e8-ba3878422eb6">
          <documentation> Status of a system and the period of time during which the status is valid.

Состояние системы и период времени, в течение которого статус действителен.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">SystematicInternaliser" id="5c65eaec-2618-4804-af1c-8e2f9e4050f6">
          <documentation> Firm which deals on its own account by executing client orders outside a regulated market or a multi-lateral trading facility, against its own books or against orders from other clients.

 Фирма, которая осуществляет сделки за свой счет, выполняя приказы клиентов за пределами регулируемого рынка или многосторонней торговой площадки, против своих собственных книг или против приказов от других клиентов.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">TakerRole" id="e502942e-bea4-49a5-beec-f352e3f7dbda">
          <documentation> Party which receives the collateral. A party can be both a taker and a giver in a collateral relationship.

Сторона, которая получает залог. Сторона может быть как берущей, так и дающей в залоговых отношениях.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Tax" id="77c0aa61-40e9-4e9d-8c13-475a3716217d">
          <documentation> Amount of money due to the government or tax authority, according to various pre-defined parameters such as thresholds or income.

 Сумма денег, причитающаяся государству или налоговому органу, в соответствии с различными предопределенными параметрами, такими как пороговые значения или доход.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">TaxPartyRole" id="43d2bc80-e9cb-4cba-bea6-cde36b377be5">
          <documentation> Role played by a party in the context of a tax due.

Роль партии в контексте налога.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">TaxPayer" id="93701729-35bc-4310-8af4-cd958e1f1608">
          <documentation> Party that settles tax amounts. May be different from the tax debtor and tax creditor.

Сторона, которая урегулирует налоговые суммы. Может отличаться от должника по налогу и налогового кредитора.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">TaxPeriod" id="945699c9-0734-4d3e-89fe-46e19fdb4ba0">
          <documentation> Period of time details related to the tax payment.

Детали периода времени, связанные с уплатой налога.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">TaxRecipient" id="ef277b09-4de5-45a0-9199-f3ccd6ce288c">
          <documentation> Party that receives the tax. The recipient of, and the party entitled to, the tax may be two different parties.

Сторона, которая получает налог. Получателем налога и лицом, имеющим на него право, могут быть две разные стороны.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">TaxRecord" id="2e2e8824-914a-46f8-a17a-215ae234c64b">
          <documentation> Record of tax details.

Учет деталей_ налога  .</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">TaxVoucher" id="628c6137-27a2-4985-933b-dc267e6fbe02">
          <documentation> Statement showing the amount or value of a distribution and either the tax credit to which the recipient is entitled in respect of that distribution; or the amount of tax deducted from the distribution.

Выписка с указанием суммы или стоимости распределения и налогового кредита, на который получатель имеет право в отношении этого распределения, или суммы налога, вычитаемого из распределения.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">TerminalManagementAction" id="bd3260ac-0869-4f73-a304-dc869e2a79df">
          <documentation> Terminal management action to be performed by the point of interaction.

Действие управления терминалом, выполняемое точкой взаимодействия.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">TerminalManagementSystem" id="95cee1d7-b51a-48f7-ba5b-22b648c394d8">
          <documentation> Terminal management system (TMS), has in charge the maintenance of the terminal, including monitoring, software update, configuration parameters management.

Терминальная система управления (TMS), имеет на попечении обслуживание сборов_плат, включая контроль, актуализацию программного обеспечения, управление параметров конфигурации.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">TerminalManagerRole" id="d822a190-a31f-4ffe-a48b-fc406f2eb51b">
          <documentation> Identifies the party which is the terminal manager (TM) to contact for the maintenance.

Определяет сторону, которая является менеджером терминала (TM), чтобы связаться для обслуживания.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ThirdPartyRole" id="880667ba-09aa-4db1-8380-c4529580ec86">
          <documentation> Party that can use the facilities of a system through one of its members.

Сторона, которая может использовать возможности системы через одного из своих членов.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ThirdReimbursementAgent" id="5a73ccc9-90ab-4d0d-b0b1-e8ef2ebe7b9f">
          <documentation> Specifies the branch of the instructed agent where the amount of money will be made available when different from the instructed reimbursement agent.

Указывает филиала обученный агент, где количество денег будет доступна, когда отличается от поручил агенту возмещения.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Trade" id="dceb6fcd-d86c-4a68-ae14-fd8f105f0966">
          <documentation>trade/ результат заказа: поставка товара 

Result of an order between at least two parties. A trade relates to the delivery of goods and services, cash or securities.

Результат заказа между по крайней мере двумя сторонами. Торговля относится к поставке товаров и услуг, денежных средств или ценных бумаг.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">TradeCertificate" id="1c831a7f-cde7-48ab-b92a-075cb6815bff">
          <documentation> Formal document used to record a fact and used as proof of the fact, in the context of a commercial trade transaction.

Формальный документ, используемый для регистрации факта и используемый в качестве доказательства факта в контексте коммерческой торговой сделки.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">TradeCertificatePartyRole" id="5e4b141d-270a-4403-bb6e-1a86cb587bce">
          <documentation> Role played by a party in the context of issuing trade certificates.

Роль стороны в контексте выдачи торговых сертификатов.

</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">TradeIdentification" id="92ca99d0-5acb-4165-8543-d286cc1af8e7">
          <documentation> Specifies the different identifications associated with a trade.

Указывает различные идентификаторы, связанные с торговлей.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">TradeOriginatorRole" id="9eb25beb-81a3-46ac-ab95-7850618e5e81">
          <documentation> Specifies the trading party at the source of the transaction.

Указывает Торговую сторону у источника сделки.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">TradePartyRole" id="a229b956-5d3b-4651-97d7-4c253e53bde0">
          <documentation> Trading party in a commercial, securities, treasury trade. This role may also represent parties which play different intermediary roles in a trade.

Торговая сторона в коммерческой, ценных бумагах, казначейской торговле. Эта роль может также представлять стороны, которые играют различные посреднические роли в торговле.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">TradeRegulator" id="c1ad929c-92a0-4aff-a863-47bc3f61b223">
          <documentation> Institution to which a trade must be reported.

Учреждение, которому необходимо сообщить о сделке.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">TradingMarket" id="dbbc4214-2494-4533-b335-18da3611a799">
          <documentation> Context or geographic environment in which trading parties may meet in order to negotiate and execute trades among themselves. It also identifies the primary market where an asset is issued.

Контекст или географическая среда, в которой торговые стороны могут встречаться для ведения переговоров и совершения сделок между собой. Он также определяет первичный рынок, на котором выдается актив.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">TradingSession" id="4f4a0730-84be-4464-8167-88323ac3c9b4">
          <documentation> Established constraints under which a market operates

Установленные ограничения, при которых функционирует рынок</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Tranche" id="59c460f1-709d-4d95-8991-98545409d2e2">
          <documentation> One of a number of related assets offered as part of the same transaction. The detachment point less the attachment point represents the maximum loss.

Один из нескольких связанных активов, предлагаемых в рамках одной и той же сделки. Точка отсоединения меньше точки прикрепления представляет максимальную потерю.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">TransactionAdministrator" id="60033cda-48ec-483f-a3d1-56548fafaafd">
          <documentation> Set of integrated applications that provides centralised services such as clearing and settlement.

Набор интегрированных приложений, предоставляющих централизованные услуги, такие как клиринг и расчеты.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">TransactionRisk" id="5d7cc5ec-6a91-45f5-9a39-6f90e277402c">
          <documentation> Calculation of the exposure amount that one party has vis-a-vis one counterparty or a central system, based on the transactions that are not yet settled.

Расчет суммы риска, которую одна сторона имеет по отношению к одному контрагенту или центральной системе, на основе проводок, которые еще не сопоставлены.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Transport" id="f45be1f3-db9f-4afe-8c7f-380c4f1e795c">
          <documentation> Moving of goods or people from one place to another by vehicle.

Перемещение товаров или людей с одного места в другое на каком-либо двигателе.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">TransportByAir" id="02b1db0e-11bf-4dbd-82f7-2ebe028084d6">
          <documentation> Information related to the transportation of goods by air.

Информация, касающаяся перевозки грузов воздушным транспортом.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">TransportByRail" id="c34ae794-af39-40d1-993c-0c54794c6e06">
          <documentation> Information related to the transportation of goods by rail.

Информация, касающаяся перевозки грузов железнодорожным транспортом.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">TransportByRoad" id="98f0a3a4-69a4-4ec5-8ab1-01da9b7c49ba">
          <documentation> Information related to the transportation of goods by road.

Информация, связанная с перевозкой грузов автомобильным транспортом.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">TransportBySea" id="84c3d8b9-8dac-49b1-a004-728765ba64e2">
          <documentation> Information related for the transportation of goods by sea.

Информация, касающаяся морской перевозки грузов.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">TransportPartyRole" id="4e211f14-a6aa-48e6-a78e-cc36df8d00cf">
          <documentation> Role played by a party in the context of transporting goods.

Роль стороны в контексте перевозки грузов.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">TreasuryManager" id="127d12bd-aead-4484-9f7f-8206e66b015e">
          <documentation> Person responsible for the treasury department within an organisation.

Лицо, ответственное за казначейство в рамках организации.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">TreasurySettlementPartyRole" id="e6962c37-0fde-4b7c-9b90-e5e03f29f734">
          <documentation> Role played by a party in the context of the settlement of a treasury trade.

Роль стороны в уплате_рассчетах казначейской сделки.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">TreasurySettlementSystem" id="db89f6f4-190d-4473-8611-ed2bc903fa42">
          <documentation> Centralised system in which a central party settles treasury trades between members.

Централизованная система, в которой центральная партия осуществляет казначейские сделки между членами.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">TreasurySettlementSystemRole" id="23bcc27a-88a6-4705-97c3-4d4d1e5ba30a">
          <documentation> System involved in the settlement chain of one leg of a treasury trade.

Система участвует в расчетной_уплатах цепочке одного этапа казначейской торговли.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">TreasuryTrade" id="1a58720a-40c7-4489-a5bf-6a70830b7703">
          <documentation> Specifies trades linked to treasury operations such as the exchange of currencies, the lending of cash amounts and the related derivatives trades (options and non deliverable trades).

Определяет сделки, связанные с казначейскими операциями, такими как обмен валют, кредитование денежных сумм и связанные с ними сделки с производными финансовыми инструментами (опционы и беспоставочные сделки).</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">TreasuryTradePartyRole" id="ce1c5e6e-4c4f-4143-b122-a75ba9ac1dd1">
          <documentation> Role played by a party in the context of a treasury trade.

Роль партии в контексте торговой казны.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">TreasuryTradeSettlementStatus" id="079d2fba-b2ea-4275-ad40-901aedc1aa4d">
          <documentation> Specifies the status of a treasury trade at a specified time.

Указывает состояние казначейской сделки в указанное время.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">TreasuryTradingParty" id="d9143e16-fa96-4ff9-825b-0dd3e45c71f7">
          <documentation> Party that negotiates and executes treasury transactions on its behalf or on behalf of another party.

Сторона, которая ведет переговоры и осуществляет казначейские операции от своего имени или от имени другой стороны.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Trigger" id="d113b538-1df9-4c50-b8e4-83132cf93f9b">
          <documentation> Trigger that causes the variation to come into effect.

Триггер, который приводит к вступлению изменения в силу.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">TripartyAgent" id="a6dd140f-6e8a-4f90-b07c-d76aecd864bd">
          <documentation> Agent which acts as an intermediary between two parties for the administration of tri-party collateral transactions.

Агент, который выступает в качестве посредника между двумя сторонами для управления трехсторонними сделками с обеспечением.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">TrusteeRole" id="5a806373-a8d3-4158-910f-62afc9eb2b33">
          <documentation> Legal owner of the property. However, the beneficiary has the equitable or beneficial ownership. The trustee must ensure all terms and conditions of the security are adhered to.


Законный владелец недвижимости. Однако бенефициар является равноправным или бенефициарным собственником. Доверительный управляющий должен обеспечить соблюдение всех условий обеспечения.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">UltimateCreditorRole" id="53d26227-781a-47a4-8f63-3f1e192c4413">
          <documentation> Ultimate party to which an amount of money is due.

Конечная сторона, которой причитается денежная сумма.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">UltimateDebtorRole" id="32ca65c3-5416-4948-9608-cd09a75b2e85">
          <documentation> Ultimate party that owes an amount of money to the (ultimate) creditor.

Конечная сторона, которая должна определенную сумму денег (конечному) кредитору.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">UnderlyingTransaction" id="0fa3fb6f-b083-4647-8206-635ef362ede0">
          <documentation> Reference information on a commercial obligation between the beneficiary and applicant for which an undertaking is issued.

Справочная информация о коммерческом обязательстве между бенефициаром и заявителем, для которого выдается обязательство.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Undertaking" id="fa8b8b64-0db1-4e7d-a39c-e88335d8f4f9">
          <documentation>undertaking / обязательство: гарантия

 Independent undertaking, such as a demand guarantee or standby letter of credit, that provides financial assurance, to be collected on the presentation of documents that comply with its terms and conditions.

Независимое обязательство, такое как гарантия по требованию или резервный аккредитив, которое обеспечивает финансовую гарантию, должно быть собрано при представлении документов, соответствующих его условиям.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">UndertakingAdvisingParty" id="1233924b-b18d-4fc6-b1b3-725bee0828fd">
          <documentation> Party that advises the undertaking at the request of the issuer. For further clarification, reference the applicable rules to which the undertaking is subject.


Сторона, консультирующая предприятие по требованию эмитента. Для дальнейшего уточнения, ссылки на действующие правила, к которым предприятие подлежит.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">UndertakingAmount" id="ebc8b6b4-973f-42dd-afc7-8e23d9dbb111">
          <documentation> Amount of an undertaking such as a guarantee or standby letter of credit.

Сумма обязательства, такого как гарантийный или резервный аккредитив.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">UndertakingApplicant" id="6c1be227-c877-4c7e-adb7-f450cc2f3519">
          <documentation> Party named in an undertaking as the party on whose behalf the undertaking is issued.

Сторона, названная в обязательстве в качестве стороны, от имени которой выдается обязательство.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">UndertakingBeneficiary" id="b4d5b9f6-cf8e-40d6-9d5c-7d23b7aeccea">
          <documentation> Party in whose favour the undertaking (or counter-undertaking) is issued.

Сторона, в пользу которой выдается обязательство (или встречное обязательство).</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">UndertakingConfirmer" id="ed61ef02-d9c7-4a83-a213-e2d1c0739579">
          <documentation> Party that adds its confirmation to the undertaking.

Сторона, которая добавляет свое подтверждение к обязательству.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">UndertakingDocument" id="8279fee6-821e-4fdb-b86f-c5f06cdd7e0c">
          <documentation> Document presented.

Представлен документ.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">UndertakingExtension" id="2cd38028-31f2-4757-8f35-24232e6ad2f8">
          <documentation> Specifies information related to the extension of an undertaking.

Указывает информацию, связанную с расширением гарантий.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">UndertakingInstructingParty" id="f2908898-d352-42e3-8128-b0c3ec68040b">
          <documentation> Party that instructs the issuance of the undertaking.

Сторона, которая поручает выдачу обязательства.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">UndertakingIssuer" id="4965e725-848d-4636-8336-f7743874b61d">
          <documentation> Party that issues the undertaking (or counter-undertaking).

Сторона, которая выдает обязательство_гарантию (или встречное обязательство_гарантию).</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">UndertakingPartyRole" id="248905de-ca52-4cb0-8d30-19ff712e152d">
          <documentation> Role played by a party in the context of an undertaking.

Роль партии в контексте гарантии.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">UndertakingPlaceOfPresentation" id="ef745bd0-2f49-4d0f-a3e7-0757b19a9882">
          <documentation> Place at which the documents must be presented.

Место, в котором должны быть представлены документы.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">UndertakingPresenter" id="d765bb52-cd22-4bbe-9eed-78dc9ac437ea">
          <documentation> Party that makes the presentation.

участник_, которая делает презентацию.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">UndertakingStatus" id="85f3d3fe-05f7-4e20-80b9-b23b0db813ae">
          <documentation> Status of the undertaking.

Статус грантии.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">UndertakingStatusReason" id="d1d70999-dd9e-4fe2-b283-b3a7385aa914">
          <documentation> Specifies the reason for the status or for the action (for instance settlement reason).

Указывает причину состояния или действия (например, причину уплаты).</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">UndertakingUltimateObligor" id="0774d99b-403a-4821-b988-18b3c63bdd27">
          <documentation> Party that takes responsibility for indemnifying the issuer.

Сторона, которая берет на себя ответственность за возмещение убытков эмитенту.

</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ValidatingPartyRole" id="b598c1a9-2b78-4354-9f56-b898842ce665">
          <documentation> Identification of the person who validated the signature.

Идентификация лица, подтвердившего подпись.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">ValuationStatistics" id="216a9703-85d4-4743-8679-05a5b119f698">
          <documentation> Statistical data related to the price change of a security.

Статистические данные, связанные с изменением цены ценной бумаги.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">VariationMarginTerm" id="5fed0235-5727-49fa-83dc-a20697245bbe">
          <documentation> Defines the specific terms used to calculate a variation margin.

Определяет конкретные термины, используемые для расчета вариационной маржи.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">VoluntaryCorporateAction" id="312cc147-1958-4bc3-9727-b2c65d3638e8">
          <documentation> Participation in the corporate action is voluntary. To take part in the event, the account owner must provide its instructions.

Участие в корпоративной акции является добровольным. Чтобы принять участие в мероприятии, владелец аккаунта должен предоставить свои инструкции.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Vote" id="955a9027-9a66-4653-9843-fda1474e2c5f">
          <documentation> Number of votes assigned to each voting option.

Количество голосов, присвоенных каждому варианту голосования.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">VoteDeadline" id="68df3bf7-9aad-4ac6-a918-7749c436db53">
          <documentation> Date and time by which the vote instructions should be submitted.

Дата и время представления инструкций по голосованию.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">VoteInstructionRequest" id="0e8161ed-17c7-411a-a23c-1a918ee3ca84">
          <documentation> Decision of the voting party for one resolution. Several types of decisions can be indicated to allow for split vote specification.

Решение голосующей партии по одному решению. Можно указать несколько типов решений, чтобы разрешить разделение голосования.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">VoteRegistrationDeadline" id="5fea925c-4359-4793-8539-ad3abf5479be">
          <documentation> Date/time by which the beneficial owner or agent must notify of their intention to participate in a meeting.

Дата/время, к которому бенефициарный владелец или агент должен уведомить о своем намерении участвовать в собрании.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">VoteResult" id="50b32b94-ccf6-4e56-85da-8d910e6a2da2">
          <documentation> Specifies whether an agenda item of a general meeting has been accepted or rejected, together with the number of votes.

Указывает, был ли принят или отклонен пункт повестки дня Общего собрания, а также количество голосов.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">VoteRevocabilityDeadline" id="e66096ab-c29a-4850-8b32-2f9345a98cc7">
          <documentation> Specifies the different deadlines available for revoking a casted vote.

Определяет различные предельные сроки для отзыва поданного голоса.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">VoteWithPremiumDeadline" id="340c0807-c63f-4b3c-b1bf-bfcd7f5eef5d">
          <documentation> Specifies the different deadlines available for submitting vote instructions to take advantage of the premium.

Определяет различные сроки, доступные для подачи инструкций по голосованию, чтобы воспользоваться премией.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">VotingCondition" id="0fc23f4b-2d59-4366-a984-18c13b9e5779">
          <documentation> Specifies the different voting types, channels and premium.

Определяет различные типы голосования, каналы и премии.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">VotingPartyRole" id="486b33b3-ebf6-4a8f-b530-96d89aad96bd">
          <documentation> Party that has indicated its voting decision on one agenda item or on the entirety of the agenda.

Сторона, которая сообщила о своем решении голосовать по одному пункту повестки дня или по всей повестке дня.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">Warrant" id="f3f58ea4-e150-40fa-be89-d210cb80f877">
          <documentation> Financial instrument that gives the holder the right to purchase shares or bonds at a given price within a specified time.

Финансовый инструмент, дающий владельцу право приобрести акции или облигации по заданной цене в течение определенного времени.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">WarrantAgent" id="3b7b0a57-59e9-4f9d-a39f-0004928aa072">
          <documentation> Entity appointed by the issuer to process the exercising of warrants, sometimes responsible for the issuance of the warrants into the market.

Организация, назначенная эмитентом для обработки исполнения ручательств_, иногда ответственная за выпуск ручательств_ на рынок.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name=">YieldCalculation" id="6f3ca066-b4b4-4aef-ae58-27ce0aac1f07">
          <documentation> Characteristics related to the yield.

Признаки, связанные с урожайностью.</documentation>
        </element>
      </folder>
    </folder>
  </folder>
  <folder name="Application" id="27b89123-aa6d-469c-b3d9-675465627af9" type="application"/>
  <folder name="Technology &amp; Physical" id="05a3073a-5596-4bb4-a44d-4b822519c754" type="technology"/>
  <folder name="Motivation" id="e14704ee-f691-4856-a9f9-22fb0e88841f" type="motivation"/>
  <folder name="Implementation &amp; Migration" id="67d506d4-cbb0-4c32-be3b-70a5851bc767" type="implementation_migration"/>
  <folder name="Other" id="a2ec6b7b-8b73-4504-92d5-b6fd09808a5a" type="other">
    <folder name="Business Domains" id="c25f04b0-6472-4549-9092-615608201649">
      <element xsi:type="archimate:Grouping" name="Account Management" id="748781c7-228c-43de-8143-d69bc5115de8">
        <documentation> This Business Domain groups together a range of Service Domains that support account and account related services for cash/currency and reward point accounts. It includes account reconciliation, accounts receivable processing and some broader consolidated position management and fraud detection facilities.


Этот бизнес домен группирует различные домены службу поддержки учетной записи и предоставление услуг за наличный/валюта и баллов счетов. Она включает в себя выверку счетов, обработку дебиторской задолженности и некоторые более широкие средства управления консолидированной позицией и обнаружения мошенничества.</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="Bank Portfolio &amp; Treasury" id="fc3bb5e2-9920-447f-a5a7-e85f12cf6497">
        <documentation> This domain draws together the Group Treasury and overall bank portfolio management activities as might be overseen by the bank's asset and liability committee (ALCO) or equivalent policy function. It includes some functions typically related to managing the balance sheet (repos and securitization).



Эта область объединяет казначейскую деятельность группы и деятельность по управлению портфелем ценных бумаг банка в целом, которая может контролироваться комитетом по активам и пассивам банка (ALCO) или аналогичной функцией политики. Она включает в себя некоторые функции, обычно связанные с управлением балансом (РЕПО и секьюритизация).</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="Buildings, Equipment  and Facilities" id="b6aa6cbd-7b4b-40b6-9bca-373a0d336941">
        <documentation>This Business Domain covers all activities associated with the acquisition, administration, operation and maintenance of buildings and non-IT equipment (this can include fleet/transport facilities when appropriate).



Эта сфера деятельности охватывает все виды деятельности, связанные с приобретением, управлением, эксплуатацией и техническим обслуживанием зданий и не относящегося к ИТ оборудования (в соответствующих случаях сюда могут входить транспортные средства).</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="Business Analysis" id="ceed5c98-43b4-4a23-8583-26d9d6c8fc5d">
        <documentation> This Business Domain consolidates the range of enterprise and divisional performance analysis activities covering general areas such as customer segment and product profitability and more targeted/specialized considerations such as channel. branch portfolio and contribution analysis.




Эта бизнес-область объединяет ряд мероприятий по анализу эффективности предприятий и подразделений, охватывающих общие области, такие как потребительский сегмент и рентабельность продукции, а также более целенаправленные/специализированные соображения, такие как канал. анализ отраслевого портфеля и вклада.</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="Business Command  &amp; Control" id="47a3d947-c863-40d5-9c95-85dddf5b8fdd">
        <documentation> This Business Domain contains the range of capabilities associated with the organizational command and control structure of the enterprise. Typically these Service Domains may be repeated and/or may be structured to handle multiple Lines of Business, Legal Entities and/or Business Units (profit/cost centers) as necessary to reflect the specific structure of the enterprise. The command and control structure is derived following the Model Bank approach outlined in the BIAN How To Guides.



Этот бизнес-домен содержит диапазон возможностей, связанных с организационной структурой управления предприятием. Как правило, эти домены услуг могут повторяться и/или могут быть структурированы для обработки нескольких направлений бизнеса, юридических лиц и/или бизнес-единиц (центров прибыли/затрат) по мере необходимости для отражения конкретной структуры предприятия. Структура командования и управления выводится в соответствии с подходом Банка моделей, описанным в руководстве BIAN How To.</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="Business Direction" id="b51f9170-1018-493b-b666-69485eb83525">
        <documentation> This Business Domain contains the enterprise's executive functions (policies, strategy and direction) and some enterprise wide tasks such as business architecture and continuity planning.



Этот бизнес-домен содержит исполнительные функции предприятия (политики, стратегии и направления) и некоторые общеорганизационные задачи, такие как бизнес-архитектура и планирование непрерывности.</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="Cards" id="44ddea93-22fb-4367-8864-3d1eda45d0f0">
        <documentation> The Cards Business Domain contains the fulfillment Service Domains for all cards related products (Credit &amp; Charge). Note that debit cards associated with a current account may leverage some of these capabilities and that many merchant related activities are not fully represented in the model at this stage.



Бизнес-домен карты содержит Домены службы выполнения для всех продуктов, связанных с картами (Credit &amp; Charge). Обратите внимание, что дебетовые карты, связанные с текущим счетом, могут использовать некоторые из этих возможностей и что многие действия, связанные с продавцом, не полностью представлены в модели на данном этапе.</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="Channel Specific" id="c6aa68b2-f40a-42c3-8834-c7d3b6a21704">
        <documentation>This business domain includes a mixture of service domains that provide the management, configuration and operation of the different channels used by customers to access the products and services of the bank. It includes activities associated with the physical branch network and the movements of physical cash and non-cash inventory.


Этот бизнес-домен включает в себя сочетание сервисных доменов, которые обеспечивают управление, настройку и работу различных каналов, используемых клиентами для доступа к продуктам и услугам банка. Она включает в себя деятельность, связанную с физической филиальной сетью и движением наличных и безналичных средств.


Бизнес-домен: Каналы &#xD;
&#xD;
Этот бизнес-домен включает в себя совокупность сервис-доменов, обеспечикающих управление, настройку и работу различных каналов, используемых клиентами для доступа к продуктам и услугам банка. &#xD;
Сюда относится работа с физической сетью отделений обслуживания, движением физических денежных и безналичных средств.</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="Collateral  Administration" id="aafc2ec7-c0ff-456f-acd2-1480023882fd">
        <documentation> This Business Domain provides the fairly narrow grouping of Service Domains that support the management allocation and recovery of collateral against a customer.


Этот бизнес-домен предоставляет довольно узкую группу доменов обслуживания, которые поддерживают распределение управления и восстановление обеспечения против клиента.</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="Consumer Services" id="7ced02bf-2073-4727-9cfe-946789a40b35">
        <documentation> This Business Domain brings together a number of services typically provided to consumer customers such as remittances, currency exchange, tax, investment and 3rd party product offerings (e.g. insurance). It also handles any consumer tax reporting obligations.



Эта область бизнеса объединяет ряд услуг, обычно предоставляемых потребителям, таких как денежные переводы, обмен валюты, налоги, инвестиции и предложения продуктов сторонних производителей (например, страхование). Он также обрабатывает любые обязательства по налоговой отчетности потребителей.</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="Corporate Financing &amp; Advisory Services" id="1c06d337-238b-4924-b652-5121c9250614">
        <documentation> This Business Domain covers the corporate finance and advisory services offered to corporate clients including corporate finance advice, IPOs, M&amp;A and private and public offerings.



Эта бизнес-область охватывает корпоративные финансы и консультационные услуги, предлагаемые корпоративным клиентам, включая консультации по корпоративным финансам, IPO, M&amp;A и частные и публичные предложения.</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="Corporate Relations" id="7d956be9-d6ec-47dc-b223-ad1de6c28fa4">
        <documentation> This Business Domain contains Service Domains that handle general corporate communications (with interested parties including investors) and the relationships with key legal and regulatory authorities.



Этот бизнес-домен содержит Домены услуг, которые обрабатывают общие корпоративные коммуникации (с заинтересованными сторонами, включая инвесторов) и отношения с ключевыми правовыми и регулирующими органами.</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="Cross Channel" id="85ccbcbd-aac6-45b4-bebc-395817aa805a">
        <documentation>This business domain contains the collection of Service Domains that handle the customer interaction across all possible channels, including customer identity authentication and activity authorization. It supports multiple session/device contacts and enables the leverage of the customer interaction and the build-up and analysis of access history.


Этот бизнес-домен содержит коллекцию доменов служб, которые обрабатывают взаимодействие с клиентами по всем возможным каналам, включая проверку подлинности удостоверения клиента и авторизацию действий. Он поддерживает множественные контакты встречи / прибора и включает систему рычагов взаимодействия клиента и нарастания и анализа истории доступа.




Бизнес-домен: &#xD;
&#xD;
Этот бизнес-домен включает в себя &#xD;
Сюда относится </documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="Customer Management" id="0a0b8eba-1a87-44e1-a362-a5a0feed92f9">
        <documentation>This Business Domain covers the main aspects of customer relationship management including product matching/eligibility, agreements, behavioral analysis, relationship development and account recovery.


Этот бизнес-домен охватывает основные аспекты управления взаимоотношениями с клиентами, включая соответствие продукта / право, соглашения, поведенческий анализ, развитие отношений и восстановление учетной записи.




Бизнес-домен: &#xD;
&#xD;
Этот бизнес-домен включает в себя &#xD;
Сюда относится </documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="Document Management &amp; Archive" id="6e029dfc-cf4b-4209-9781-e01b0f192b69">
        <documentation> This Business Domain provides central document management capabilities - covering bulk mailing (in and out bound) general document scanning, indexing and retrieval services and any physical and electronic distribution and archiving capabilities. It assumes some level of centralization of document handling and digitization for streamlining of production operations.



 Этот бизнес-домен предоставляет возможности централизованного управления документами - включая массовую рассылку (входящую и исходящую) общих служб сканирования, индексирования и поиска документов, а также любые физические и электронные возможности распространения и архивирования. Это предполагает определенный уровень централизации документооборота и оцифровки для оптимизации производственных операций.</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="External Agency" id="0617a0e2-3475-4671-bf45-b3c70307916e">
        <documentation>This Business Domain brings together Service Domains that cover the relationship and agreement details for the range of external business relationships.



Этот бизнес-домен объединяет Домены обслуживания, которые охватывают отношения и детали соглашения для диапазона внешних бизнес-отношений.</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="Finance" id="5c8358d9-e7b8-46b7-a52a-7d338bc617d3">
        <documentation> This Business Domain covers the central financial control and reporting activities of the enterprise including division/unit budget negotiations, reporting and financial audit and the assembly and reporting of the financial statements. It also includes enterprise/legal entity tax handling.


Эта сфера деятельности охватывает деятельность предприятия в области центрального финансового контроля и отчетности, включая переговоры по бюджету отдела/подразделения, отчетность и финансовую ревизию, а также сборку и представление финансовых ведомостей. Она также включает в себя обработку налогов предприятия / юридического лица.</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="Human Resource Management" id="4caf6e3b-1010-4a19-aefd-1cab789ab67c">
        <documentation> This Business Domain brings together the wide range of human resource management functions including recruitment, training, assessment and allocation tasks and the range of employee support functions including payroll &amp; benefits, travel and expenses and employee access controls and authorities.


Эта бизнес-область объединяет широкий спектр функций управления человеческими ресурсами, включая набор, обучение, оценку и распределение задач, а также ряд функций поддержки сотрудников, включая заработную плату и льготы, командировки и расходы, а также контроль доступа сотрудников и власти.</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="IT Management" id="301d494e-7e92-44d7-9241-69b9d2b78437">
        <documentation> This Business Domain includes the wide range of IT system operation, development and deployment activities for all production platforms, applications and communications technologies. This includes end user technology and help desk first and second level activities. It also includes the selection and definition of technology plans, policies, guidelines and standards and overall IT financial management and administration.


Этот бизнес-домен включает в себя широкий спектр операций по эксплуатации, разработке и развертыванию ИТ-систем для всех производственных платформ, приложений и коммуникационных технологий. Это включает в себя технологии конечных пользователей и службу поддержки первого и второго уровня деятельности. Она также включает в себя отбор и определение технологических планов, политики, руководящих принципов и стандартов, а также общее финансовое управление и администрирование ИТ.</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="Investment Management" id="7b833c98-0b20-432a-8eba-4d44824da4df">
        <documentation> This Business Domain handles investment activity, covering the managed investment portfolios with associated policies and valuation services and self executed eTrading.


Этот бизнес-домен управляет инвестиционной деятельностью, охватывая управляемые инвестиционные портфели с соответствующими политиками и оценочными услугами и самостоятельно выполняемым eTrading.</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="Knowledge &amp;  IP Management" id="e81ce789-9cd2-48e1-9287-0690a9077948">
        <documentation> This Business Domain supports the banks management and leverage of its intellectual property (IP) assets. This includes the registration/capture of IP, the administration and licensing of IP and infringement detection and responses when necessary.



Этот бизнес-домен поддерживает управление банками и использование их активов интеллектуальной собственности (ИС). Это включает в себя регистрацию / захват ИС, администрирование и лицензирование ИС, а также обнаружение нарушений и реагирование, когда это необходимо.</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="Loans &amp; Deposits" id="8e4b021f-250b-4f53-b94a-d27422193c0c">
        <documentation> This Business Domain contains the Service Domains associated with the fulfillment of the main Loan and Deposit products, it includes the core Current Account or DDA product.


Данный бизнес-домен содержит сервисные домены, связанные с выполнением основных кредитных и депозитных продуктов, включает в себя основной расчетный счет или продукт DDA.</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="Market Data" id="7c9668a9-9b84-40b2-82f1-4f480ce0a908">
        <documentation> This Business Domain covers access to and the internal distribution of the different market research, analysis, news, quote and pricing feeds. This includes the specialized feeds that support trading activity, more general market research and analysis and access to any global directories and information standards.



Этот бизнес-домен охватывает доступ и внутреннее распределение различных маркетинговых исследований, анализа, новостей, котировок и ценовых каналов. Это включает в себя специализированные каналы, которые поддерживают торговую деятельность, более общие исследования и анализ рынка и доступ к любым глобальным каталогам и информационным стандартам.</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="Market Operations" id="ffb9ac0b-33f9-4b7c-83e7-3bfe7f766ba0">
        <documentation> This Business Domain combines various back office and support functions for wholesale trading including clearing and settlement and custodial services. It includes trade reporting, valuations and fund administration activities.



Этот бизнес-домен сочетает в себе различные функции бэк-офиса и поддержки для оптовой торговли, включая клиринговые и расчетные и кастодиальные услуги. Она включает в себя торговую отчетность, оценки и деятельность по управлению фондом.</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="Marketing" id="811389c6-8ae9-43d1-aea8-a828f1c235bb">
        <documentation> This Business Domain covers new business development activities including prospect and internal campaign design and development, customer surveys and advertising.


Эта бизнес-область охватывает новые мероприятия по развитию бизнеса, включая перспективы и внутреннего дизайна кампании и развития, опросы клиентов и рекламы.



Бизнес-домен: &#xD;
&#xD;
Этот бизнес-домен включает в себя &#xD;
Сюда относится </documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="Models" id="2a64fadb-cfbe-444b-b413-a30f006de20a">
        <documentation> This Business Domain covers the development, certification (where necessary) and deployment of a wide range of models and algorithms that may be used across the bank. It includes market risk and valuation models, business and operational risk, employee and customer behavior analyses, credit decisioning and fraud scanners and detection.




Этот бизнес-домен охватывает разработку, сертификацию (при необходимости) и внедрение широкого спектра моделей и алгоритмов, которые могут использоваться в банке. Она включает в себя рыночный риск и модели оценки, бизнес и операционный риск, анализ поведения сотрудников и клиентов, принятие кредитных решений и мошенничество сканеры и обнаружения.</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="Non IT &amp; HR  Enterprise Services " id="cb1fb4ca-bf08-45bb-99fa-73a617f209fb">
        <documentation> This Business Domain brings together a collection of general non-IT related support services including internal audit, security and legal advisory services, supplier management and procurement, fixed asset register and company billing and payments.


Этот бизнес-домен объединяет набор общих вспомогательных услуг, не связанных с ИТ, включая внутренний аудит, безопасность и юридические консультационные услуги, управление поставщиками и закупки, реестр основных средств и выставление счетов и платежи компании.</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="Operational Services" id="b8b7c7f1-f0a1-49fc-b5a3-23d93ca01fad">
        <documentation> This Business Domain brings together a number of general back office services that provide cross product support not directly matched to the other Business Domains in this Business Area.


Этот бизнес-домен объединяет ряд общих служб бэк-офиса, которые обеспечивают поддержку кросс-продуктов, не сопоставляемых напрямую с другими бизнес-доменами в этой бизнес-области.</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="Party" id="10d7b07e-db50-4245-a1a2-1dbfd5751173">
        <documentation>This Business Domain covers the different party/customer reference information that is maintained by the bank for its institutional, corporate and consumer customers. 



Этот бизнес охватывает разные стороны/справочная информация для клиента, который обслуживается банком для корпоративных и частных клиентов.</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="Payments" id="d82a25fb-e05b-44bb-ba99-901c6d6fb1c0">
        <documentation>This Business Domain groups the Service Domains supporting payment transactions, including the various connections to payment networks, central cash management and check processing.



Этот бизнес-домен группирует Домены обслуживания, поддерживающие платежные операции, включая различные подключения к платежным сетям, централизованное управление денежными средствами и обработку чеков.</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="Product Management" id="d4317094-dc5c-4f9e-87e7-35e7248524df">
        <documentation> This Business Domain includes the Service Domains that define and are referenced for all types of internal product information. This includes product designs and specifications, allowed product combinations, eligibility and pricing terms to apply and providing access to associating training and quality assurance.



Этот бизнес-домен включает Домены обслуживания, которые определяют и на которые ссылаются для всех типов внутренней информации о продукте. Это включает оформление изделия и спецификации, позволенные комбинации продукта, выборность и термины оценки примениться и обеспечить доступ к связывать тренировку и проверку качества.</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="Regulations &amp; Compliance" id="03f0c318-cb99-4f3b-9f2d-b2fe4fed95c1">
        <documentation> This Business Domain covers the interpretation support, compliance assurance and regulatory reporting obligations of the bank, including ad-hoc compliance resolution when necessary. Note that general relations with the regulatory authorities are handled at an enterprise level elsewhere in the landscape.



Этот бизнес охватывает толкования поддержки, контроля и отчетности обязанности банка, в том числе специальной резолюции соответствия при необходимости. Следует отметить, что общие отношения с регулирующими органами регулируются на уровне предприятий в других регионах.</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="Sales" id="bd76161d-0176-4d8e-b41f-e15ce8366d76">
        <documentation>This Business Domain covers all aspects of sales planning, campaign execution prospect and opportunity management, product matching and offer processing, including product specialist sales support and commission handling.



Эта бизнес-область охватывает все аспекты планирования продаж, перспективы выполнения кампании и управления возможностями, сопоставления продуктов и обработки предложений, включая поддержку продаж специалистов по продуктам и обработку комиссионных.




Бизнес-домен: &#xD;
&#xD;
Этот бизнес-домен включает в себя &#xD;
Сюда относится </documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="Servicing" id="82ed1dcd-9a24-4fbb-9a8d-3aadce8e75b6">
        <documentation>This Business Domain brings together the fulfillment capabilities for various customer servicing support functions in particular customer case resolution and analysis and customer orders (customer related actions that span product and services).


Этот бизнес-домен объединяет возможности выполнения для различных функций поддержки обслуживания клиентов, в частности разрешения и анализа обращений клиентов и заказов клиентов (действия, связанные с клиентами, которые охватывают продукты и услуги).



Бизнес-домен: &#xD;
&#xD;
Этот бизнес-домен включает в себя &#xD;
Сюда относится </documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="Trade Banking" id="c5be9655-9884-49b5-93c1-a102ca7a2157">
        <documentation> This Business Domain brings together a broad range of trade banking product and service fulfillment Service Domains covering trade finance and the many different cash management services that might be offered.




Эта бизнес-область объединяет широкий спектр торговых банковских продуктов и услуг, охватывающих торговое финансирование и множество различных услуг по управлению денежными средствами, которые могут быть предложены.</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="Wholesale Trading" id="fea6adb2-09d6-4042-8ec9-45561af0913f">
        <documentation>This Business Domain covers a broad range of front office and middle office wholesale trading activities across all major instrument categories (FX/money market, equities, securities, commodities, derivatives). It also covers basic primary market functions such as equity/debt issuance and trading.



Этот бизнес-домен охватывает широкий спектр фронт-офиса и среднего офиса оптовой торговли по всем основным категориям инструментов (FX/денежный рынок, акции, ценные бумаги, товары, деривативы). Он также охватывает основные функции первичного рынка, такие как выпуск акций/долговых обязательств и торговля.</documentation>
      </element>
    </folder>
    <folder name="Functional Patterns (groups)" id="a62b45cd-70d3-4626-967d-24da0864bd09">
      <folder name="Generic Artifact" id="9f42b2c7-5bec-4b55-8be5-c1a91f0beaca">
        <element xsi:type="archimate:Grouping" name="Generic Artifact" id="06d9c0c0-8c29-4d72-875f-63c9f78ed83a"/>
      </folder>
      <folder name="Behavior Qualifier Types" id="2d9df839-eda7-4052-b43c-38f9418067fd">
        <element xsi:type="archimate:Grouping" name="Behavior Qualifier Types" id="2d423311-4f05-42c2-8e22-17e943035673"/>
      </folder>
      <element xsi:type="archimate:Grouping" name="Activity Oversight" id="f9d97aaa-e2de-4dc2-8e2f-5e53acbceb0f"/>
      <element xsi:type="archimate:Grouping" name="Management and Support" id="b734bfd9-5e51-4542-9987-2a3f88e981d1"/>
      <element xsi:type="archimate:Grouping" name="Resource Management" id="0ff2215a-fba2-40be-95c5-d49dd8ab5312"/>
      <element xsi:type="archimate:Grouping" name="Resource Assignment" id="71c45acc-7a2f-449b-9ed1-819f559d971f"/>
      <element xsi:type="archimate:Grouping" name="Production" id="1ca11538-483b-4620-af44-a232c31fc15f"/>
    </folder>
    <folder name="Business Area" id="ce39bf81-430e-458f-a383-4a5fdc95b8e1">
      <element xsi:type="archimate:Grouping" name="BUSINESS SUPPORT" id="a154e612-3dd6-4ecb-8ccf-35166fccad13">
        <documentation>This Business Area spans a wide range of general business management and support activities that may be found in any commercial business and that are therefore not specific to Banking. This area of the Landscape is included for completeness as many banking specific business activities may need to make reference to these more general capabilities.



Эта область бизнеса охватывает широкий спектр общего управления бизнесом и поддержки деятельности, которые могут быть найдены в любом коммерческом бизнесе и, следовательно, не являются специфическими для банковского дела. Эта область ландшафта включена для полноты, так как многие банковские конкретные виды деятельности, возможно, потребуется сделать ссылку на эти более общие возможности.</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="CROSS PRODUCT OPERATIONS" id="248f71b6-0146-4227-bfe9-872737d33852">
        <documentation>This Business Domain is a sub category of Operations &amp; Execution that brings together capabilities that tend to be shared across multiple products, often as a centralized operational capability.



Этот бизнес-домен является подкатегорией операций и выполнения, которая объединяет возможности, которые, как правило, совместно используются несколькими продуктами, часто в качестве централизованной операционной возможности.</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="OPERATIONS &amp; EXECUTION / ОПЕРАЦИИ И ИСПОЛНЕНИЕ" id="efa887b2-1200-4b59-8960-92be2870c947">
        <documentation> This business area includes the full range of product fulfillment activities for wholesale and retail banking, including shared operational capabilities and all front, middle and back office activities. This is probably excessive in scope and so needs to be divided into several new areas. There are currently 4 'sub areas' as working places to group the current range of domains in - Retail Products, Wholesale Products Front/Middle Office, Wholesale Products Back Office, Central Operations.




Это направление бизнеса включает в себя полный спектр деятельности по реализации продуктов для оптового и розничного банкинга, включая общие операционные возможности и все виды деятельности фронт -, мидл-и бэк-офиса. Это, вероятно, чрезмерно по своим масштабам и поэтому необходимо разделить на несколько новых областей. В настоящее время есть 4 &quot;подзоны&quot; в качестве рабочих мест для группировки текущего диапазона доменов в розничной торговле, оптовых продуктов фронт/средний офис, оптовые продукты бэк - офис, центральные операции.</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="REFERENCE DATA" id="b26fc1a1-92f0-475d-a0d1-ef5ca271964b">
        <documentation> The Business Area Reference Data contains all categories of managed business reference information, covering subjects including customer details, business partner details and product details. In the case of products it includes aspects of product design, development and quality assurance. It also covers market data feeds for general research and analysis and the range of more specialized trading support market information feeds. This reference information is widely accessed across other activities of the landscape.




Справочные данные по бизнес-области содержат все категории управляемой справочной бизнес-информации, включая сведения о клиентах, сведения о бизнес-партнерах и сведения о продуктах. В случае продуктов оно включает аспекты оформления изделия, разработки и обеспечения качества. Он также охватывает каналы рыночных данных для общих исследований и анализа, а также ряд более специализированных каналов рыночной информации для поддержки торговли. Это справочная информация широко доступна через другие виды ландшафта.</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="RISK &amp; COMPLIANCE" id="57c5c397-440c-41cc-93b2-5f3f4e67c115">
        <documentation> This Business Area covers the analysis and management of business risk, covering group treasury, asset and liability policies, product and market activities. It includes the handling of regulatory compliance and reporting obligations.



Данное направление деятельности охватывает анализ и управление бизнес-рисками, включая казначейство группы, политику в отношении активов и обязательств, товарную и рыночную деятельность. Она включает в себя обработку нормативных требований и обязательств по отчетности.</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="SALES &amp; SERVICE / ПРОДАЖИ И ОБЕСПЕЧЕНИЕ ПРОДАЖ" id="89fd36df-d223-4aaa-80bd-bb1f80cfff5d">
        <documentation>This business area covers all marketing, business development, customer management and sales and servicing activities. It excludes the fulfillment activities associated with in-force product delivery but includes all customer agreement related activities.



Эта сфера деятельности охватывает весь маркетинг, развитие бизнеса, управление клиентами, продажи и обслуживание. Он исключает действия по выполнению, связанные с доставкой продукта в силу, но включает все действия, связанные с соглашением с клиентом.




Область: Продажи и обеспечение &#xD;
&#xD;
Эта область бизнеса охватывает весь маркетинг, развитие бизнеса, управление клиентами, продажами и обслуживанием. &#xD;
Здесь не рассмастриваются операции, связанные непосредственно с доставкой продукта клиенту, но включаются все предварительные действия по получению согласия от клиента на приобретение продукта.</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="PRODUCT SPECIFIC FULFILLMENT" id="fc04a955-5128-4a5a-a062-135a083db526">
        <documentation> This Business Domain is a sub category of the Operations &amp; Execution Business Area that includes all fulfillment and operational tasks associated with the bank's products and services. Product Specific Fulfillment covers the product specific activities associated with the main groups of banking products.



 Данный бизнес-домен является подкатегорией бизнес-зоны Operations &amp; Execution, которая включает в себя выполнение всех операционных задач, связанных с продуктами и услугами банка. Исполнение по продукту охватывает конкретные виды деятельности по продукту, связанные с основными группами банковских продуктов.</documentation>
      </element>
    </folder>

              </element>
              <element xsi:type="archimate:BusinessInterface" name="retrievePaymentOrderTransaction" id="dbc161ec-455b-4020-9c09-b32d5c698363">
                <documentation> Retrieve a payment order transaction report</documentation>
              </element>
              <element xsi:type="archimate:BusinessInterface" name="UpdatePaymentOrderProcedureUpdate" id="b7eb84c5-1160-48a4-8d79-39fac4ffd175"/>
              <element xsi:type="archimate:BusinessInterface" name="ConfigurePaymentOrderProcedure" id="b7ce5d79-8224-41bc-88e0-da8bfd2384ea"/>
              <element xsi:type="archimate:BusinessInterface" name="RecordPaymentOrderProcedure_Out" id="939d3e3c-2a8d-43ed-b173-b09be0005eee"/>

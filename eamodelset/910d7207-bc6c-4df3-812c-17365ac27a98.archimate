              <documentation>Request a service under the Employee Directory </documentation>
            </element>
            <element xsi:type="archimate:BusinessInterface" name="updateEmployeeDirectory" id="873ecada-0d38-4280-8b9d-b955a5894617">
              <documentation>Update elements of the Employee Directory </documentation>

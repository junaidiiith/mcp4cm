            </element>
            <element xsi:type="archimate:BusinessInterface" name="configureServicingRootCauseAnalysis" id="f116b500-f545-4464-bc29-7a28f2a55d66">
              <documentation>Amend the configuration arrangements/parameters governing the Servicing Root Cause Analysis</documentation>
            </element>
            <element xsi:type="archimate:BusinessInterface" name="recordServicingRootCauseAnalysis" id="e3079a9a-1615-4caf-90ff-f8c2badebd12">
              <documentation>Record activity details/information against the Servicing Root Cause Analysis</documentation>
            </element>
            <element xsi:type="archimate:BusinessInterface" name="requestServicingRootCauseAnalysis" id="576e5595-6daa-469e-b13d-4cc86747f82b">
              <documentation>Request a service under the Servicing Root Cause Analysis</documentation>
            </element>
            <element xsi:type="archimate:BusinessInterface" name="notifyServicingRootCauseAnalysis" id="4f5da909-c676-4d60-9c7e-21a4d1e1a1ea">
              <documentation>Subscribe to Servicing Root Cause Analysis notification services</documentation>
            </element>
            <element xsi:type="archimate:BusinessInterface" name="retrieveServicingRootCauseAnalysis" id="597978b4-2164-4d64-8cd0-af21e1eb7f0a">

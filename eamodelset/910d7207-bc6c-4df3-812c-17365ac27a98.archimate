            </element>
            <element xsi:type="archimate:BusinessInterface" name="activateEmployeeDirectory" id="4d9860db-bef0-48b1-8657-58b748139326">
              <documentation> Assign responsibility for the employee directory

: </documentation>
            </element>
            <element xsi:type="archimate:BusinessInterface" name="configureEmployeeDirectory" id="870d21da-eae8-47d4-9955-6ec3e8f22b7e">
              <documentation> Amend the configuration arrangements/parameters governing the employee directory</documentation>
            </element>
            <element xsi:type="archimate:BusinessInterface" name="recordEmployeeDirectory" id="8908c796-68ef-4579-8164-13dae6ce8e57">
              <documentation>Record activity details/information against the Employee Directory </documentation>
            </element>
            <element xsi:type="archimate:BusinessInterface" name="registerEmployeeDirectory" id="6708e2dc-613a-4489-af84-522896d34545">

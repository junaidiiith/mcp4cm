              </element>
              <element xsi:type="archimate:BusinessInterface" name="requestPaymentExecutionTransaction" id="0a987d4a-bfb9-429a-a19f-ce4d68c4737a">
                <documentation>Request work/decisioning for an active payment transaction</documentation>
              </element>
              <element xsi:type="archimate:BusinessInterface" name="updatePaymentExecutionTransaction" id="ee473384-2458-4e25-966b-5f4148d6267f">
                <documentation>Update/amend details of an active payment execution transaction</documentation>
              </element>
              <element xsi:type="archimate:BusinessInterface" name="notifyPaymentExecutionTransaction" id="f5f247d2-a882-438b-a344-70db09c645ae">

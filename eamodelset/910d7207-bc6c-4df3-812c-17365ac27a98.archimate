              <documentation>Subscribe to Fixed Asset Register Administrative Plan notification services</documentation>
            </element>
            <element xsi:type="archimate:BusinessInterface" name="activateFixedAssetRegisterAdministrativePlan" id="4bbdf53d-5a9c-4f82-910a-43e5ddec7cde">
              <documentation>Assign responsibility for the Fixed Asset Register Administrative Plan</documentation>
            </element>
            <element xsi:type="archimate:BusinessInterface" name="configureFixedAssetRegisterAdministrativePlan" id="519454c3-6769-4ffa-b286-3f587ab696db">
              <documentation>Amend the configuration arrangements/parameters governing the Fixed Asset Register Administrative Plan</documentation>
            </element>
            <element xsi:type="archimate:BusinessInterface" name="recordFixedAssetRegisterAdministrativePlan" id="e5f3a42f-4c93-4281-a0a8-41867c1aa9a1">
              <documentation>Record activity details/information against the Fixed Asset Register Administrative Plan</documentation>
            </element>

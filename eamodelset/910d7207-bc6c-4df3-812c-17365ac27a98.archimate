              <element xsi:type="archimate:BusinessInterface" name="EvaluateFraudCaseAssessmentIntermediary" id="8494b24f-be68-417a-b6a8-0ad62dc320f9"/>
              <element xsi:type="archimate:BusinessInterface" name="EvaluateFraudCaseAssessmentMerchant" id="6fe07968-7ef2-4175-9188-f9c30930df27"/>

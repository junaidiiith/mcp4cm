              <documentation> Execute an automated action against an active customer precedent record</documentation>
            </element>
            <element xsi:type="archimate:BusinessInterface" name="recordCustomerPrecedentsProcedure" id="0206f271-d220-4b27-bd0e-14797ab41253">
              <documentation>Record activity/feedback against an active customer precedent record</documentation>
            </element>

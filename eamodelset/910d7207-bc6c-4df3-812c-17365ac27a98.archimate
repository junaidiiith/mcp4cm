              <documentation>Retrieve Asset &amp; Liability Portfolio Administrative Plan related reports</documentation>
            </element>
            <element xsi:type="archimate:BusinessInterface" name=" configureAsset&amp;LiabilityPortfolioAdministrativePlan" id="f4a8b9ea-96ac-4c01-b009-86177a20df89">

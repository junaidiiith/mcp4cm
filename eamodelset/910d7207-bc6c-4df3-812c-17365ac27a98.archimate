              <documentation>Obtain authorization for some action under the Legal Compliance Assessment</documentation>
            </element>
            <element xsi:type="archimate:BusinessInterface" name="evaluateLegalComplianceAssessment" id="edd5da78-3da7-4fb2-bc2d-e24f30dadb7d">
              <documentation>Check/verify compliance with Legal Compliance related checks/assessments</documentation>
            </element>

              <documentation> Update work tasks and activity details for the card p o s network administrative plan</documentation>
            </element>
            <element xsi:type="archimate:BusinessInterface" name="notifyCardPOSNetworkAdministrativePlan" id="727a3792-83b6-4648-80ad-7009d90f46e8">

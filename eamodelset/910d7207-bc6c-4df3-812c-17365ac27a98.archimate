            </element>
            <element xsi:type="archimate:BusinessInterface" name="recordCustomerCreditRatingMeasurementProduct/ServiceAlert" id="8c451d95-2146-47ed-9b6e-a136e26abff8">
              <documentation>Record internal event/alerts impacting credit view</documentation>
            </element>
            <element xsi:type="archimate:BusinessInterface" name="requestCustomerCreditRatingMeasurement" id="76976280-0399-4dbe-a001-f099f3ce0b3e">
              <documentation> Request to undertake credit view refresh/reworking</documentation>
            </element>
            <element xsi:type="archimate:BusinessInterface" name="terminateCustomerCreditRatingMeasurement" id="dbc91be2-6fd2-42f5-8d75-092c3c3dd5c8">

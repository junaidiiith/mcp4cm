              <documentation>Subscribe to Financial Booking Account/Log notification services</documentation>
            </element>
            <element xsi:type="archimate:BusinessInterface" name="recordFinancialBookingLog" id="37c33822-70ff-4002-855a-751edd0057a8">
              <documentation>Record a sub-ledger entry (includes classification)</documentation>
            </element>
            <element xsi:type="archimate:BusinessInterface" name="retrieveFinancialBookingLog" id="66d7ce03-719f-469f-b377-0741cfbe4117">

              <documentation>Request a service under the Credit &amp; Margins Strategy </documentation>
            </element>
            <element xsi:type="archimate:BusinessInterface" name="notifyCredit&amp;MarginsStrategy" id="aa55b2e1-a925-48ca-a8d8-d0a8137cf6b3">
              <documentation>Subscribe to Credit &amp; Margins Strategy notification services</documentation>
            </element>

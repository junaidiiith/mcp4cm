              <documentation>Comment:

Assign responsibility for the Card Case Procedure</documentation>
            </element>
            <element xsi:type="archimate:BusinessInterface" name="configureCardCaseProcedure" id="7ce389f0-5e3d-4cda-a206-692e41aaed71">
              <documentation>Comment:

Amend the configuration arrangements/parameters governing the Card Case Procedure</documentation>
            </element>
            <element xsi:type="archimate:BusinessInterface" name="executeCardCaseProcedure" id="bcfef532-f4f3-45ed-b086-99c005dd077b">
              <documentation>Execute a task under the Card Case Procedure</documentation>
            </element>
            <element xsi:type="archimate:BusinessInterface" name="recordCardCaseProcedure" id="cb4893e3-4365-47eb-9b0d-e6d2ccf5204f">
              <documentation>Record activity details/information against the Card Case Procedure</documentation>

            </element>
            <element xsi:type="archimate:BusinessInterface" name="requestEmployeeAgreement" id="b12b7374-6957-45f8-ae4d-553ce47d80aa">
              <documentation>Request a service under the Employee Agreement </documentation>
            </element>
            <element xsi:type="archimate:BusinessInterface" name="terminateEmployeeAgreement" id="669f8320-06df-446b-9f6a-267e0725c4be">

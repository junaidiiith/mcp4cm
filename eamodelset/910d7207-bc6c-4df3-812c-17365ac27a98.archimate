              <documentation>Assign responsibility for the Correspondent Bank Relationship Management Plan</documentation>
            </element>
            <element xsi:type="archimate:BusinessInterface" name="recordCorrepondentBankRelationshipManagementPlan" id="af99572f-0322-4e11-abce-b3d23e208139">
              <documentation>Comment:

Record activity details/information against the Correspondent Bank Relationship Management Plan</documentation>
            </element>
            <element xsi:type="archimate:BusinessInterface" name="Comment:  Request a service under the Correspondent Bank Relationship Management Plan" id="0e3d65f0-25d3-4a18-a424-2cf4a88b00b3">
              <documentation>Comment:

Request a service under the Correspondent Bank Relationship Management Plan</documentation>
            </element>
            <element xsi:type="archimate:BusinessInterface" name="Terminate all or some part of the Correspondent Bank Relationship Management Plan" id="0fc7af25-2198-4e53-8cd2-e4778f0c4b62">
              <documentation>Terminate all or some part of the Correspondent Bank Relationship Management Plan</documentation>
            </element>

                <documentation>Terminate all or some part of the eTrading Workbench Operating Session</documentation>
              </element>
              <element xsi:type="archimate:BusinessInterface" name="retrieveeTradingWorkbenchOperatingSession" id="79ac7ed2-f961-46c0-85e6-7d6d3ef05a93">
                <documentation>Retrieve eTrading Workbench Operating Session related reports</documentation>
              </element>
              <element xsi:type="archimate:BusinessInterface" name="notifyeTradingWorkbenchOperatingSession" id="abc4ecc1-e708-4564-8296-23d048449008">
                <documentation>Subscribe to eTrading Workbench Operating Session notification services</documentation>
              </element>

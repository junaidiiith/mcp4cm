              <element xsi:type="archimate:BusinessInterface" name="requestMutualFundAdministrativePlan" id="a95b1f27-6eb8-4366-ac6a-3eee16702f8d">
                <documentation>Request a service under the Mutual Fund Administrative Plan</documentation>
              </element>

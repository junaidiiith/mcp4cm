                <documentation>Amend the configuration arrangements/parameters governing the Unit Trust Administrative Plan</documentation>
              </element>
              <element xsi:type="archimate:BusinessInterface" name="recordUnitTrustAdministrativePlan" id="ce5253c6-9005-4eeb-9f5c-8766eaabe0dc">
                <documentation>Record activity details/information against the Unit Trust Administrative Plan</documentation>
              </element>
              <element xsi:type="archimate:BusinessInterface" name="requestUnitTrustAdministrativePlan" id="13b0f8a9-1e7f-4324-bd35-4e2431373319">
                <documentation>Comment:

Request a service under the Unit Trust Administrative Plan</documentation>
              </element>
              <element xsi:type="archimate:BusinessInterface" name="terminateUnitTrustAdministrativePlan" id="4436a428-391d-4bf3-aa81-043e42990530">
                <documentation>Terminate all or some part of the Unit Trust Administrative Plan</documentation>
              </element>
              <element xsi:type="archimate:BusinessInterface" name="retrieveUnitTrustAdministrativePlan" id="403bb1c1-cdb9-4506-94b3-7a8c15ad8a72">
                <documentation>Retrieve Unit Trust Administrative Plan related reports</documentation>
              </element>
              <element xsi:type="archimate:BusinessInterface" name="updateUnitTrustAdministrativePlan" id="82b3352c-8b2a-419f-89d5-cf010cae5f53">
                <documentation>Update tasks or elements of the Unit Trust Administrative Plan</documentation>
              </element>

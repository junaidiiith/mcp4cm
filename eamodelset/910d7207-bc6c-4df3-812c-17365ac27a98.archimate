              <documentation>Amend the configuration arrangements/parameters governing the Security Compliance Procedure</documentation>
            </element>
            <element xsi:type="archimate:BusinessInterface" name="executeSecurityComplianceProcedure" id="0c024ec4-0556-455e-a253-409f62962f01">
              <documentation>Execute a task under the Security Compliance Procedure</documentation>
            </element>

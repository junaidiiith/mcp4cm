              <documentation>Request a service under the Repo Transaction</documentation>
            </element>
            <element xsi:type="archimate:BusinessInterface" name="updateRepoTransaction" id="22f94b8e-394b-40ec-b18e-91af0ec031e3">
              <documentation>Update elements of the Repo Transaction</documentation>

              <element xsi:type="archimate:BusinessInterface" name="retrieveDunningProcedure" id="691cdd71-6c14-432e-8e53-512d260729e4">
                <documentation>Retrieve delinquency processing report</documentation>
              </element>
              <element xsi:type="archimate:BusinessInterface" name="updateDunningProcedure" id="60c12ce3-0f91-4b9a-b869-68f32d207ebe">

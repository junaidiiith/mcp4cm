                <documentation>Terminate all or some part of the Managed Investment Portfolio Agreement</documentation>
              </element>
              <element xsi:type="archimate:BusinessInterface" name="updateManagedInvestmentPortfolioAgreement" id="5e5818be-b1d3-49da-9328-975e607805df">
                <documentation>Update elements of the Managed Investment Portfolio Agreement</documentation>
              </element>

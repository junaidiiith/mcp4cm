                <documentation>Amend the configuration arrangements/parameters governing the Fraud Case Assessment service</documentation>
              </element>
              <element xsi:type="archimate:BusinessInterface" name="authorizeFraudCaseAssessment" id="3fe686c9-5c16-4f60-b191-317f941a18ce">
                <documentation>Obtain authorization for some action under the Fraud Case Assessment</documentation>

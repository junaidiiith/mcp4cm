                <documentation>Assign responsibility for the Reward Points Account/Log</documentation>
              </element>
              <element xsi:type="archimate:BusinessInterface" name="configureRewardPointsLog" id="147203c4-c4cd-4fc4-a481-bbffc7afa440">
                <documentation>Comment:

Amend the configuration arrangements/parameters governing the Reward Points Account/Log</documentation>
              </element>
              <element xsi:type="archimate:BusinessInterface" name="recordRewardPointsLog" id="90b79f1d-22b3-4cb8-8b6c-f61ee57d63ea">
                <documentation>Record activity details/transaction information against the Reward Points Account/Log</documentation>

              <documentation>Record activity details/information against the EBranch Channel Management Plan</documentation>
            </element>
            <element xsi:type="archimate:BusinessInterface" name="requestEBranchChannelManagementPlan" id="490a3563-4ddf-4840-a132-4b2ba699b473">
              <documentation>Request a service under the EBranch Channel Management Plan</documentation>

                <documentation>Amend the configuration arrangements/parameters governing the Trade Matching Operating Session</documentation>
              </element>
              <element xsi:type="archimate:BusinessInterface" name="executeTradeMatchingOperatingSession" id="e681b2c7-5dbc-442c-a088-f428f99138cc">
                <documentation>Execute a transaction or task under the Trade Matching Operating Session</documentation>
              </element>
              <element xsi:type="archimate:BusinessInterface" name="recordTradeMatchingOperatingSession" id="961cdee4-ac48-40a2-9ba0-f4112a3574bd">

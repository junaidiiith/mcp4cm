              <documentation>Record activity details/information against the Branch Location Management Plan</documentation>
            </element>
            <element xsi:type="archimate:BusinessInterface" name="requestBranchLocationManagementPlan" id="4984054a-ef05-4cb2-bc9b-2c78b19b9998">
              <documentation>Request a service under the Branch Location Management Plan</documentation>
            </element>

            </element>
            <element xsi:type="archimate:BusinessInterface" name="requestCustomerAgreement" id="784c1a5f-0cb8-4d5c-a726-fbbe6af9ee77">
              <documentation>Request that the agreement is reviewed/refreshed (revised rules)</documentation>
            </element>
            <element xsi:type="archimate:BusinessInterface" name="retrieveCustomerAgreement" id="6337c2b9-d7d3-44fc-8345-8cd9910fec29">
              <documentation> Retrieve customer agreement report</documentation>
            </element>
            <element xsi:type="archimate:BusinessInterface" name="terminateCustomerAgreement" id="c5145395-7b21-488c-a978-061a9ce2a8d7">
              <documentation> Initiate the termination processing of the customer agreement</documentation>
            </element>
            <element xsi:type="archimate:BusinessInterface" name="updateCustomerAgreement" id="2e95af19-af40-4c40-aa66-47a92ea86afd">

              <documentation>Record activity details/information against the Office Equipment Maintenance Agreement</documentation>
            </element>
            <element xsi:type="archimate:BusinessInterface" name="requestOfficeEquipmentMaintenanceAgreement" id="e035f5d4-8c0f-4b79-a501-22dc4bea6e88">
              <documentation>Request a service under the Office Equipment Maintenance Agreement</documentation>
            </element>

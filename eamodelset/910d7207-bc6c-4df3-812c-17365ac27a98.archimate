              <documentation>Assign responsibility for the customer precedents procedure
Name
: </documentation>
            </element>
            <element xsi:type="archimate:BusinessInterface" name="configureCustomerPrecedentsProcedure" id="cc9d74b0-67cc-45cc-b4ba-f4eb0799cd8b">
              <documentation> Amend the configuration arrangements/parameters governing the customer precedents procedure</documentation>
            </element>

                <documentation>Terminate all or some part of the trust services fulfillment arrangement</documentation>
              </element>
              <element xsi:type="archimate:BusinessInterface" name="updateTrustServicesFulfillmentArrangement" id="4bef45ad-4b10-41bf-9509-28d5b4a55e4d">
                <documentation>Update work tasks and activity details for the trust services fulfillment arrangement</documentation>
              </element>
              <element xsi:type="archimate:BusinessInterface" name="retrieveTrustServicesFulfillmentArrangement" id="f1807be0-a69c-4a8a-a6f2-d691ef64c195">
                <documentation> Retrieve trust services fulfillment arrangement related reports
Name
: </documentation>
              </element>

              <documentation>Initiate/set-up the legal aspect of the customer agreement (apply/negotiate terms)</documentation>
            </element>
            <element xsi:type="archimate:BusinessInterface" name="initiateCustomerAgreementRegulatoryTerms" id="815724e4-64e9-456e-8b5d-fb10aa699293">
              <documentation> Initiate/set-up the regulatory aspect of the customer agreement (apply/negotiate terms)</documentation>
            </element>
            <element xsi:type="archimate:BusinessInterface" name="notifyCustomerAgreement" id="a9a20d1b-cf1c-4999-b7ac-cc9bc2826a9f">

              <documentation>Comment:

Obtain authorization for some action under the Internal Audit Assessment</documentation>
            </element>
            <element xsi:type="archimate:BusinessInterface" name="evaluateInternalAuditAssessment" id="218d7dae-e559-4f99-8e62-9eff079d426b">
              <documentation>Check/verify compliance with Internal Audit related checks/assessments</documentation>
            </element>
            <element xsi:type="archimate:BusinessInterface" name="recordInternalAuditAssessment" id="9211cc6d-7f37-44a5-8abf-d271b3a825eb">
              <documentation>Record activity details/information against an ongoing Internal Audit Assessment evaluation</documentation>
            </element>
            <element xsi:type="archimate:BusinessInterface" name="requestInternalAuditAssessment" id="b8da04fc-894b-4bf6-9897-f28738d1d1f1">
